{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vltk.example/content/manifest.v1.schema.json",
  "title": "VLTK immutable content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "realmId",
    "version",
    "createdAt",
    "userFacingLocale",
    "hotReloadAllowed",
    "sourceSnapshot",
    "luaPolicy",
    "signingKeyId",
    "artifacts",
    "manifestSha256",
    "signature"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseId": {"$ref": "#/$defs/uuid"},
    "realmId": {"$ref": "#/$defs/uuid"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "createdAt": {"type": "string", "format": "date-time"},
    "userFacingLocale": {"const": "vi"},
    "hotReloadAllowed": {"const": false},
    "sourceSnapshot": {"$ref": "#/$defs/sourceSnapshot"},
    "luaPolicy": {"$ref": "#/$defs/luaPolicy"},
    "signingKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "contentEncoding": "base64", "minLength": 40},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "sourceRoot", "capturedAt", "treeSha256", "catalogGeneratorRevision"],
      "properties": {
        "snapshotId": {"type": "string", "minLength": 7, "maxLength": 128},
        "sourceRoot": {"type": "string", "minLength": 1, "maxLength": 1024},
        "capturedAt": {"type": "string", "format": "date-time"},
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "vcsRevision": {"type": "string", "minLength": 7, "maxLength": 128},
        "catalogGeneratorRevision": {"type": "string", "minLength": 7, "maxLength": 128}
      }
    },
    "luaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "sandboxPolicyVersion", "hostApiWhitelist", "hostApiWhitelistSha256"],
      "properties": {
        "runtime": {"const": "Lua 5.1"},
        "sandboxPolicyVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "hostApiWhitelist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:]{0,127}$"}
        },
        "hostApiWhitelistSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "kind", "mediaType", "sizeBytes", "sha256", "uri", "provenance"],
      "properties": {
        "logicalPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "kind": {"enum": ["config", "lua", "map", "sprite", "audio", "binary", "localization"]},
        "mediaType": {"type": "string", "minLength": 3, "maxLength": 128},
        "encoding": {"type": "string", "maxLength": 32},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "normalizedSha256": {"$ref": "#/$defs/sha256"},
        "uri": {"type": "string", "format": "uri"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "lua": {"$ref": "#/$defs/lua"},
        "sprite": {"$ref": "#/$defs/sprite"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "lua"}}, "required": ["kind"]},
          "then": {"required": ["lua"]}
        },
        {
          "if": {"properties": {"kind": {"const": "sprite"}}, "required": ["kind"]},
          "then": {"required": ["sprite"]}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshotId", "discoveryTool", "parserName", "parserVersion"],
      "properties": {
        "sourceSnapshotId": {
          "type": "string",
          "minLength": 7,
          "maxLength": 128,
          "description": "MUST equal the containing manifest sourceSnapshot.snapshotId. Enforced by importer/SQL because JSON Schema cannot express cross-instance equality."
        },
        "sourcePath": {"type": "string", "maxLength": 1024},
        "sourcePackage": {"type": "string", "maxLength": 256},
        "sourceUid": {"type": "integer", "minimum": 0},
        "sourceEncoding": {"type": "string", "maxLength": 32},
        "discoveryTool": {"enum": ["semble", "gitnexus", "vltktool", "manual", "runtime", "importer"]},
        "queryUsed": {"type": "string", "maxLength": 2048},
        "evidenceNote": {"type": "string", "maxLength": 4096},
        "parserName": {"type": "string", "minLength": 1, "maxLength": 128},
        "parserVersion": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "anyOf": [
        {"required": ["sourcePath"]},
        {"required": ["sourcePackage", "sourceUid"]}
      ]
    },
    "lua": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleKey",
        "luaVersion",
        "sandboxPolicyVersion",
        "hostApiWhitelistSha256",
        "sourceSha256",
        "deterministic",
        "approvedBy",
        "approvedAt",
        "instructionLimit",
        "timeoutMs",
        "memoryLimitBytes"
      ],
      "properties": {
        "moduleKey": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "maxLength": 256},
        "luaVersion": {"const": "5.1"},
        "sandboxPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "MUST equal the containing manifest luaPolicy.sandboxPolicyVersion."
        },
        "hostApiWhitelistSha256": {
          "$ref": "#/$defs/sha256",
          "description": "MUST equal the containing manifest luaPolicy.hostApiWhitelistSha256."
        },
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "bytecodeSha256": {"$ref": "#/$defs/sha256"},
        "deterministic": {"const": true},
        "approvedBy": {"type": "string", "minLength": 1, "maxLength": 128},
        "approvedAt": {"type": "string", "format": "date-time"},
        "instructionLimit": {"type": "integer", "const": 100000},
        "timeoutMs": {"type": "integer", "const": 5},
        "memoryLimitBytes": {"type": "integer", "const": 8388608}
      }
    },
    "fallbackPolicyAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "frameSource", "textRendering", "debtId"],
      "properties": {
        "policyId": {"const": "SPR-FALLBACK-VI-RUNTIME-TEXT-V1"},
        "frameSource": {"const": "pc-original-sprite"},
        "textRendering": {"const": "vietnamese-runtime-text"},
        "temporaryTransformAllowed": {"const": true},
        "debtId": {"type": "string", "pattern": "^DEBT-[A-Z0-9-]+$"}
      }
    },
    "sprite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLocale",
        "userFacingLocale",
        "vietnameseMode",
        "packageIndex",
        "winnerStatus",
        "pathBytesBase64",
        "rawSha256",
        "decodedSha256",
        "vltktoolRevision",
        "parityStatus"
      ],
      "properties": {
        "sourceLocale": {"enum": ["vi", "zh", "textless"]},
        "userFacingLocale": {"const": "vi"},
        "vietnameseMode": {"enum": ["native", "runtime-text"]},
        "packageIndex": {"type": "integer", "minimum": 0},
        "winnerStatus": {"const": "resolved-first-match"},
        "pathBytesBase64": {"type": "string", "contentEncoding": "base64", "minLength": 4},
        "rawSha256": {"$ref": "#/$defs/sha256"},
        "decodedSha256": {"$ref": "#/$defs/sha256"},
        "vltktoolRevision": {"type": "string", "minLength": 7, "maxLength": 64},
        "parityStatus": {"enum": ["BLOCKED", "GOLDEN_READY", "PARITY_DONE"]},
        "goldenId": {"type": "string", "pattern": "^GOLD-[A-Z0-9-]+$"},
        "debtId": {"type": "string", "pattern": "^DEBT-[A-Z0-9-]+$"},
        "fallbackPolicyAttachment": {"$ref": "#/$defs/fallbackPolicyAttachment"}
      },
      "allOf": [
        {
          "if": {"properties": {"sourceLocale": {"const": "vi"}}, "required": ["sourceLocale"]},
          "then": {"properties": {"vietnameseMode": {"const": "native"}}}
        },
        {
          "if": {"properties": {"sourceLocale": {"enum": ["zh", "textless"]}}, "required": ["sourceLocale"]},
          "then": {
            "required": ["debtId", "fallbackPolicyAttachment"],
            "properties": {"vietnameseMode": {"const": "runtime-text"}}
          }
        }
      ],
      "anyOf": [{"required": ["goldenId"]}, {"required": ["debtId"]}]
    }
  }
}
