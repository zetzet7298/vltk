{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vltk-mobile:spec:skill-parity-p0-matrix:v1",
  "title": "Manifest ma trận parity kỹ năng P0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_schema", "matrix_id", "schema_version", "catalog", "fixture_schema", "fixture_ref", "case_instances", "expansion_rule", "required_variants", "groups", "case_required_fields", "current_blocked_fields", "release_rule"],
  "properties": {
    "case_schema": {"const": "./skill-parity-case-p0.schema.json"},
    "matrix_id": {"const": "MATRIX-SKL-P0-001"},
    "schema_version": {"const": 1},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "records_discovered", "authority"],
      "properties": {
        "path": {"const": "../../registry/catalogs/skills.jsonl"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records_discovered": {"type": "integer", "minimum": 1},
        "authority": {"enum": ["DISCOVERED_UNVERIFIED", "SOURCE_PROVEN", "PARITY_DONE"]}
      }
    },
    "fixture_schema": {"const": "../fixtures/training-npcs.p0.schema.json"},
    "fixture_ref": {"const": "../fixtures/training-npcs.p0.json#FIXTURE-CBT-TRAINING-001"},
    "case_instances": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$"}},
    "expansion_rule": {"type": "string", "minLength": 1},
    "required_variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "groups": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "stable_prefix", "selection_status", "catalog_selection", "blocker"],
        "properties": {
          "group": {"enum": ["shared", "novice", "shaolin", "tianwang", "tangmen", "wudu", "emei", "cuiyan", "gaibang", "tianren", "wudang", "kunlun"]},
          "stable_prefix": {"type": "string", "pattern": "^SKL-[A-Z]+$"},
          "selection_status": {"enum": ["BLOCKED", "SOURCE_PROVEN", "PARITY_DONE"]},
            "catalog_selection": {"type": ["array", "null"], "uniqueItems": true, "items": {"type": "string", "pattern": "^SKILL-[0-9]+$"}},
          "blocker": {"type": ["string", "null"]}
        },
        "allOf": [
            {"if": {"properties": {"selection_status": {"const": "BLOCKED"}}}, "then": {"properties": {"blocker": {"type": "string", "minLength": 1}, "catalog_selection": {"type": "null"}}}},
            {"if": {"properties": {"selection_status": {"enum": ["SOURCE_PROVEN", "PARITY_DONE"]}}}, "then": {"properties": {"blocker": {"type": "null"}, "catalog_selection": {"type": "array", "minItems": 1, "uniqueItems": true}}}}
        ]
      }
    },
    "case_required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "current_blocked_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "release_rule": {"type": "string", "minLength": 1}
  }
}
