# ─────────────────────────────────────────────────
*.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
keystore.properties
google-services.json
GoogleService-Info.plist

# ─────────────────────────────────────────────────
# Antigravity agent workspace
# ─────────────────────────────────────────────────
.antigravitycli/

# ─────────────────────────────────────────────────
# What IS tracked
# ─────────────────────────────────────────────────
# Assets/**/*.cs            → C# scripts
# Assets/**/*.meta          → Unity asset metadata (REQUIRED!)
# Assets/**/*.unity         → Scenes
# Assets/**/*.prefab        → Prefabs
# Assets/**/*.mat           → Materials
# Assets/**/*.anim          → Animations
# Assets/**/*.controller    → Animator controllers
# ProjectSettings/          → Unity project settings
# Packages/                 → Package manifest
# docs/                     → Documentation
# scripts/                  → Harness & tool scripts

# ─────────────────────────────────────────────────
# Agent tooling skill dirs (not VLTK project source)
# ─────────────────────────────────────────────────
.codex/
.factory/
.agents/
.understand-anything/
.kiro/
.pi/

# ─────────────────────────────────────────────────
# Unity auto-recovery scene backup
# ─────────────────────────────────────────────────
Assets/_Recovery/
Assets/_Recovery.meta
Assets/Screenshots/*.png
Assets/Screenshots/*.png.meta

# ─────────────────────────────────────────────────
# Agent git worktrees
# ─────────────────────────────────────────────────
.worktrees/
harness-be/
backend/

