{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vltk.example/spec/golden-manifest.schema.json",
  "title": "Manifest golden lưu trên MinIO",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "storage", "goldens"],
  "properties": {
    "schema_version": {"const": 1},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "bucket", "key_policy", "endpoint_env", "access_key_env", "secret_key_env", "region", "credentials_in_repo"],
      "properties": {
        "backend": {"const": "minio"},
        "bucket": {"type": "string", "minLength": 3},
        "key_policy": {"const": "sha256-content-addressed"},
        "endpoint_env": {"type": "string", "minLength": 1},
        "access_key_env": {"type": "string", "minLength": 1},
        "secret_key_env": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "credentials_in_repo": {"const": false}
      }
    },
    "goldens": {
      "type": "array",
      "items": {"$ref": "#/$defs/golden"}
    }
  },
  "$defs": {
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dri", "reviewer", "phase", "status", "acceptance_evidence", "subject", "required_for", "artifact"],
      "properties": {
        "id": {"type": "string", "pattern": "^GOLD-[A-Z0-9-]+$"},
        "dri": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "status": {"enum": ["BLOCKED", "REQUIRED", "READY", "APPROVED", "COMPLETED"]},
        "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subject": {"type": "string", "minLength": 1},
        "required_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(PAR|TEST|FR|NFR)-[A-Z0-9-]+$"}},
        "blocker": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["BLOCKED", "REQUIRED"]}}}, "then": {"required": ["blocker"]}},
        {"if": {"properties": {"status": {"enum": ["READY", "APPROVED", "COMPLETED"]}}}, "then": {"properties": {"artifact": {"$ref": "#/$defs/readyArtifact"}}}}
      ]
    },
    "artifact": {
      "type": "object"
    },
    "readyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "sha256", "size_bytes", "captured_at", "source_revision", "tool_revision", "content_type"],
      "properties": {
        "object_key": {"type": "string", "minLength": 65},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "source_revision": {"type": "string", "minLength": 7},
        "tool_revision": {"type": "string", "minLength": 7},
        "content_type": {"type": "string", "minLength": 3}
      }
    }
  }
}
