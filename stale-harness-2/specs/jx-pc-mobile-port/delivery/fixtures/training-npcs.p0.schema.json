{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vltk-mobile:spec:training-npcs-p0-fixture-schema:v1",
  "title": "Fixture 5 NPC huấn luyện P0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "fixture_id", "schema_version", "language", "purpose", "lifecycle", "verification", "authority_limit", "sources", "spawn_policy", "shared_state", "resistance_profile", "npcs", "required_capture"],
  "properties": {
    "schema_id": {"const": "urn:vltk-mobile:spec:training-npcs-p0-fixture:v1"},
    "fixture_id": {"const": "FIXTURE-CBT-TRAINING-001"},
    "schema_version": {"const": 1},
    "language": {"const": "vi-VN"},
    "purpose": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["DISCOVERED", "SOURCE_PROVEN", "BLOCKED"]},
    "verification": {"enum": ["UNVERIFIED_RUNTIME", "RUNTIME_VERIFIED"]},
    "authority_limit": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "line_ranges", "claim"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "line_ranges": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"}},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "spawn_policy": {
      "type": "object", "additionalProperties": true,
      "required": ["production_enabled", "devharness_only", "fixture_mode", "canonical_map_id", "fixed_center", "radius_world_units", "angle_formula_degrees", "position_formula"],
      "properties": {
        "production_enabled": {"const": false},
        "devharness_only": {"const": true},
        "fixture_mode": {"const": "MAP_53_FIXED_CENTER"},
        "canonical_map_id": {"const": 53},
        "fixed_center": {"type": "object", "required": ["x", "y"]},
        "radius_world_units": {"const": 300.0},
        "angle_formula_degrees": {"const": "90 + index * 72"},
        "position_formula": {"type": "string", "minLength": 1}
      }
    },
    "shared_state": {"type": "object", "required": ["spawn_life", "max_life", "level", "movement"]},
    "resistance_profile": {"type": "object", "required": ["status", "blocker"], "properties": {"status": {"enum": ["BLOCKED", "SOURCE_PROVEN"]}, "blocker": {"type": "string", "minLength": 1}}},
    "npcs": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/npc415_0"}, {"$ref": "#/$defs/npc415_1"},
        {"$ref": "#/$defs/npc413_2"}, {"$ref": "#/$defs/npc413_3"},
        {"$ref": "#/$defs/npc414_4"}
      ],
      "items": false
    },
    "required_capture": {"type": "object", "required": ["status", "fields", "exit_evidence"], "properties": {"status": {"enum": ["BLOCKED", "READY"]}, "fields": {"type": "array", "minItems": 1}, "exit_evidence": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "npc": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "instance_id", "template_id", "name_vi", "angle_degrees", "position", "sprite_clip_ref_fallback", "stand_spr"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 4},
        "instance_id": {"type": "integer", "minimum": 1000, "maximum": 1004},
        "template_id": {"enum": [413, 414, 415]},
        "name_vi": {"type": "string", "minLength": 1},
        "angle_degrees": {"type": "number"},
        "position": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
        "sprite_clip_ref_fallback": {"type": "string", "minLength": 1},
        "stand_spr": {"type": "string", "pattern": "\\.spr$"}
      }
    },
    "npc415_0": {"allOf": [{"$ref": "#/$defs/npc"}, {"properties": {"index": {"const": 0}, "instance_id": {"const": 1000}, "template_id": {"const": 415}}}]},
    "npc415_1": {"allOf": [{"$ref": "#/$defs/npc"}, {"properties": {"index": {"const": 1}, "instance_id": {"const": 1001}, "template_id": {"const": 415}}}]},
    "npc413_2": {"allOf": [{"$ref": "#/$defs/npc"}, {"properties": {"index": {"const": 2}, "instance_id": {"const": 1002}, "template_id": {"const": 413}}}]},
    "npc413_3": {"allOf": [{"$ref": "#/$defs/npc"}, {"properties": {"index": {"const": 3}, "instance_id": {"const": 1003}, "template_id": {"const": 413}}}]},
    "npc414_4": {"allOf": [{"$ref": "#/$defs/npc"}, {"properties": {"index": {"const": 4}, "instance_id": {"const": 1004}, "template_id": {"const": 414}}}]}
  }
}
