{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vltk.example/content/manifest.v1.schema.json",
  "title": "VLTK immutable content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "realmId", "version", "createdAt", "signingKeyId", "artifacts", "manifestSha256", "signature"],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseId": {"$ref": "#/$defs/uuid"},
    "realmId": {"$ref": "#/$defs/uuid"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "createdAt": {"type": "string", "format": "date-time"},
    "minimumClientVersion": {"type": "string", "minLength": 1},
    "signingKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "contentEncoding": "base64", "minLength": 40},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalPath", "kind", "mediaType", "sizeBytes", "sha256", "uri", "provenance"],
      "properties": {
        "logicalPath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "kind": {"enum": ["config", "lua", "map", "sprite", "audio", "binary", "localization"]},
        "mediaType": {"type": "string", "minLength": 3, "maxLength": 128},
        "encoding": {"type": "string", "maxLength": 32},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "normalizedSha256": {"$ref": "#/$defs/sha256"},
        "uri": {"type": "string", "format": "uri"},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 512}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "lua": {"$ref": "#/$defs/lua"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "lua"}}, "required": ["kind"]},
          "then": {"required": ["lua"]},
          "else": {"not": {"required": ["lua"]}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discoveryTool", "parserName", "parserVersion"],
      "properties": {
        "sourcePath": {"type": "string", "maxLength": 1024},
        "sourcePackage": {"type": "string", "maxLength": 256},
        "sourceUid": {"type": "integer", "minimum": 0},
        "sourceEncoding": {"type": "string", "maxLength": 32},
        "discoveryTool": {"enum": ["semble", "gitnexus", "vltktool", "manual", "runtime", "importer"]},
        "queryUsed": {"type": "string", "maxLength": 2048},
        "evidenceNote": {"type": "string", "maxLength": 4096},
        "parserName": {"type": "string", "minLength": 1, "maxLength": 128},
        "parserVersion": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "anyOf": [
        {"required": ["sourcePath"]},
        {"required": ["sourcePackage", "sourceUid"]}
      ]
    },
    "lua": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleKey", "luaVersion", "sandboxPolicyVersion", "sourceSha256", "deterministic", "approvedBy", "approvedAt"],
      "properties": {
        "moduleKey": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "maxLength": 256},
        "luaVersion": {"type": "string", "minLength": 1, "maxLength": 32},
        "sandboxPolicyVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "bytecodeSha256": {"$ref": "#/$defs/sha256"},
        "deterministic": {"type": "boolean"},
        "approvedBy": {"type": "string", "minLength": 1, "maxLength": 128},
        "approvedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
