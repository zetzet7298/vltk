/* =============================================================================
   VLTK Mobile — HUD-003 Popup Window shell (PopupWindow.uss)
   Frame = 玲珑盒内框.spr (blank ornate border, decoded popup_frame_inner.png)
   Close = 关闭_vn.spr ("Đóng" Vietnamese, 3 states).
   Design space: 1280x720 (UI Toolkit PanelSettings).
   ========================================================================== */

/* Dim backdrop behind the active window. Full-screen, below the window. */
.popup-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

/* The window shell, centered, on top of the backdrop.
   Fixed size keeps content above the bottom hotbar and prevents the frame from
   collapsing around scrollable bodies (inventory grid, character paperdoll). */
.popup-window {
    position: absolute;
    left: 50%;
    top: 46%;
    -unity-translate: -50% -50%;
    width: 430px;
    height: 560px;
    -unity-background-scale-mode: scale-to-fill;
}

/* Ornate frame panel (玲珑盒内框 border). Fills the window. */
.popup-chrome {
    flex-grow: 1;
    padding-top: 44px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    background-color: rgba(24, 20, 14, 0.94);
    background-image: url('project://database/Assets/UI/Popup/Art/popup_frame_inner.png');
    -unity-background-scale-mode: scale-to-fill;
}

/* UiSkillsLive.ini: the fight sub-page is 191px wide at Left=7 inside the
   205px skill sheet. SkillContent supplies its own 6px inset, so the shell
   leaves one pixel on each side instead of the generic 16px popup gutter. */
.popup-window--pc-skill .popup-chrome {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    padding-top: 0px;
    padding-left: 1px;
    padding-right: 1px;
    padding-bottom: 0px;
}

/* Vietnamese PC UiSkillsSheet main frame: exact selected bytes from the
   Vietnamese package slice, not the Chinese fallback sprite. */
.popup-window--pc-skill {
    background-color: rgba(0, 0, 0, 0);
    background-image: url('project://database/Assets/UI/HUD/Art/vi/skill_panel_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

/* PC character panel owns its complete frame/title/footer in its SPR. The shell
   must not add generic gutters, frame art, clipping, or header height. */
.popup-window--pc-character {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.popup-window--pc-character .popup-chrome {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    padding-top: 0px;
    padding-left: 0px;
    padding-right: 0px;
    padding-bottom: 0px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.popup-window--pc-character .popup-body {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 428px;
    height: 430px;
    flex-grow: 0;
    overflow: visible;
}

/* Title bar + close row, sitting on the top of the frame. */
.popup-header {
    position: absolute;
    left: 92px;
    top: 6px;
    width: 246px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.popup-title {
    -unity-font-style: bold;
    color: rgb(235, 246, 255);
    font-size: 16px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    margin-right: 8px;
    -unity-text-align: middle-center;
}

/* Close button: Vietnamese "Đóng" SPR (关闭_vn.spr). 3 states. */
.popup-close {
    width: 96px;
    height: 24px;
    border-width: 0;
    padding: 0;
    margin: 0;
    color: rgba(0, 0, 0, 0);     /* text hidden; the SPR art carries "Đóng" */
    background-image: url('project://database/Assets/UI/Popup/Art/btn_close_vn.png');
    -unity-background-scale-mode: scale-to-fit;
}
.popup-close:hover {
    background-image: url('project://database/Assets/UI/Popup/Art/btn_close_vn_h.png');
}
.popup-close:active {
    background-image: url('project://database/Assets/UI/Popup/Art/btn_close_vn_p.png');
}

/* UiSkillsSheet.ini CloseBtn: Left=53, Top=342, Width=97, Height=29.
   The generic title is intentionally removed: the PC sprite already contains
   the authoritative titlebar and its selected combat tab is overlaid below. */
.popup-window--pc-skill .popup-header {
    left: 53px;
    top: 342px;
    width: 97px;
    height: 29px;
}

.popup-window--pc-skill .popup-title {
    display: none;
}

.popup-window--pc-skill .popup-close {
    width: 97px;
    height: 29px;
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_skill_00_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.popup-window--pc-skill .popup-close:hover {
    /* UiSkillsSheet.ini: Over=2. */
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_skill_02_vi.png');
}

.popup-window--pc-skill .popup-close:active {
    /* UiSkillsSheet.ini: Down=1. */
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_skill_01_vi.png');
}

/* Vietnamese PC UiSkillsSheet FightBtn: Left=7, Top=42, Width=95, Height=14. */
.popup-skill-combat-tab {
    position: absolute;
    left: 7px;
    top: 42px;
    width: 95px;
    height: 14px;
    background-image: url('project://database/Assets/UI/HUD/Art/vi/skill_fight_tab_01_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

/* Content body slot (where IPopupContent mounts). */
.popup-body {
    flex-grow: 1;
    overflow: hidden;
}

/* Vietnamese PC UiSkillsLive lane: the source slice supplies the 5x5 slot
   backing and the Điểm label; SkillContent only layers real icons/levels. */
.popup-window--pc-skill .popup-body {
    position: absolute;
    left: 7px;
    top: 57px;
    width: 191px;
    height: 278px;
    flex-grow: 0;
    /* A selected skill opens the deliberately mobile-only assignment tray below
       the fixed PC sheet.  Baseline PC content stays inside this lane. */
    overflow: visible;
    background-image: url('project://database/Assets/UI/HUD/Art/vi/skill_panel_combat_tab_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}
