/* =============================================================================
   VLTK Mobile — HUD-003 Skill Panel popup content (Skill.uss)
   PC refs: UiSkillsSheet.ini 205x376, UiSkillsFightSub.ini 5x5 grid 36px slots.
   Geometry ported from the inline .hud-cb-* classes (now skill-scoped .skill-*),
   adapted to the popup body's stacked flex layout (summary -> grid -> detail).
   The body is the single owner of skill-panel visuals (D5).
   ========================================================================== */

.skill-body {
    flex-grow: 1;
    flex-direction: column;
    padding: 6px;
}

.skill-summary {
    color: rgb(255, 238, 145);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.skill-grid-scroll {
    flex-grow: 1;
}

/* 5-column flex-wrap grid (5 x 38 = 190px fits the 205-wide body). PC parity:
   UiSkillsFightSub.ini 5x5 grid of 36px slots. */
.skill-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.skill-grid-cell {
    position: relative;
    width: 38px;
    height: 51px;
    align-items: flex-start;
    justify-content: flex-start;
}

.skill-grid-cell--selected {
    background-color: rgba(255, 220, 90, 0.18);
}

.skill-grid-slot {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.skill-grid-slot--empty {
    background-color: rgba(0, 0, 0, 0.25);
}

.skill-grid-level {
    position: absolute;
    left: 0px;
    top: 36px;
    width: 36px;
    height: 12px;
    color: rgb(218, 255, 165);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* "+" add-point affordance. PC art reused verbatim (状态加点按钮改_01.png). */
.skill-add-point {
    position: absolute;
    left: 22px;
    top: 35px;
    width: 14px;
    height: 14px;
    background-image: url('project://database/Assets/UI/HUD/Art/状态加点按钮改_01.png');
    -unity-background-scale-mode: stretch-to-fill;
}

/* Per-cell name is kept as data (the test seam reads .text), but visually hidden
   on the grid like the PC panel: the full name shows only in the selected-skill
   detail region (.skill-detail-title) on tap (interactive parity). */
.skill-grid-name {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1px;
    height: 1px;
    color: rgba(0, 0, 0, 0);
    font-size: 1px;
    overflow: hidden;
}

/* Detail region — formerly the external IMGUI tooltip, now stacked inside the
   body. Derived entirely from the selected PcSkillPanelRow. */
.skill-detail {
    margin-top: 6px;
    padding: 5px;
    background-color: rgba(18, 14, 10, 0.88);
    border-width: 1px;
    border-color: rgba(150, 112, 48, 0.55);
    flex-shrink: 0;
}

.skill-detail-title {
    color: rgb(255, 230, 130);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
    white-space: normal;
}

.skill-detail-level {
    color: rgb(218, 255, 165);
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
    white-space: normal;
}

.skill-detail-summary {
    color: rgb(232, 220, 184);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 3px;
}

.skill-detail-next {
    color: rgb(190, 220, 255);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 3px;
}

.skill-detail-status {
    color: rgb(255, 220, 130);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}
