/* =============================================================================
   VLTK Mobile — HUD-003 Treasure / Bảo Vật content (Treasure.uss)
   Read-only slice based on PC Kỳ Trân Các / Giỏ Hàng / Rương Báu manifests.
   ========================================================================== */

.treasure-body {
    flex-grow: 1;
    padding: 8px;
}

.treasure-tabs {
    flex-direction: row;
    height: 34px;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.treasure-tab {
    flex-grow: 1;
    height: 28px;
    margin: 0 3px;
    padding: 3px 4px;
    color: rgb(230, 245, 255);
    background-color: rgba(36, 26, 16, 0.95);
    border-width: 1px;
    border-color: rgba(210, 165, 70, 0.8);
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.treasure-tab.active {
    color: rgb(255, 238, 145);
    background-color: rgba(120, 80, 30, 0.9);
    border-color: rgb(220, 180, 80);
    -unity-font-style: bold;
}

.treasure-panel {
    margin-bottom: 8px;
    padding: 7px;
    background-color: rgba(18, 14, 10, 0.88);
    border-width: 1px;
    border-color: rgba(150, 112, 48, 0.55);
}

.treasure-section-title {
    color: rgb(255, 230, 130);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.treasure-summary-list {
    flex-direction: column;
}

.treasure-summary-row {
    color: rgb(232, 220, 184);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 3px;
}

.treasure-control-scroll {
    height: 244px;
}

.treasure-control-list {
    flex-direction: column;
}

.treasure-control-row {
    margin-bottom: 5px;
    padding: 5px;
    background-color: rgba(46, 34, 18, 0.78);
    border-width: 1px;
    border-color: rgba(130, 95, 42, 0.65);
}

.treasure-control-label {
    color: rgb(255, 240, 165);
    font-size: 12px;
    -unity-font-style: bold;
}

.treasure-control-action {
    color: rgb(226, 218, 190);
    font-size: 11px;
    white-space: normal;
}

.treasure-control-source {
    color: rgb(150, 195, 235);
    font-size: 10px;
}

.treasure-footer {
    color: rgb(190, 170, 125);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}
