/* =============================================================================
   VLTK Mobile — HUD-003 Faction Bonus / Môn Phái content (Faction.uss)
   Read-only slice based on PC faction_bonus.txt (Reference/PcFaction).
   ========================================================================== */

.faction-body {
    flex-grow: 1;
    padding: 8px;
}

.faction-header {
    color: rgb(255, 238, 145);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.faction-totals {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.faction-total {
    flex-grow: 1;
    margin: 2px 4px;
    padding: 5px;
    background-color: rgba(46, 34, 18, 0.85);
    border-width: 1px;
    border-color: rgba(210, 165, 70, 0.7);
    -unity-text-align: middle-center;
}

.faction-total-label {
    color: rgb(210, 200, 165);
    font-size: 10px;
}

.faction-total-value {
    color: rgb(255, 240, 165);
    font-size: 15px;
    -unity-font-style: bold;
}

.faction-panel {
    margin-bottom: 8px;
    padding: 7px;
    background-color: rgba(18, 14, 10, 0.88);
    border-width: 1px;
    border-color: rgba(150, 112, 48, 0.55);
}

.faction-section-title {
    color: rgb(255, 230, 130);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.faction-row-scroll {
    height: 220px;
}

.faction-row-list {
    flex-direction: column;
}

.faction-row {
    flex-direction: row;
    margin-bottom: 3px;
    padding: 3px;
    background-color: rgba(30, 24, 16, 0.6);
}

.faction-row.active {
    background-color: rgba(90, 70, 30, 0.85);
}

.faction-row-head {
    background-color: rgba(60, 44, 22, 0.95);
    border-bottom-width: 1px;
    border-color: rgba(210, 165, 70, 0.8);
}

.faction-cell,
.faction-cell-level {
    flex-grow: 1;
    color: rgb(232, 220, 184);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.faction-cell-level {
    color: rgb(255, 230, 130);
    -unity-font-style: bold;
}

.faction-empty {
    color: rgb(190, 170, 125);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.faction-footer {
    color: rgb(190, 170, 125);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}
