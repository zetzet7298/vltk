.team-btn-refresh:disabled { background-image: url("Art/btn_refresh_disabled.png"); }

/* [Leave]/[Dismiss] Left=140 Top=138 Width=60 Height=16 */
.team-btn-leave {
    left: 140px;
    top: 138px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_leave_up.png");
}
.team-btn-leave:hover { background-image: url("Art/btn_leave_over.png"); }
.team-btn-leave:active { background-image: url("Art/btn_leave_down.png"); }
.team-btn-leave:disabled { background-image: url("Art/btn_leave_disabled.png"); }

.team-btn-dismiss {
    left: 140px;
    top: 138px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_dismiss_up.png");
}
.team-btn-dismiss:hover { background-image: url("Art/btn_dismiss_over.png"); }
.team-btn-dismiss:active { background-image: url("Art/btn_dismiss_down.png"); }
.team-btn-dismiss:disabled { background-image: url("Art/btn_dismiss_disabled.png"); }

/* [CloseTeam] Left=4 Top=207 Width=173 Height=18 */
.team-close-team-btn {
    left: 4px;
    top: 207px;
    width: 173px;
    height: 18px;
    background-image: url("Art/btn_close_team_up.png");
}
.team-close-team-btn:active { background-image: url("Art/btn_close_team_down.png"); }
.team-close-team-btn:disabled { background-image: url("Art/btn_close_team_disabled.png"); }

/* [Cancel] Left=177 Top=207 Width=159 Height=18 */
.team-cancel-btn {
    left: 177px;
    top: 207px;
    width: 159px;
    height: 18px;
    background-image: url("Art/btn_cancel_up.png");
}
.team-cancel-btn:hover { background-image: url("Art/btn_cancel_over.png"); }
.team-cancel-btn:active { background-image: url("Art/btn_cancel_down.png"); }
