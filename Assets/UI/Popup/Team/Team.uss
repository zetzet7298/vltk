/* =============================================================================
   VLTK Mobile — PC Đội popup (a05d7a2c.dat)
   Panel/buttons are exact SPR exports. Unity overlays only roster/nearby text.
   ========================================================================== */

.team-body {
    width: 340px;
    height: 229px;
    padding: 0;
    margin: 0;
}

.team-panel-pc {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 340px;
    height: 229px;
    background-image: url("Art/panel.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* [MemberList] Left=5 Top=54 Width=125 Height=112 Font=13 */
.team-member-list {
    position: absolute;
    left: 5px;
    top: 54px;
    width: 125px;
    height: 112px;
    overflow: hidden;
    flex-direction: column;
    padding: 1px 2px;
}

/* [NearbyList] Left=210 Top=54 Width=110 Height=112 Font=13 */
.team-nearby-list {
    position: absolute;
    left: 210px;
    top: 54px;
    width: 110px;
    height: 112px;
    overflow: hidden;
    flex-direction: column;
    padding: 1px 2px;
}

.team-list-row {
    height: 14px;
    color: rgb(218, 255, 165);
    font-size: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(23, 68, 0);
    overflow: hidden;
    white-space: nowrap;
}

/* [NearbyScroll] Left=323 Top=54 / [NearbyScroll_Btn] 13x27 */
.team-nearby-scroll-thumb {
    position: absolute;
    left: 323px;
    top: 67px;
    width: 13px;
    height: 27px;
    background-image: url("Art/scroll_thumb.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* [LeaderAbility] Left=55 Top=179 Width=75 Height=13 */
.team-leader-ability {
    position: absolute;
    left: 55px;
    top: 179px;
    width: 75px;
    height: 13px;
    color: rgb(218, 255, 165);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(23, 68, 0);
}

/* [InputEdit] Left=210 Top=179 Width=126 Height=13 */
.team-input-edit {
    position: absolute;
    left: 210px;
    top: 179px;
    width: 126px;
    height: 13px;
    color: rgb(255, 253, 122);
    font-size: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.team-command-btn,
.team-close-team-btn,
.team-cancel-btn {
    position: absolute;
    padding: 0;
    margin: 0;
    border-width: 0;
    color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.team-command-btn:disabled,
.team-close-team-btn:disabled {
    opacity: 1;
}

/* [Invite] Left=140 Top=58 Width=60 Height=16 Up=0 Down=1 Disable=2 Over=3 */
.team-btn-invite {
    left: 140px;
    top: 58px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_invite_up.png");
}
.team-btn-invite:hover { background-image: url("Art/btn_invite_over.png"); }
.team-btn-invite:active { background-image: url("Art/btn_invite_down.png"); }
.team-btn-invite:disabled { background-image: url("Art/btn_invite_disabled.png"); }

/* [Kick] Left=140 Top=78 Width=60 Height=16 */
.team-btn-kick {
    left: 140px;
    top: 78px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_kick_up.png");
}
.team-btn-kick:hover { background-image: url("Art/btn_kick_over.png"); }
.team-btn-kick:active { background-image: url("Art/btn_kick_down.png"); }
.team-btn-kick:disabled { background-image: url("Art/btn_kick_disabled.png"); }

/* [Appoint] Left=140 Top=98 Width=60 Height=16 */
.team-btn-appoint {
    left: 140px;
    top: 98px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_appoint_up.png");
}
.team-btn-appoint:hover { background-image: url("Art/btn_appoint_over.png"); }
.team-btn-appoint:active { background-image: url("Art/btn_appoint_down.png"); }
.team-btn-appoint:disabled { background-image: url("Art/btn_appoint_disabled.png"); }

/* [Refresh] Left=140 Top=118 Width=60 Height=16 */
.team-btn-refresh {
    left: 140px;
    top: 118px;
    width: 60px;
    height: 16px;
    background-image: url("Art/btn_refresh_up.png");
}
.team-btn-refresh:hover { background-image: url("Art/btn_refresh_over.png"); }
