<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- GameHud.uss is loaded at runtime by GameHudController.EnsureStyleSheetLoaded()
         (from Resources/GameHud.uss). The <ui:Style> reference below resolves in
         the UI Builder editor only and is intentionally absent here to avoid a
         missing-asset warning when the stylesheet lives under Resources/. -->
    <ui:VisualElement name="GameHud" class="hud-root">

        <!-- ═══ TOP STATUS BAR & AVATAR — vltkunity TopBar.prefab + Avatar.prefab (unified top-left) ═══ -->
        <!-- TopBarPanel is placed at safeX/safeY, size 420x96.
             Contains Avatar, Status Bars (HP/MP/SP/EXP), Level Badge, and Action/Camera buttons. -->
        <ui:VisualElement name="TopBarPanel" class="hud-top-bar-panel" style="position: absolute; left: 10px; top: 10px; width: 420px; height: 96px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/top_bar.png'); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(0, 0, 0, 0); border-width: 0px;">
            <!-- Avatar block (btn_greencircular frame + welfare_bg + portrait) -->
            <ui:VisualElement name="AvatarFrame" style="position: absolute; left: 10px; top: 10px; width: 65px; height: 65px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Bag/btn_greencircular.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px; background-color: rgba(0, 0, 0, 0);">
                <ui:VisualElement name="AvatarPortraitBg" style="position: absolute; left: 5px; top: 5px; width: 55px; height: 55px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Bag/btn_welfare_bg.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;">
                    <ui:VisualElement name="AvatarPortrait" style="position: absolute; left: 0px; top: 0px; width: 55px; height: 55px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Bag/008.png'); -unity-background-scale-mode: scale-to-fit; border-width: 0px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            
            <!-- Level badge (img_levelbg) aligned at bottom-right of Avatar frame -->
            <ui:VisualElement name="AvatarLevelBg" style="position: absolute; left: 50px; top: 50px; width: 25px; height: 25px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/img_levelbg.png'); -unity-background-scale-mode: scale-to-fit;">
                <ui:Label name="AvatarLevelText" text="1" style="width: 25px; height: 25px; font-size: 11px; color: rgb(246, 255, 105); -unity-text-align: middle-center; -unity-font-style: bold; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0px;"/>
            </ui:VisualElement>

            <!-- Status Bars Panel (HP / MP / SP / EXP) -->
            <ui:VisualElement name="StatusBarsContainer" style="position: absolute; left: 86px; top: 12px; width: 170px; height: 72px; flex-direction: column; justify-content: flex-start; background-color: rgba(0,0,0,0);">
                <!-- HP Bar -->
                <ui:VisualElement name="HpBarContainer" style="height: 18px; margin-bottom: 3px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0);">
                    <ui:VisualElement name="HpBarTrack" style="width: 170px; height: 18px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progressbg.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;">
                        <ui:VisualElement name="HpBarFill" style="width: 100%; height: 18px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progress_orange.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;"/>
                    </ui:VisualElement>
                    <ui:Label name="HpText" text="100/100" style="position: absolute; width: 170px; height: 18px; font-size: 11px; color: rgb(246, 255, 105); -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(0,0,0,0); border-width: 0px; margin: 0; padding: 0;"/>
                </ui:VisualElement>

                <!-- MP Bar -->
                <ui:VisualElement name="MpBarContainer" style="height: 16px; margin-bottom: 3px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0);">
                    <ui:VisualElement name="MpBarTrack" style="width: 170px; height: 16px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progressbg.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;">
                        <ui:VisualElement name="MpBarFill" style="width: 100%; height: 16px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progress_blue.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;"/>
                    </ui:VisualElement>
                    <ui:Label name="MpText" text="50/50" style="position: absolute; width: 170px; height: 16px; font-size: 10px; color: rgb(246, 255, 105); -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(0,0,0,0); border-width: 0px; margin: 0; padding: 0;"/>
                </ui:VisualElement>

                <!-- SP Bar (Stamina) -->
                <ui:VisualElement name="StaminaBarContainer" style="height: 16px; margin-bottom: 3px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0);">
                    <ui:VisualElement name="StaminaBarTrack" style="width: 170px; height: 16px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progressbg.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;">
                        <ui:VisualElement name="StaminaBarFill" style="width: 100%; height: 16px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progress_green.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;"/>
                    </ui:VisualElement>
                    <ui:Label name="StaminaText" text="100/100" style="position: absolute; width: 170px; height: 16px; font-size: 10px; color: rgb(246, 255, 105); -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(0,0,0,0); border-width: 0px; margin: 0; padding: 0;"/>
                </ui:VisualElement>

                <!-- EXP Bar (Mobile addition) -->
                <ui:VisualElement name="ExpBarContainer" style="height: 6px; justify-content: center; align-items: center; background-color: rgba(0,0,0,0);">
                    <ui:VisualElement name="ExpBarTrack" style="width: 170px; height: 6px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progressbg.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;">
                        <ui:VisualElement name="ExpBarFill" style="width: 0%; height: 6px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Progress/img_carve_progress_green.png'); -unity-background-scale-mode: stretch-to-fill; border-width: 0px;"/>
                    </ui:VisualElement>
                    <ui:Label name="ExpText" text="0%" style="display: none;"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Action buttons from TopBar.prefab (Luyện Công + Chụp Ảnh) -->
            <ui:VisualElement name="BtnOpenProfile" style="position: absolute; left: 266px; top: 18px; width: 75px; height: 28px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_common1_hud.png'); -unity-background-scale-mode: stretch-to-fill; justify-content: center; align-items: center;">
                <ui:Label text="L.Công" style="font-size: 11px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center; margin: 0; padding: 0; background-color: rgba(0,0,0,0);"/>
            </ui:VisualElement>
            <ui:VisualElement name="BtnScreenShot" style="position: absolute; left: 350px; top: 18px; width: 28px; height: 28px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_photo.png'); -unity-background-scale-mode: scale-to-fit;"/>

            <!-- Hidden/Compat elements positioned far off-screen to prevent layout disruption when C# overrides display style -->
            <ui:Label name="LevelText" text="1" style="position: absolute; left: -1000px; top: -1000px; width: 1px; height: 1px; visibility: hidden;"/>
            <ui:Label name="RankText" text="Hạng ?" style="position: absolute; left: -1000px; top: -1000px; width: 1px; height: 1px; visibility: hidden;"/>
            <ui:Label name="PcConnectionStatusText" text="Hoạt động tốt" style="position: absolute; left: -1000px; top: -1000px; width: 1px; height: 1px; visibility: hidden;"/>
        </ui:VisualElement>

        <!-- ═══ MINIMAP — PC 小地图_小.ini (MiniMap Left=670,Top=0,W=130,H=130), 1.6x scale (208x156) ═══ -->
        <!-- MapRect: PC 1,1,128,128 → 1.6,1.2,204.8,153.6 (≈205x154)
             SceneName/ScenePos: PC 0,1,112,14 / 2,15,112,14 (green)
             SwitchBtn: PC 101,115,14,14 → 162,138,22,17
             WorldMapBtn: PC 115,115,14,14 → 184,138,22,17 -->
        <!-- ═══ TOP-RIGHT MINIMAP (PC top-right 256x128 scaled 1.5x → 208x156 @ left=1072px) ═══ -->
        <!-- display: flex re-asserted 2026-06-22: USS class .hud-minimap-panel or runtime may
             have flipped it to none; force visible so the player can re-open the map preview. -->
        <ui:VisualElement name="MinimapPanel" class="hud-minimap-panel" style="position: absolute; left: 1072px; top: 0px; width: 208px; height: 156px; align-items: center; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:VisualElement name="MinimapFrame" style="width: 208px; height: 154px; border-width: 2px; border-color: rgb(60, 80, 60); background-color: rgba(2, 8, 4, 0.92); overflow: hidden;">
                <ui:VisualElement name="MinimapContent" style="position: absolute; left: 2px; top: 1px; width: 205px; height: 154px; background-color: rgba(15, 25, 15, 0.90); background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/MiniMap/balingxian.png'); -unity-background-scale-mode: stretch-to-fill;">
                    <ui:VisualElement name="MiniMapTarget" style="position: absolute; left: -1000px; top: -1000px; width: 12px; height: 12px; border-radius: 6px; background-color: rgb(255, 230, 40); border-width: 0px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerDot" style="position: absolute; left: 98px; top: 72px; width: 14px; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png'); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
            <ui:Label name="SceneName" text="" style="width: 208px; height: 17px; font-size: 13px; color: rgb(0, 255, 0); -unity-text-align: middle-center; -unity-font-style: bold; margin-top: 1px;"/>
            <ui:Label name="ScenePos" text="" style="width: 208px; height: 17px; font-size: 13px; color: rgb(0, 255, 0); -unity-text-align: middle-center;"/>
            <ui:TextField name="MapPosInput" value="" style="display: none;"/>
            <ui:VisualElement name="MinimapBtns" style="position: absolute; left: 162px; top: 136px; width: 44px; height: 18px; flex-direction: row; justify-content: flex-end;">
                <ui:VisualElement name="MinimapMarkerBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="ToggleMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="WorldMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="CaveMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PC Ui3/icon_bar.ini: 7 icon strip. Buttons MOVED into UtilityTabActivity (tab Hoạt động)
             to group all event/feature entries by meaning. Wrapper kept empty + hidden to avoid
             duplicate element names and preserve legacy binding compatibility. -->
        <ui:VisualElement name="PcIconBar" class="hud-pc-icon-bar" style="display: none;"/>

        <!-- ═══ MONEY — vltkunity Money.prefab (3 currency rows: Copper/Gold/Silver + add btns), under avatar ═══ -->
        <ui:VisualElement name="MoneyPanel" style="position: absolute; left: 10px; top: 112px; width: 170px; height: 96px; flex-direction: column; background-color: rgba(0, 0, 0, 0);">
            <!-- Copper (Đồng) Row -->
            <ui:VisualElement style="flex-direction: row; height: 26px; align-items: center; margin-bottom: 4px; background-color: rgba(0, 0, 0, 0.65); border-radius: 4px; padding-left: 4px; padding-right: 4px;">
                <ui:VisualElement style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/money/tongqian.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 6px;"/>
                <ui:Label name="MoneyCopperAmount" text="0" style="flex-grow: 1; height: 20px; font-size: 13px; color: rgb(246, 255, 105); -unity-text-align: middle-left; -unity-font-style: bold; margin-right: 6px;"/>
                <ui:VisualElement name="MoneyCopperAddBtn" style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_plus.png'); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
            <!-- Gold (Vàng) Row -->
            <ui:VisualElement style="flex-direction: row; height: 26px; align-items: center; margin-bottom: 4px; background-color: rgba(0, 0, 0, 0.65); border-radius: 4px; padding-left: 4px; padding-right: 4px;">
                <ui:VisualElement style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/money/jinbi.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 6px;"/>
                <ui:Label name="MoneyGoldAmount" text="0" style="flex-grow: 1; height: 20px; font-size: 13px; color: rgb(246, 255, 105); -unity-text-align: middle-left; -unity-font-style: bold; margin-right: 6px;"/>
                <ui:VisualElement name="MoneyGoldAddBtn" style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_plus.png'); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
            <!-- Silver (Bạc) Row -->
            <ui:VisualElement style="flex-direction: row; height: 26px; align-items: center; background-color: rgba(0, 0, 0, 0.65); border-radius: 4px; padding-left: 4px; padding-right: 4px;">
                <ui:VisualElement style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/money/yinliang.png'); -unity-background-scale-mode: scale-to-fit; margin-right: 6px;"/>
                <ui:Label name="MoneySilverAmount" text="0" style="flex-grow: 1; height: 20px; font-size: 13px; color: rgb(246, 255, 105); -unity-text-align: middle-left; -unity-font-style: bold; margin-right: 6px;"/>
                <ui:VisualElement name="MoneySilverAddBtn" style="width: 20px; height: 20px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_plus.png'); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ DEVICE STATUS — vltkunity DeviceStatus.prefab (wifi/battery/time/RTT), bottom-right corner ═══ -->
        <!-- Uses inline styling to draw simulated wifi signal strength bars and battery shell for professional visuals. -->
        <ui:VisualElement name="DeviceStatusPanel" style="position: absolute; left: 1060px; top: 686px; width: 210px; height: 28px; flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.45); border-width: 1px; border-color: rgba(100, 100, 100, 0.4); border-radius: 4px; padding: 2px;">
            <!-- Wifi signal strength indicator bars -->
            <ui:VisualElement name="DeviceWifi" style="flex-direction: row; align-items: flex-end; width: 18px; height: 14px; margin-left: 8px; background-color: rgba(0,0,0,0); margin-right: 4px;">
                <ui:VisualElement style="width: 3px; height: 5px; background-color: rgb(0, 180, 0); margin-right: 2px;"/>
                <ui:VisualElement style="width: 3px; height: 9px; background-color: rgb(0, 180, 0); margin-right: 2px;"/>
                <ui:VisualElement style="width: 3px; height: 13px; background-color: rgb(0, 180, 0);"/>
            </ui:VisualElement>
            <!-- Battery level shell + fill -->
            <ui:VisualElement name="DeviceBattery" style="flex-direction: row; align-items: center; width: 26px; height: 14px; border-width: 1px; border-color: rgb(180, 180, 180); border-radius: 2px; padding: 1px; margin-right: 8px; background-color: rgba(0,0,0,0);">
                <ui:VisualElement style="flex-grow: 1; height: 10px; background-color: rgb(0, 180, 0); width: 80%;"/>
                <ui:VisualElement style="width: 2px; height: 6px; background-color: rgb(180, 180, 180); position: absolute; right: -3px;"/>
            </ui:VisualElement>
            <!-- Time & Ping RTT display matching green theme -->
            <ui:Label name="DeviceTime" text="00:00:00" style="width: 68px; font-size: 12px; color: rgb(0, 180, 0); -unity-text-align: middle-left; -unity-font-style: bold; margin: 0; padding: 0;"/>
            <ui:Label name="DeviceRtt" text="0ms" style="width: 48px; font-size: 12px; color: rgb(0, 180, 0); -unity-text-align: middle-left; -unity-font-style: bold; margin: 0; padding: 0;"/>
        </ui:VisualElement>

        <!-- ═══ MAP PREVIEW (large, tap minimap to open) ═══ -->
        <ui:VisualElement name="MapPreviewOverlay" class="hud-map-preview-overlay hidden">
            <ui:VisualElement name="MapPreviewWindow" class="hud-map-preview-window">
                <ui:VisualElement name="MapPreviewHeader" class="hud-map-preview-header">
                    <ui:Label name="MapPreviewTitle" text="Bản đồ" class="hud-map-preview-title"/>
                    <ui:VisualElement name="MapPreviewClose" class="hud-map-preview-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="MapPreviewFrame" class="hud-map-preview-frame">
                    <ui:VisualElement name="MapPreviewContent" class="hud-map-preview-content">
                        <ui:VisualElement name="MapPreviewTarget" class="hud-map-target-dot"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MapPreviewPlayerDot" class="hud-player-dot hud-preview-player-dot"/>
                </ui:VisualElement>
                <ui:Label name="MapPreviewCoords" text="" class="hud-map-preview-coords"/>
                <ui:Label text="Chạm bản đồ để di chuyển" class="hud-map-preview-help"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CÁI BANG SKILL PANEL ═══ -->
        <ui:VisualElement name="CaiBangSkillPanel" class="hud-cb-skill-panel hidden">
            <ui:VisualElement name="CaiBangSkillClose" class="hud-cb-close"/>
            <ui:Label name="CaiBangSkillSummary" text="200" class="hud-cb-summary"/>
            <ui:ScrollView name="CaiBangSkillList" class="hud-cb-list"/>
            <ui:VisualElement name="CaiBangSkillPageOne" class="hud-cb-page-tab hud-cb-page-one"><ui:Label text="Một" class="hud-cb-page-tab-label"/></ui:VisualElement>
            <ui:VisualElement name="CaiBangSkillPageTwo" class="hud-cb-page-tab hud-cb-page-two"><ui:Label text="Hai" class="hud-cb-page-tab-label"/></ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CHAT AREA — PC bottom-left ═══ -->
        <!-- Per user request 2026-06-20: chat messages + tabs panel is removed.
             Chat input row now sits directly above the PC menu toolbar (see ChatInputRow).
             ChatBar is kept in the UXML tree for C# binding compatibility but hidden. -->
        <ui:VisualElement name="ChatBar" class="hud-chat-panel hidden" style="display: none;">
            <ui:Label name="ChatWarning" text="!! Hãy sử dụng hồi phục" class="hud-chat-warning hidden"/>
            <!-- PC 主界面玩家信息窗口.ini [OpenChannelBtn] at 110,430,60x60 has no concrete SPR file (Image is only a folder).
                 Keep it as an invisible PC-equivalent proxy so mobile gets the behavior without drawing the bad 7-o'clock wrapper. -->
            <ui:VisualElement name="OpenChannelBtn" class="hud-open-channel-btn"/>
            <!-- Chat messages display area — populated by C# ChatSystem -->
            <ui:VisualElement name="ChatMessages" class="hud-chat-messages"/>
            <!-- Chat tab strip — tabs sit below the messages area just like PC -->
            <ui:VisualElement name="ChatTabs" class="hud-chat-tabs">
                <ui:VisualElement name="ChatTabAll" class="hud-chat-tab active"><ui:Label text="Tất cả" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabPrivate" class="hud-chat-tab"><ui:Label text="Mật" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabRoom" class="hud-chat-tab"><ui:Label text="Phòng" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabGuild" class="hud-chat-tab"><ui:Label text="Bang hội" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabFaction" class="hud-chat-tab"><ui:Label text="Môn phái" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabOther" class="hud-chat-tab"><ui:Label text="Khác" class="hud-chat-tab-label"/></ui:VisualElement>
            </ui:VisualElement>
            <!-- PC chat rail — slim vertical scrollbar (PC-accurate, mobile-adapted)
                 PC source: 0c164d5c.ini → spr.pak \Spr\Ui3\聊天条\ + \Spr\Ui3\好友qq\ -->
            <ui:VisualElement name="ChatRail" class="hud-chat-rail">
                <!-- Top: PC 聊天条底部改.spr — resize handle -->
                <ui:VisualElement name="ChatSizeBtn" class="hud-chat-rail-btn hud-chat-size"><ui:VisualElement class="hud-chat-rail-icon chat-size"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollUpBtn" class="hud-chat-rail-btn hud-chat-scroll-up" style="display: none;"/>
                <!-- Middle: PC 聊天条中部改.spr — scroll track background (stretches) -->
                <ui:VisualElement name="ChatRoomScrollTrack" class="hud-chat-room-scroll-track"/>
                <!-- Thumb: PC 通用拖动条.spr — draggable scroll knob -->
                <ui:VisualElement name="ChatScrollThumbBtn" class="hud-chat-rail-btn hud-chat-scroll-thumb"><ui:VisualElement class="hud-chat-rail-icon chat-thumb"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollDownBtn" class="hud-chat-rail-btn hud-chat-scroll-down" style="display: none;"/>
                <ui:VisualElement name="ChatSplitBtn" class="hud-chat-rail-btn hud-chat-split" style="display: none;"/>
                <ui:VisualElement name="ChatChannelToggleBtn" class="hud-chat-rail-btn hud-chat-channel-toggle" style="display: none;"/>
                <ui:VisualElement name="ChatShadowBtn" class="hud-chat-rail-btn hud-chat-shadow" style="display: none;"/>
                <!-- Bottom: PC 聊天条顶部改.spr — drag-move handle -->
                <ui:VisualElement name="ChatMoveBtn" class="hud-chat-rail-btn hud-chat-move"><ui:VisualElement class="hud-chat-rail-icon chat-move"/></ui:VisualElement>
                <ui:VisualElement name="ChatSysUpBtn" class="hud-chat-rail-btn hud-chat-sys-up" style="display: none;"/>
                <ui:VisualElement name="ChatSysDownBtn" class="hud-chat-rail-btn hud-chat-sys-down" style="display: none;"/>
                <ui:VisualElement name="ChatSysOpenBtn" class="hud-chat-rail-btn hud-chat-sys-open" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- PC bottom bar — direct absolute children of GameHud, no wrapper.
             Positions are absolute pixel coords for mobile 1280x720, derived from
             PC 600x480 evidence with 1.5x scale. All positions set inline (USS class
             rules aren't being applied in this scene; inline overrides take priority). -->
        <!-- Quick slots (PC left toolbar) y=440-475, x=5-150 in PC 600x480 -->
        <!-- ═══ BOTTOM BAR BACKGROUND — must be FIRST in z-order so buttons paint on top ═══ -->
