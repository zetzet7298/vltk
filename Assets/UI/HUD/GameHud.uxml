<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="project://database/Assets/UI/HUD/GameHud.uss" />
    <ui:VisualElement name="GameHud" class="hud-root">

        <!-- ═══ TOP STATUS BAR — PC 顶部控制条.ini, 1.6x scale (800→1280) ═══ -->
        <!-- C# controller sets panel position/size at runtime (left=safeX, top=safeY, w=1280, h=40).
             All children use INLINE styles because USS classes stopped applying in this scene. -->
        <ui:VisualElement name="TopBarPanel" class="hud-top-bar-panel">
            <ui:Label name="PcConnectionStatusText" text="Hoạt động tốt" style="position: absolute; left: 8px; top: 2px; width: 130px; height: 13px; color: rgb(60, 255, 160); font-size: 11px; -unity-text-align: middle-left; background-color: rgba(0, 0, 0, 0); border-width: 0px;"/>

            <!-- PC panel bg: 新血条面板.spr 552x17, scaled 1.6x = 883x27 -->
            <ui:VisualElement name="PcBarPanelBg" style="position: absolute; left: 192px; top: 0px; width: 883px; height: 27px; background-image: url('project://database/Assets/UI/HUD/Art/top_status_strip.png'); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(0, 0, 0, 0); border-width: 0px;"/>

            <!-- Level: PC Left=155→248, Top=2→3 -->
            <ui:Label name="LevelText" text="1" style="position: absolute; left: 248px; top: 3px; width: 32px; height: 19px; font-size: 14px; color: rgb(55, 231, 63); -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;"/>

            <!-- Stamina track: PC Left=178→285, Top=3→5, W=104→166, H=9→14 -->
            <ui:VisualElement name="StaminaBarTrack" style="position: absolute; left: 285px; top: 5px; width: 166px; height: 14px; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;">
                <ui:VisualElement name="StaminaBarFill" style="width: 100%; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/bar_stamina_fill.png'); -unity-background-scale-mode: stretch-to-fill;"/>
            </ui:VisualElement>

            <!-- HP track: PC Left=288→461 -->
            <ui:VisualElement name="HpBarTrack" style="position: absolute; left: 461px; top: 5px; width: 166px; height: 14px; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;">
                <ui:VisualElement name="HpBarFill" style="width: 100%; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/bar_hp_fill.png'); -unity-background-scale-mode: stretch-to-fill;"/>
            </ui:VisualElement>

            <!-- MP track: PC Left=398→637 -->
            <ui:VisualElement name="MpBarTrack" style="position: absolute; left: 637px; top: 5px; width: 166px; height: 14px; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;">
                <ui:VisualElement name="MpBarFill" style="width: 100%; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/bar_mp_fill.png'); -unity-background-scale-mode: stretch-to-fill;"/>
            </ui:VisualElement>

            <!-- EXP track: PC Left=508→813 -->
            <ui:VisualElement name="ExpBarTrack" style="position: absolute; left: 813px; top: 5px; width: 166px; height: 14px; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;">
                <ui:VisualElement name="ExpBarFill" style="width: 0%; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/bar_exp_fill.png'); -unity-background-scale-mode: stretch-to-fill;"/>
            </ui:VisualElement>

            <!-- Rank: PC Left=642→1027 -->
            <ui:Label name="RankText" text="Hạng ?" style="position: absolute; left: 1027px; top: 3px; width: 45px; height: 19px; font-size: 12px; color: rgb(55, 231, 63); -unity-text-align: middle-center; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0); border-width: 0px; overflow: hidden;"/>

            <!-- Hidden data labels (IMGUI overlay draws the actual text) -->
            <ui:Label name="HpText" text="100/100" style="display: none;"/>
            <ui:Label name="MpText" text="50/50" style="display: none;"/>
            <ui:Label name="StaminaText" text="100/100" style="display: none;"/>
            <ui:Label name="ExpText" text="0%" style="display: none;"/>
        </ui:VisualElement>

        <!-- ═══ MINIMAP — PC 小地图_小.ini (MiniMap Left=670,Top=0,W=130,H=130), 1.6x scale (208x156) ═══ -->
        <!-- MapRect: PC 1,1,128,128 → 1.6,1.2,204.8,153.6 (≈205x154)
             SceneName/ScenePos: PC 0,1,112,14 / 2,15,112,14 (green)
             SwitchBtn: PC 101,115,14,14 → 162,138,22,17
             WorldMapBtn: PC 115,115,14,14 → 184,138,22,17 -->
        <!-- ═══ TOP-RIGHT MINIMAP (PC top-right 256x128 scaled 1.5x → 208x156 @ left=1072px) ═══ -->
        <!-- display: flex re-asserted 2026-06-22: USS class .hud-minimap-panel or runtime may
             have flipped it to none; force visible so the player can re-open the map preview. -->
        <ui:VisualElement name="MinimapPanel" class="hud-minimap-panel" style="position: absolute; left: 1072px; top: 0px; width: 208px; height: 156px; align-items: center; background-color: rgba(0, 0, 0, 0); display: flex;">
            <ui:VisualElement name="MinimapFrame" style="width: 208px; height: 154px; border-width: 2px; border-color: rgb(60, 80, 60); background-color: rgba(2, 8, 4, 0.92); overflow: hidden;">
                <ui:VisualElement name="MinimapContent" style="position: absolute; left: 2px; top: 1px; width: 205px; height: 154px; background-color: rgba(15, 25, 15, 0.90); background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/MiniMap/balingxian.png'); -unity-background-scale-mode: stretch-to-fill;">
                    <ui:VisualElement name="MiniMapTarget" style="position: absolute; left: -1000px; top: -1000px; width: 12px; height: 12px; border-radius: 6px; background-color: rgb(255, 230, 40); border-width: 0px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerDot" style="position: absolute; left: 98px; top: 72px; width: 14px; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png'); -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
            <ui:Label name="SceneName" text="" style="width: 208px; height: 17px; font-size: 13px; color: rgb(0, 255, 0); -unity-text-align: middle-center; -unity-font-style: bold; margin-top: 1px;"/>
            <ui:Label name="ScenePos" text="" style="width: 208px; height: 17px; font-size: 13px; color: rgb(0, 255, 0); -unity-text-align: middle-center;"/>
            <ui:TextField name="MapPosInput" value="" style="display: none;"/>
            <ui:VisualElement name="MinimapBtns" style="position: absolute; left: 162px; top: 136px; width: 44px; height: 18px; flex-direction: row; justify-content: flex-end;">
                <ui:VisualElement name="MinimapMarkerBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="ToggleMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="WorldMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement name="CaveMapBtn" style="width: 22px; height: 17px; margin-left: 0px; margin-right: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; -unity-background-scale-mode: scale-to-fit;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PC Ui3/icon_bar.ini: 7 icon strip. Buttons MOVED into UtilityTabActivity (tab Hoạt động)
             to group all event/feature entries by meaning. Wrapper kept empty + hidden to avoid
             duplicate element names and preserve legacy binding compatibility. -->
        <ui:VisualElement name="PcIconBar" class="hud-pc-icon-bar" style="display: none;"/>

        <!-- ═══ MAP PREVIEW (large, tap minimap to open) ═══ -->
        <ui:VisualElement name="MapPreviewOverlay" class="hud-map-preview-overlay hidden">
            <ui:VisualElement name="MapPreviewWindow" class="hud-map-preview-window">
                <ui:VisualElement name="MapPreviewHeader" class="hud-map-preview-header">
                    <ui:Label name="MapPreviewTitle" text="Bản đồ" class="hud-map-preview-title"/>
                    <ui:VisualElement name="MapPreviewClose" class="hud-map-preview-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="MapPreviewFrame" class="hud-map-preview-frame">
                    <ui:VisualElement name="MapPreviewContent" class="hud-map-preview-content">
                        <ui:VisualElement name="MapPreviewTarget" class="hud-map-target-dot"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MapPreviewPlayerDot" class="hud-player-dot hud-preview-player-dot"/>
                </ui:VisualElement>
                <ui:Label name="MapPreviewCoords" text="" class="hud-map-preview-coords"/>
                <ui:Label text="Chạm bản đồ để di chuyển" class="hud-map-preview-help"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CÁI BANG SKILL PANEL ═══ -->
        <ui:VisualElement name="CaiBangSkillPanel" class="hud-cb-skill-panel hidden">
            <ui:VisualElement name="CaiBangSkillClose" class="hud-cb-close"/>
            <ui:Label name="CaiBangSkillSummary" text="200" class="hud-cb-summary"/>
            <ui:ScrollView name="CaiBangSkillList" class="hud-cb-list"/>
            <ui:VisualElement name="CaiBangSkillPageOne" class="hud-cb-page-tab hud-cb-page-one"><ui:Label text="Một" class="hud-cb-page-tab-label"/></ui:VisualElement>
            <ui:VisualElement name="CaiBangSkillPageTwo" class="hud-cb-page-tab hud-cb-page-two"><ui:Label text="Hai" class="hud-cb-page-tab-label"/></ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CHAT AREA — PC bottom-left ═══ -->
        <!-- Per user request 2026-06-20: chat messages + tabs panel is removed.
             Chat input row now sits directly above the PC menu toolbar (see ChatInputRow).
             ChatBar is kept in the UXML tree for C# binding compatibility but hidden. -->
        <ui:VisualElement name="ChatBar" class="hud-chat-panel hidden" style="display: none;">
            <ui:Label name="ChatWarning" text="!! Hãy sử dụng hồi phục" class="hud-chat-warning hidden"/>
            <!-- PC 主界面玩家信息窗口.ini [OpenChannelBtn] at 110,430,60x60 has no concrete SPR file (Image is only a folder).
                 Keep it as an invisible PC-equivalent proxy so mobile gets the behavior without drawing the bad 7-o'clock wrapper. -->
            <ui:VisualElement name="OpenChannelBtn" class="hud-open-channel-btn"/>
            <!-- Chat messages display area — populated by C# ChatSystem -->
            <ui:VisualElement name="ChatMessages" class="hud-chat-messages"/>
            <!-- Chat tab strip — tabs sit below the messages area just like PC -->
            <ui:VisualElement name="ChatTabs" class="hud-chat-tabs">
                <ui:VisualElement name="ChatTabAll" class="hud-chat-tab active"><ui:Label text="Tất cả" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabPrivate" class="hud-chat-tab"><ui:Label text="Mật" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabRoom" class="hud-chat-tab"><ui:Label text="Phòng" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabGuild" class="hud-chat-tab"><ui:Label text="Bang hội" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabFaction" class="hud-chat-tab"><ui:Label text="Môn phái" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabOther" class="hud-chat-tab"><ui:Label text="Khác" class="hud-chat-tab-label"/></ui:VisualElement>
            </ui:VisualElement>
            <!-- PC chat rail — slim vertical scrollbar (PC-accurate, mobile-adapted)
                 PC source: 0c164d5c.ini → spr.pak \Spr\Ui3\聊天条\ + \Spr\Ui3\好友qq\ -->
            <ui:VisualElement name="ChatRail" class="hud-chat-rail">
                <!-- Top: PC 聊天条底部改.spr — resize handle -->
                <ui:VisualElement name="ChatSizeBtn" class="hud-chat-rail-btn hud-chat-size"><ui:VisualElement class="hud-chat-rail-icon chat-size"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollUpBtn" class="hud-chat-rail-btn hud-chat-scroll-up" style="display: none;"/>
                <!-- Middle: PC 聊天条中部改.spr — scroll track background (stretches) -->
                <ui:VisualElement name="ChatRoomScrollTrack" class="hud-chat-room-scroll-track"/>
                <!-- Thumb: PC 通用拖动条.spr — draggable scroll knob -->
                <ui:VisualElement name="ChatScrollThumbBtn" class="hud-chat-rail-btn hud-chat-scroll-thumb"><ui:VisualElement class="hud-chat-rail-icon chat-thumb"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollDownBtn" class="hud-chat-rail-btn hud-chat-scroll-down" style="display: none;"/>
                <ui:VisualElement name="ChatSplitBtn" class="hud-chat-rail-btn hud-chat-split" style="display: none;"/>
                <ui:VisualElement name="ChatChannelToggleBtn" class="hud-chat-rail-btn hud-chat-channel-toggle" style="display: none;"/>
                <ui:VisualElement name="ChatShadowBtn" class="hud-chat-rail-btn hud-chat-shadow" style="display: none;"/>
                <!-- Bottom: PC 聊天条顶部改.spr — drag-move handle -->
                <ui:VisualElement name="ChatMoveBtn" class="hud-chat-rail-btn hud-chat-move"><ui:VisualElement class="hud-chat-rail-icon chat-move"/></ui:VisualElement>
                <ui:VisualElement name="ChatSysUpBtn" class="hud-chat-rail-btn hud-chat-sys-up" style="display: none;"/>
                <ui:VisualElement name="ChatSysDownBtn" class="hud-chat-rail-btn hud-chat-sys-down" style="display: none;"/>
                <ui:VisualElement name="ChatSysOpenBtn" class="hud-chat-rail-btn hud-chat-sys-open" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- PC bottom bar — direct absolute children of GameHud, no wrapper.
             Positions are absolute pixel coords for mobile 1280x720, derived from
             PC 600x480 evidence with 1.5x scale. All positions set inline (USS class
             rules aren't being applied in this scene; inline overrides take priority). -->
        <!-- Quick slots (PC left toolbar) y=440-475, x=5-150 in PC 600x480 -->
        <!-- ═══ BOTTOM BAR BACKGROUND — must be FIRST in z-order so buttons paint on top ═══ -->
        <!-- Hidden 2026-06-22: covers joystick (MobileJoystick) at bottom-left, blocking move input. -->
        <ui:VisualElement name="PcBottomBarBg" style="position: absolute; left: 0px; bottom: 0px; width: 1280px; height: 90px; background-image: url('project://database/Assets/UI/HUD/Art/bottom_bar_bg.png'); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(0, 0, 0, 0); border-width: 0px; display: none;"/>
        <!-- PC chat messages — y=418-435 in PC -->
        <ui:VisualElement name="PcChatMessagesArea" style="position: absolute; left: 8px; bottom: 50px; width: 412px; height: 25px; background-color: rgba(0, 0, 0, 0);"/>
        <!-- PC quick slots (玩家信息主界面.ini Item_0/1/2): W=30 H=30 at Left=235,270,304 Top=545.
             1.6x/1.2x scale: x=376,432,486, bottom=30, w=48, h=36.
             Top=545 in PC 600 = 55px above bottom → mobile 30px above bottom. -->
        <ui:VisualElement name="PcQuickSlot1" style="position: absolute; left: 376px; bottom: 30px; width: 48px; height: 36px; background-color: rgba(20, 14, 8, 0.9); border-width: 2px; border-color: rgb(190, 165, 95); overflow: hidden; align-items: center; justify-content: center;">
            <ui:Label text="1" style="width: 48px; height: 36px; color: rgb(180, 220, 255); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="PcQuickSlot2" style="position: absolute; left: 432px; bottom: 30px; width: 48px; height: 36px; background-color: rgba(20, 14, 8, 0.9); border-width: 2px; border-color: rgb(190, 165, 95); overflow: hidden; align-items: center; justify-content: center;">
            <ui:Label text="2" style="width: 48px; height: 36px; color: rgb(180, 220, 255); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="PcQuickSlot3" style="position: absolute; left: 486px; bottom: 30px; width: 48px; height: 36px; background-color: rgba(20, 14, 8, 0.9); border-width: 2px; border-color: rgb(190, 165, 95); overflow: hidden; align-items: center; justify-content: center;">
            <ui:Label text="3" style="width: 48px; height: 36px; color: rgb(180, 220, 255); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0);"/>
        </ui:VisualElement>
        <!-- PC ImediaLeftSkill/RightSkill (玩家信息主界面.ini): 36x36 at Left=369,404 Top=544.
             1.6x/1.2x scale: x=590,646, bottom=24, w=58, h=43. -->
        <ui:VisualElement name="PcLeftSkillBtn" style="position: absolute; left: 590px; bottom: 24px; width: 58px; height: 43px; background-color: rgba(20, 14, 8, 0.9); border-width: 2px; border-color: rgb(190, 165, 95); align-items: center; justify-content: center;">
            <ui:Label text="Tả" style="position: absolute; left: 0px; top: 0px; width: 58px; height: 14px; color: rgb(255, 220, 100); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0.7);"/>
        </ui:VisualElement>
        <ui:VisualElement name="PcRightSkillBtn" style="position: absolute; left: 646px; bottom: 24px; width: 58px; height: 43px; background-color: rgba(20, 14, 8, 0.9); border-width: 2px; border-color: rgb(190, 165, 95); align-items: center; justify-content: center;">
            <ui:Label text="Hữu" style="position: absolute; left: 0px; top: 0px; width: 58px; height: 14px; color: rgb(255, 220, 100); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0.7);"/>
        </ui:VisualElement>
        <!-- PC chat tabs (Tất cả / Mật / Môn phái / Bang hội / Phòng / Khác) — y=402-418 -->
        <ui:VisualElement name="PcChatTabs" style="position: absolute; left: 15px; bottom: 80px; width: 397px; height: 24px; flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.5); border-radius: 3px; padding-left: 4px;">
            <ui:VisualElement name="ChatTabAll" class="active" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Tất cả" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
            <ui:VisualElement name="ChatTabPrivate" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Mật" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
            <ui:VisualElement name="ChatTabFaction" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Môn phái" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
            <ui:VisualElement name="ChatTabGuild" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Bang hội" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
            <ui:VisualElement name="ChatTabRoom" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Phòng" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
            <ui:VisualElement name="ChatTabOther" style="width: 52px; height: 24px; align-items: center; justify-content: center; margin-left: 6px; margin-right: 6px; background-color: rgba(0, 0, 0, 0);"><ui:Label text="Khác" style="color: rgb(102, 204, 255); font-size: 12px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);"/></ui:VisualElement>
        </ui:VisualElement>
        <!-- Channel identity button — PC ChannelBtn Left=217, Top=580, W=20, H=20
             1.6x/1.2x: x=347, bottom=0, w=32, h=24 -->
        <ui:VisualElement name="ChatChannelIdentityBtn" style="position: absolute; left: 347px; bottom: 0px; width: 32px; height: 24px; background-color: rgb(35, 50, 70); border-width: 1px; border-color: rgba(140, 165, 145, 0.55); border-radius: 2px; background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－附近频道.png'); -unity-background-scale-mode: scale-to-fit;"/>
        <!-- Options button — PC Options Left=183, Top=565, W=30, H=30
             1.6x/1.2x: x=293, bottom=6, w=48, h=36 -->
        <ui:VisualElement name="ChatOptionsBtn" style="position: absolute; left: 293px; bottom: 6px; width: 48px; height: 36px; background-color: rgb(35, 50, 70); border-width: 1px; border-color: rgba(140, 165, 145, 0.55); border-radius: 2px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_setting.png'); -unity-background-scale-mode: scale-to-fit;"/>
        <!-- Chat input — PC InputEdit Left=238, Top=582, W=190, H=15
             1.6x/1.2x: x=381, bottom=4, w=304, h=18 -->
        <ui:TextField name="ChatInput" value="" style="position: absolute; left: 381px; bottom: 4px; width: 304px; height: 18px; color: rgb(40, 30, 15); font-size: 12px; background-color: rgb(212, 201, 178); border-width: 1px; border-color: rgb(120, 100, 70); border-radius: 2px;"/>
        <!-- Face button — PC Face Left=431, Top=581, W=20, H=20
             1.6x/1.2x: x=690, bottom=0, w=32, h=24 -->
        <ui:VisualElement name="FaceBtn" style="position: absolute; left: 690px; bottom: 0px; width: 32px; height: 24px; background-color: rgb(220, 165, 50); border-width: 1px; border-color: rgb(80, 50, 20); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-image: url('project://database/Assets/UI/HUD/Art/btn_chat_face.png'); -unity-background-scale-mode: scale-to-fit;"/>
        <!-- Send button — PC SendBtn Left=451, Top=581, W=20, H=20
             1.6x/1.2x: x=722, bottom=0, w=32, h=24 -->
        <ui:VisualElement name="SendBtn" style="position: absolute; left: 722px; bottom: 0px; width: 32px; height: 24px; background-color: rgb(35, 50, 70); border-width: 1px; border-color: rgba(140, 165, 145, 0.55); border-radius: 2px; align-items: center; justify-content: center; overflow: hidden;">
            <ui:VisualElement name="SendBtnIcon" style="width: 24px; height: 24px; background-image: url('project://database/Assets/UI/HUD/Art/btn_chat_send.png'); -unity-background-scale-mode: scale-to-fit;"/>
        </ui:VisualElement>
        <!-- Friend button — PC Friend Left=675, Top=557, W=50, H=50
             1.6x/1.2x: x=1080, bottom=0, w=80, h=60 -->
        <ui:VisualElement name="ChatFriendBtn" style="position: absolute; left: 1080px; bottom: 0px; width: 80px; height: 60px; background-color: rgb(35, 50, 70); border-width: 2px; border-color: rgb(190, 165, 95); border-radius: 4px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_partner.png'); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:VisualElement name="ChatTreasureBtn" style="position: absolute; left: 735px; bottom: 8px; width: 60px; height: 70px; background-color: rgb(35, 50, 70); border-width: 2px; border-color: rgb(190, 165, 95); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-left-radius: 30px; border-bottom-right-radius: 30px; background-image: url('project://database/Assets/UI/HUD/Art/btn_treasure.png'); -unity-background-scale-mode: scale-to-fit;"/>

        <!-- ═══ MOBILE COMBAT HUD — PC visual assets, mobile-first layout ═══ -->
