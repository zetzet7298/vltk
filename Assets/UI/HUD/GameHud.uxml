<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="project://database/Assets/UI/HUD/GameHud.uss" />
    <ui:VisualElement name="GameHud" class="hud-root">

        <!-- ═══ TOP STATUS BAR — PC 800 顶部控制条.ini / uid 8da7027d ═══ -->
        <!-- PC Main: Left=120, Top=0, Width=552, Height=17. Values are drawn by Vietnamese IMGUI overlay. -->
        <ui:VisualElement name="TopBarPanel" class="hud-top-bar-panel">
            <!-- PC 主界面玩家信息窗口.ini [DateTime]: network/smooth status text at top-left. -->
            <ui:Label name="PcConnectionStatusText" text="Hoạt động tốt" class="hud-pc-connection-status"/>
            <ui:VisualElement name="PcBarPanelBg" class="hud-pc-bar-panel-bg"/>

            <!-- Level number: PC Main.Left+35, Top=2, W=20, H=12 -->
            <ui:Label name="LevelText" text="1" class="hud-level-label"/>

            <!-- Stamina: PC Main.Left+58, Top=3, W=104, H=14 -->
            <ui:VisualElement name="StaminaBarTrack" class="hud-bar-track hud-stamina-track">
                <ui:VisualElement name="StaminaBarFill" class="hud-bar-fill"/>
            </ui:VisualElement>

            <!-- Life/HP: PC Main.Left+168, Top=3, W=104, H=14 -->
            <ui:VisualElement name="HpBarTrack" class="hud-bar-track hud-hp-track">
                <ui:VisualElement name="HpBarFill" class="hud-bar-fill"/>
            </ui:VisualElement>

            <!-- Mana/MP: PC Main.Left+278, Top=3, W=104, H=14 -->
            <ui:VisualElement name="MpBarTrack" class="hud-bar-track hud-mp-track">
                <ui:VisualElement name="MpBarFill" class="hud-bar-fill"/>
            </ui:VisualElement>

            <!-- Exp: PC Main.Left+388, Top=3, W=104, H=12 -->
            <ui:VisualElement name="ExpBarTrack" class="hud-bar-track hud-exp-track">
                <ui:VisualElement name="ExpBarFill" class="hud-bar-fill"/>
            </ui:VisualElement>

            <!-- WorldSort number: PC Main.Left+522, Top=2, W=28, H=12 -->
            <ui:Label name="RankText" text="Hạng ?" class="hud-rank-label"/>

            <!-- Hidden labels for data binding (IMGUI overlay draws the actual text) -->
            <ui:Label name="HpText" text="100/100" class="hud-hidden-data"/>
            <ui:Label name="MpText" text="50/50" class="hud-hidden-data"/>
            <ui:Label name="StaminaText" text="100/100" class="hud-hidden-data"/>
            <ui:Label name="ExpText" text="0%" class="hud-hidden-data"/>
        </ui:VisualElement>

        <!-- ═══ MINIMAP — PC 小地图_小.ini ═══ -->
        <ui:VisualElement name="MinimapPanel" class="hud-minimap-panel">
            <ui:VisualElement name="MinimapFrame" class="hud-minimap-frame">
                <ui:VisualElement name="MinimapContent" class="hud-minimap-content">
                    <ui:VisualElement name="MiniMapTarget" class="hud-map-target-dot"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerDot" class="hud-player-dot"/>
            </ui:VisualElement>
            <ui:Label name="SceneName" text="" class="hud-scene-name"/>
            <ui:Label name="ScenePos" text="" class="hud-scene-pos"/>
            <ui:TextField name="MapPosInput" value="" class="hud-map-pos-input hidden"/>
            <ui:VisualElement name="MinimapBtns" class="hud-minimap-btns">
                <ui:VisualElement name="MinimapMarkerBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="ToggleMapBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="WorldMapBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="CaveMapBtn" class="hud-minimap-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PC Ui3/icon_bar.ini: 7 icon strip. Buttons MOVED into UtilityTabActivity (tab Hoạt động)
             to group all event/feature entries by meaning. Wrapper kept empty + hidden to avoid
             duplicate element names and preserve legacy binding compatibility. -->
        <ui:VisualElement name="PcIconBar" class="hud-pc-icon-bar" style="display: none;"/>

        <!-- ═══ MAP PREVIEW (large, tap minimap to open) ═══ -->
        <ui:VisualElement name="MapPreviewOverlay" class="hud-map-preview-overlay hidden">
            <ui:VisualElement name="MapPreviewWindow" class="hud-map-preview-window">
                <ui:VisualElement name="MapPreviewHeader" class="hud-map-preview-header">
                    <ui:Label name="MapPreviewTitle" text="Bản đồ" class="hud-map-preview-title"/>
                    <ui:VisualElement name="MapPreviewClose" class="hud-map-preview-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="MapPreviewFrame" class="hud-map-preview-frame">
                    <ui:VisualElement name="MapPreviewContent" class="hud-map-preview-content">
                        <ui:VisualElement name="MapPreviewTarget" class="hud-map-target-dot"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MapPreviewPlayerDot" class="hud-player-dot hud-preview-player-dot"/>
                </ui:VisualElement>
                <ui:Label name="MapPreviewCoords" text="" class="hud-map-preview-coords"/>
                <ui:Label text="Chạm bản đồ để di chuyển" class="hud-map-preview-help"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CÁI BANG SKILL PANEL ═══ -->
        <ui:VisualElement name="CaiBangSkillPanel" class="hud-cb-skill-panel hidden">
            <ui:VisualElement name="CaiBangSkillClose" class="hud-cb-close"/>
            <ui:Label name="CaiBangSkillSummary" text="200" class="hud-cb-summary"/>
            <ui:ScrollView name="CaiBangSkillList" class="hud-cb-list"/>
            <ui:VisualElement name="CaiBangSkillPageOne" class="hud-cb-page-tab hud-cb-page-one"><ui:Label text="Một" class="hud-cb-page-tab-label"/></ui:VisualElement>
            <ui:VisualElement name="CaiBangSkillPageTwo" class="hud-cb-page-tab hud-cb-page-two"><ui:Label text="Hai" class="hud-cb-page-tab-label"/></ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ CHAT AREA — PC bottom-left ═══ -->
        <!-- Per user request 2026-06-20: chat messages + tabs panel is removed.
             Chat input row now sits directly above the PC menu toolbar (see ChatInputRow).
             ChatBar is kept in the UXML tree for C# binding compatibility but hidden. -->
        <ui:VisualElement name="ChatBar" class="hud-chat-panel hidden" style="display: none;">
            <ui:Label name="ChatWarning" text="!! Hãy sử dụng hồi phục" class="hud-chat-warning hidden"/>
            <!-- PC 主界面玩家信息窗口.ini [OpenChannelBtn] at 110,430,60x60 has no concrete SPR file (Image is only a folder).
                 Keep it as an invisible PC-equivalent proxy so mobile gets the behavior without drawing the bad 7-o'clock wrapper. -->
            <ui:VisualElement name="OpenChannelBtn" class="hud-open-channel-btn"/>
            <!-- Chat messages display area — populated by C# ChatSystem -->
            <ui:VisualElement name="ChatMessages" class="hud-chat-messages"/>
            <!-- Chat tab strip — tabs sit below the messages area just like PC -->
            <ui:VisualElement name="ChatTabs" class="hud-chat-tabs">
                <ui:VisualElement name="ChatTabAll" class="hud-chat-tab active"><ui:Label text="Tất cả" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabPrivate" class="hud-chat-tab"><ui:Label text="Mật" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabRoom" class="hud-chat-tab"><ui:Label text="Phòng" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabGuild" class="hud-chat-tab"><ui:Label text="Bang hội" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabFaction" class="hud-chat-tab"><ui:Label text="Môn phái" class="hud-chat-tab-label"/></ui:VisualElement>
                <ui:VisualElement name="ChatTabOther" class="hud-chat-tab"><ui:Label text="Khác" class="hud-chat-tab-label"/></ui:VisualElement>
            </ui:VisualElement>
            <!-- PC chat rail — slim vertical scrollbar (PC-accurate, mobile-adapted)
                 PC source: 0c164d5c.ini → spr.pak \Spr\Ui3\聊天条\ + \Spr\Ui3\好友qq\ -->
            <ui:VisualElement name="ChatRail" class="hud-chat-rail">
                <!-- Top: PC 聊天条底部改.spr — resize handle -->
                <ui:VisualElement name="ChatSizeBtn" class="hud-chat-rail-btn hud-chat-size"><ui:VisualElement class="hud-chat-rail-icon chat-size"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollUpBtn" class="hud-chat-rail-btn hud-chat-scroll-up" style="display: none;"/>
                <!-- Middle: PC 聊天条中部改.spr — scroll track background (stretches) -->
                <ui:VisualElement name="ChatRoomScrollTrack" class="hud-chat-room-scroll-track"/>
                <!-- Thumb: PC 通用拖动条.spr — draggable scroll knob -->
                <ui:VisualElement name="ChatScrollThumbBtn" class="hud-chat-rail-btn hud-chat-scroll-thumb"><ui:VisualElement class="hud-chat-rail-icon chat-thumb"/></ui:VisualElement>
                <ui:VisualElement name="ChatScrollDownBtn" class="hud-chat-rail-btn hud-chat-scroll-down" style="display: none;"/>
                <ui:VisualElement name="ChatSplitBtn" class="hud-chat-rail-btn hud-chat-split" style="display: none;"/>
                <ui:VisualElement name="ChatChannelToggleBtn" class="hud-chat-rail-btn hud-chat-channel-toggle" style="display: none;"/>
                <ui:VisualElement name="ChatShadowBtn" class="hud-chat-rail-btn hud-chat-shadow" style="display: none;"/>
                <!-- Bottom: PC 聊天条顶部改.spr — drag-move handle -->
                <ui:VisualElement name="ChatMoveBtn" class="hud-chat-rail-btn hud-chat-move"><ui:VisualElement class="hud-chat-rail-icon chat-move"/></ui:VisualElement>
                <ui:VisualElement name="ChatSysUpBtn" class="hud-chat-rail-btn hud-chat-sys-up" style="display: none;"/>
                <ui:VisualElement name="ChatSysDownBtn" class="hud-chat-rail-btn hud-chat-sys-down" style="display: none;"/>
                <ui:VisualElement name="ChatSysOpenBtn" class="hud-chat-rail-btn hud-chat-sys-open" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- PC: chat input row sits just above the bottom menu toolbar (not inside the chat panel).
             Layout: channel icon | options btn | text field | face emoji btn | send btn | friend btn | treasure btn -->
        <ui:VisualElement name="ChatInputRow" class="hud-chat-input-row">
            <ui:VisualElement name="ChatChannelIdentityBtn" class="hud-chat-channel-identity-btn"/>
            <ui:VisualElement name="ChatOptionsBtn" class="hud-chat-options-btn"/>
            <ui:TextField name="ChatInput" value="" class="hud-chat-input"/>
            <ui:Button name="FaceBtn" text="" class="hud-face-btn"/>
            <ui:VisualElement name="SendBtn" class="hud-send-btn"><ui:VisualElement name="SendBtnIcon" class="hud-send-icon"/></ui:VisualElement>
            <ui:VisualElement name="ChatFriendBtn" class="hud-chat-friend-btn"/>
            <ui:VisualElement name="ChatTreasureBtn" class="hud-chat-treasure-btn"/>
        </ui:VisualElement>

        <!-- ═══ MOBILE COMBAT HUD — PC visual assets, mobile-first layout ═══ -->
        <ui:VisualElement name="TargetLockField" class="hud-target-lock-field">
            <ui:VisualElement name="TargetLockMarker" class="hud-target-lock-marker hidden">
                <ui:Label name="TargetLockName" text="" class="hud-target-lock-name"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ PC-STYLE BOTTOM TOOLBAR MENU BUTTONS ═══ -->
        <!-- PC 工具控制条.ini: 11 buttons in a single 800x45 toolbar.
             Rendered LAST in the GameHud tree so it draws ON TOP of BottomPanel
             (bottom_bar_bg.png) and all other bottom elements. In UI Toolkit,
             later siblings paint above earlier ones.
             5 round 30x30 action buttons on the LEFT (Run/Sit/Horse/Exchange/PK),
             6 menu 40x40 buttons on the RIGHT (Status/Items/Skills/Team/Faction/WorldSort).
             Left/Top positions match the PC INI 1:1. The toolbar overlays the
             PC bottom strip (主界面新版.spr, 800x60) baked into bottom_bar_bg.png.
             CombatActionCluster stays hidden — Run/Sit/Horse/Exchange/PK live here. -->
        <ui:VisualElement name="PcMenuToolbar" class="hud-pc-menu-toolbar">
            <!-- Round action cluster (left, 30x30). PC INI Left=9,40,75,110,145 Top=10 -->
            <ui:VisualElement name="BtnRun"      class="hud-pc-toolbar-btn hud-pc-toolbar-round"><ui:VisualElement name="BtnRunIcon" class="hud-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnSit"      class="hud-pc-toolbar-btn hud-pc-toolbar-round"><ui:VisualElement name="BtnSitIcon" class="hud-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnHorse"    class="hud-pc-toolbar-btn hud-pc-toolbar-round"><ui:VisualElement name="BtnHorseIcon" class="hud-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnExchange" class="hud-pc-toolbar-btn hud-pc-toolbar-round"><ui:VisualElement name="BtnExchangeIcon" class="hud-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnPK"       class="hud-pc-toolbar-btn hud-pc-toolbar-round"><ui:VisualElement name="BtnPKIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <!-- Menu cluster (right, 40x40). PC INI Left=474,514,555,594,635,713 Top=2 -->
            <ui:VisualElement name="BtnStatus"    class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnStatusIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnItems"     class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnItemsIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnSkills"    class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnSkillsIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnTeam"      class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnTeamIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <ui:VisualElement name="BtnFaction"   class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnFactionIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
            <!-- WorldSort (PC 排行) — no SPR art available (跑步.spr/排行.spr missing
                 from jx-source/pak_unpacked), text label fallback. -->
            <ui:VisualElement name="BtnWorldSort" class="hud-pc-toolbar-btn hud-pc-toolbar-menu"><ui:VisualElement name="BtnWorldSortIcon" class="hud-menu-btn-icon"/><ui:Label name="BtnWorldSortLabel" text="BXH" class="hud-pc-toolbar-fallback-label"/></ui:VisualElement>
            <!-- Legacy hidden elements kept for C# binding compatibility (RegisterClick uses these names).
                 Task/ItemEx/Friend/ChatRoom/Treasure/Options were Unity-only extras not in 工具控制条.ini. -->
            <ui:VisualElement name="UtilityToggleBtn" class="hidden" style="display: none;"/>
            <ui:VisualElement name="UtilitySwitchBtn" class="hidden" style="display: none;"/>
            <ui:VisualElement name="MobileUtilityDock" class="hidden" style="display: none;">
                <ui:VisualElement name="UtilityTabCharBtn" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabBagBtn" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabSocialBtn" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabActivityBtn" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabSystemBtn" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabChar" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabBag" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabSocial" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabActivity" class="hidden" style="display: none;"/>
                <ui:VisualElement name="UtilityTabSystem" class="hidden" style="display: none;"/>
                <ui:VisualElement name="BtnTask" class="hidden" style="display: none;"><ui:VisualElement name="BtnTaskIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnItemEx" class="hidden" style="display: none;"><ui:VisualElement name="BtnItemExIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnFriend" class="hidden" style="display: none;"><ui:VisualElement name="BtnFriendIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnChatRoom" class="hidden" style="display: none;"><ui:VisualElement name="BtnChatRoomIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnTreasure" class="hidden" style="display: none;"><ui:VisualElement name="BtnTreasureIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnOptions" class="hidden" style="display: none;"><ui:VisualElement name="BtnOptionsIcon" class="hud-menu-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnRec" class="hidden" style="display: none;"><ui:VisualElement name="BtnRecIcon" class="hud-btn-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarArenaBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarArenaBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarActivityBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarActivityBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarTreasureBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarTreasureBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarShopBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarShopBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarPetBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarPetBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarLoginPrizeBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarLoginPrizeBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="IconBarFuncPrizeBtn" class="hidden" style="display: none;"><ui:VisualElement name="IconBarFuncPrizeBtnIcon" class="hud-pc-icon-bar-icon"/></ui:VisualElement>
                <ui:VisualElement name="MobileUtilityActionRow" class="hidden" style="display: none;"/>
                <ui:VisualElement name="MobileUtilityMenuRowA" class="hidden" style="display: none;"/>
                <ui:VisualElement name="MobileUtilityMenuRowB" class="hidden" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- PC quick item/left-right skill buttons: 1..9 -> ShortcutUseItem, T/P -> mobile skill assignment.
             Mobile: hidden — quick-item access is merged into the Hành trang tab of the categorized dock.
             Kept in UXML for binding/test compatibility. -->
        <ui:VisualElement name="PcShortcutToggleBtn" class="hud-pc-shortcut-toggle-btn" style="display: none;"><ui:Label name="PcShortcutToggleLabel" text="1-9" class="hud-pc-shortcut-toggle-label"/></ui:VisualElement>
        <ui:VisualElement name="PcShortcutDock" class="hud-pc-shortcut-dock hidden" style="display: none;">
            <ui:VisualElement name="PcLeftSkillBtn" class="hud-pc-skill-btn"/>
            <ui:VisualElement name="PcRightSkillBtn" class="hud-pc-skill-btn"/>
            <ui:VisualElement name="PcShortcutGrid" class="hud-pc-shortcut-grid">
                <ui:VisualElement name="PcItemSlot0" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-1"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot1" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-2"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot2" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-3"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot3" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-4"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot4" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-5"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot5" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-6"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot6" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-7"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot7" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-8"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot8" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-9"/></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BottomPanel" class="hud-mobile-bottom">
            <ui:VisualElement name="CombatActionCluster" class="hud-combat-action-cluster">
                <ui:VisualElement name="PrimaryAttackBtn" class="hud-primary-attack-btn"><ui:VisualElement name="PrimaryAttackBtnIcon" class="hud-primary-attack-icon"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot0" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-main"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="1" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot1" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-left"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="2" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot2" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-top"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="3" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot3" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-upper"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="4" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot4" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-extra"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="5" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="BtnRunCombat" class="hud-combat-run-btn"><ui:VisualElement name="BtnRunCombatIcon" class="hud-combat-run-icon"/></ui:VisualElement>
                <!-- Combat-critical quick actions (PK/farm): mount + sit arc beside skill slots for thumb reach. -->
                <ui:VisualElement name="BtnMountQuick" class="hud-combat-quick-btn hud-combat-mount-btn"><ui:VisualElement name="BtnMountQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnSitQuick" class="hud-combat-quick-btn hud-combat-sit-btn"><ui:VisualElement name="BtnSitQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnPKQuick" class="hud-combat-quick-btn hud-combat-pk-btn"><ui:VisualElement name="BtnPKQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="DeckSwitchBtn" class="hud-deck-switch-btn"><ui:Label name="DeckSwitchLabel" text="A" class="hud-deck-switch-label"/></ui:VisualElement>
                <ui:VisualElement name="CancelCastZone" class="hud-cancel-cast-zone hidden"><ui:Label text="Hủy" class="hud-cancel-cast-label"/></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Buff / Debuff panel -->
        <ui:VisualElement name="BuffPanel" class="hud-buff-panel">
        </ui:VisualElement>

        <!-- Team Preview -->
        <ui:VisualElement name="TeamPreview" class="hud-team-preview hidden">
        </ui:VisualElement>

        <!-- PC HUD tool panel: opened by Status/ItemEx/Task/Friend/Faction/ChatRoom/Options/Rec.
             Background element loaded with per-panel PC SPR (skill/items/guild/team/system bg) by title.
             Tab strip below header holds per-page PC tab buttons (common_tab.spr) for panels
             that have sub-pages (e.g. Character: 属性/装备/经脉/江湖评价). -->
        <ui:VisualElement name="PcToolPanel" class="hud-pc-tool-panel hidden">
            <ui:VisualElement name="PcToolPanelBg" class="hud-pc-tool-panel-bg"/>
            <ui:VisualElement name="PcToolHeader" class="hud-pc-tool-header">
                <ui:Label name="PcToolTitle" text="" class="hud-pc-tool-title"/>
                <ui:VisualElement name="PcToolClose" class="hud-pc-tool-close"/>
            </ui:VisualElement>
            <ui:VisualElement name="PcToolTabs" class="hud-pc-tool-tabs"/>
            <ui:ScrollView name="PcToolList" class="hud-pc-tool-list"/>
        </ui:VisualElement>

        <!-- Trade Info Panel -->
        <ui:VisualElement name="TradeInfoPanel" class="hud-trade-panel hidden">
            <ui:VisualElement name="TradeInfoClose" class="hud-trade-close"/>
            <ui:Label name="TradeTitle" text="Thông tin Giao dịch" class="hud-trade-title"/>
            <ui:VisualElement name="TradeInfoRows" class="hud-trade-rows">
                <ui:Label name="TradePartnerName" text="     + Tên: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerLevel" text="     + Cấp: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerFaction" text="     + Phái: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerGuild" text="     + Bang: --" class="hud-trade-label"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Stall Currency Selector -->
        <ui:VisualElement name="StallCurrencySelector" class="hud-stall-currency hidden">
            <ui:Label text="Lựa chọn tiền tệ" class="hud-stall-currency-title"/>
            <ui:VisualElement name="StallCurrencyBtns" class="hud-stall-btns-row">
                <ui:Button name="StallMoneyBtn" text="Bạch Ngân" class="hud-stall-btn hud-stall-money-btn"/>
                <ui:Button name="StallCoinBtn" text="Đồng Xu" class="hud-stall-btn hud-stall-coin-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Emote Picker -->
        <ui:VisualElement name="FacePickerOverlay" class="hud-face-picker-overlay hidden">
            <ui:VisualElement name="FacePickerWindow" class="hud-face-picker-window">
                <ui:VisualElement name="FacePickerHeader" class="hud-face-picker-header">
                    <ui:Label text="Biểu cảm" class="hud-face-picker-title"/>
                    <ui:VisualElement name="FacePickerClose" class="hud-face-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="FacePickerList" class="hud-face-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Skill picker -->
        <ui:VisualElement name="SkillPickerOverlay" class="hud-skill-picker-overlay hidden">
            <ui:VisualElement name="SkillPickerWindow" class="hud-skill-picker-window">
                <ui:VisualElement name="SkillPickerHeader" class="hud-skill-picker-header">
                    <ui:Label name="SkillPickerTitle" text="Chọn kỹ năng" class="hud-skill-picker-title"/>
                    <ui:VisualElement name="SkillPickerClose" class="hud-skill-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="SkillPickerList" class="hud-skill-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ INVENTORY WINDOW (Hành Trang) — PC 道具界面 / UID 05ea8560 ═══ -->
        <!-- PC open: [Items] Player_Items (dc11ac12) / F4 → Open([[items]]). PC grid 6×10; mobile override 4×7. -->
        <ui:VisualElement name="InventoryWindow" class="hud-inv-overlay hidden">
            <ui:VisualElement name="InventoryFrame" class="hud-inv-frame">
                <ui:VisualElement name="InventoryHeader" class="hud-inv-header">
                    <ui:Label name="InventoryTitle" text="Hành Trang" class="hud-inv-title"/>
                    <ui:VisualElement name="InventoryClose" class="hud-inv-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="InventoryGridBackdrop" class="hud-inv-grid-backdrop"/>
                <ui:ScrollView name="InventoryGrid" class="hud-inv-grid"/>
                <ui:VisualElement name="InventoryFooter" class="hud-inv-footer">
                    <ui:Label name="InventoryMoney" text="Bạc: 0" class="hud-inv-money"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
