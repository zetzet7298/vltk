        <!-- ═══ PC-STYLE BOTTOM TOOLBAR MENU BUTTONS ═══ -->
        <!-- Hidden 2026-06-22: BtnRun/Sit/Horse/Exchange/PK overlay joystick (MobileJoystick) at
             bottom-left, blocking move input. Keep the legacy hidden child elements (UtilityToggleBtn,
             MobileUtilityDock, PcShortcutDock) untouched — they carry C# binding names.
             This outer wrapper is empty (the real PcMenuToolbar content is the inner tag below);
             closing it here keeps the UXML balanced so UIDocument can clone the visual tree. -->
        <ui:VisualElement name="PcMenuToolbar" class="hud-pc-menu-toolbar" style="position: absolute; left: 0px; bottom: 18px; width: 1280px; height: 56px; flex-direction: row; align-items: flex-start; justify-content: flex-start; display: none;"/>
        <!-- PC 工具控制条.ini: 11 buttons in a single 800x45 toolbar.
             Rendered LAST in the GameHud tree so it draws ON TOP of BottomPanel
             (bottom_bar_bg.png) and all other bottom elements. In UI Toolkit,
             later siblings paint above earlier ones.
             5 round 30x30 action buttons on the LEFT (Run/Sit/Horse/Exchange/PK),
             6 menu 40x40 buttons on the RIGHT (Status/Items/Skills/Team/Faction/WorldSort).
             Left/Top positions match the PC INI 1:1. The toolbar overlays the
             PC bottom strip (主界面新版.spr, 800x60) baked into bottom_bar_bg.png.
             CombatActionCluster stays hidden — Run/Sit/Horse/Exchange/PK live here. -->
        <ui:VisualElement name="PcMenuToolbar" class="hud-pc-menu-toolbar" style="position: absolute; left: 0px; bottom: 18px; width: 1280px; height: 56px; flex-direction: row; align-items: flex-start; justify-content: flex-start; display: none;">
            <!-- Round action cluster (left, 30x30). PC INI Left=9,40,75,110,145 Top=10. Scale 1.5x: 14,60,112,165,217 -->
            <!-- Round action cluster (left, 30x30). PC INI Left=9,40,75,110,145 Top=10. Scale 1.6x: 14,64,120,176,232 -->
            <ui:VisualElement name="BtnRun"      style="position: absolute; left: 14px; top: 4px; width: 44px; height: 44px; background-color: rgba(35, 50, 70, 0.5); border-width: 1px; border-color: rgba(140, 165, 145, 0.4); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; overflow: hidden; align-items: center; justify-content: center;"><ui:Label text="Chạy" style="color: rgb(255, 220, 100); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center;"/></ui:VisualElement>
            <ui:VisualElement name="BtnSit"      style="position: absolute; left: 64px; top: 4px; width: 44px; height: 44px; background-color: rgba(35, 50, 70, 0.5); border-width: 1px; border-color: rgba(140, 165, 145, 0.4); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; overflow: hidden;"><ui:VisualElement name="BtnSitIcon" style="width: 32px; height: 32px; position: absolute; left: 6px; top: 6px; background-image: url('project://database/Assets/UI/HUD/Art/btn_sit.png'); -unity-background-scale-mode: scale-to-fit;"/></ui:VisualElement>
            <ui:VisualElement name="BtnHorse"    style="position: absolute; left: 120px; top: 4px; width: 44px; height: 44px; background-color: rgba(35, 50, 70, 0.5); border-width: 1px; border-color: rgba(140, 165, 145, 0.4); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; overflow: hidden;"><ui:VisualElement name="BtnHorseIcon" style="width: 32px; height: 32px; position: absolute; left: 6px; top: 6px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_ride_up.png'); -unity-background-scale-mode: scale-to-fit;"/></ui:VisualElement>
            <ui:VisualElement name="BtnExchange" style="position: absolute; left: 176px; top: 4px; width: 44px; height: 44px; background-color: rgba(35, 50, 70, 0.5); border-width: 1px; border-color: rgba(140, 165, 145, 0.4); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; overflow: hidden;"><ui:VisualElement name="BtnExchangeIcon" style="width: 32px; height: 32px; position: absolute; left: 6px; top: 6px; background-image: url('project://database/Assets/UI/HUD/Art/vltkunity/Buttons/btn_change.png'); -unity-background-scale-mode: scale-to-fit;"/></ui:VisualElement>
