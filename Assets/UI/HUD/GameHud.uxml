<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="project://database/Assets/UI/HUD/GameHud.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/PopupWindow.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/CharacterInfo/CharacterInfo.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/Inventory/Inventory.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/Treasure/Treasure.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/Team/Team.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/Faction/Faction.uss" />
    <ui:Style src="project://database/Assets/UI/Popup/Skill/Skill.uss" />
    <ui:VisualElement name="GameHud" class="hud-root">
        <!-- Full-width PC top frame art background (main_hud_bg scaled 1280px) -->
        <ui:VisualElement name="TopFrameBg" class="hud-top-frame-bg"/>

        <!-- Top PC-style full status bar: ground-truth = ffb7d31b.ini / 8da7027d.ini (pak_unpacked/1024) -->
        <!-- PC 1024-space, Main.Left=120; mobile design 1280-wide => scale 1280/1024 = 1.25 -->
        <!-- Absolute left = (Main.Left + bar.Left) x 1.25: Level=194, Stamina=223, Life=360, Mana=498, Exp=635, WorldSort=803 -->
        <ui:VisualElement name="TopLeftPanel" class="hud-top-status">
            <ui:VisualElement name="PcBarPanelBg" class="hud-pc-bar-panel-bg"/>
            <ui:Label name="LevelText" text="1" class="hud-level-box"/>
            <ui:VisualElement name="StaminaBarTrack" class="hud-top-bar hud-stamina-track"><ui:VisualElement name="StaminaBarFill" class="hud-top-fill"/></ui:VisualElement>
            <ui:VisualElement name="HpBarTrack" class="hud-top-bar hud-hp-track"><ui:VisualElement name="HpBarFill" class="hud-top-fill"/></ui:VisualElement>
            <ui:VisualElement name="MpBarTrack" class="hud-top-bar hud-mp-track"><ui:VisualElement name="MpBarFill" class="hud-top-fill"/></ui:VisualElement>
            <ui:VisualElement name="ExpBarTrack" class="hud-top-bar hud-exp-track"><ui:VisualElement name="ExpBarFill" class="hud-top-fill"/></ui:VisualElement>
            <!-- WorldSort (Hạng thế giới): PC Player_WorldSort, chữ xanh 55,231,63, nằm sau EXP -->
            <ui:Label name="WorldSortText" text="0" class="hud-worldsort-box"/>
            <ui:Label text="Cấp" class="hud-vn-top-caption hud-vn-level-caption"/>
            <ui:Label text="Thể lực" class="hud-vn-top-caption hud-vn-stamina-caption"/>
            <ui:Label text="Sinh lực" class="hud-vn-top-caption hud-vn-hp-caption"/>
            <ui:Label text="Nội lực" class="hud-vn-top-caption hud-vn-mp-caption"/>
            <ui:Label text="Kinh nghiệm" class="hud-vn-top-caption hud-vn-exp-caption"/>
            <ui:Label name="StaminaText" text="100/100" class="hud-top-small-text hud-stamina-text"/>
            <ui:Label name="HpText" text="100/100" class="hud-top-small-text hud-hp-text"/>
            <ui:Label name="MpText" text="50/50" class="hud-top-small-text hud-mp-text"/>
            <ui:Label name="ExpText" text="0%" class="hud-top-small-text hud-exp-text"/>
        </ui:VisualElement>

        <!-- Optional minimap kept compact for sandbox/debug -->
        <ui:VisualElement name="MinimapPanel" class="hud-minimap-panel">
            <ui:VisualElement name="MinimapFrame" class="hud-minimap-frame">
                <ui:VisualElement name="MinimapContent" class="hud-minimap-content">
                    <ui:VisualElement name="MiniMapTarget" class="hud-map-target-dot"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerDot" class="hud-player-dot"/>
            </ui:VisualElement>
            <ui:Label name="SceneName" text="" class="hud-scene-name"/>
            <ui:Label name="ScenePos" text="" class="hud-scene-pos"/>
            <ui:VisualElement name="MinimapBtns" class="hud-minimap-btns">
                <ui:VisualElement name="ToggleMapBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="CaveMapBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="WorldMapBtn" class="hud-minimap-btn"/>
                <ui:VisualElement name="FlagMapBtn" class="hud-minimap-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Mobile PC-style map preview. Open by tapping minimap; tap preview to move. -->
        <ui:VisualElement name="MapPreviewOverlay" class="hud-map-preview-overlay hidden">
            <ui:VisualElement name="MapPreviewWindow" class="hud-map-preview-window">
                <ui:VisualElement name="MapPreviewHeader" class="hud-map-preview-header">
                    <ui:Label name="MapPreviewTitle" text="Bản đồ" class="hud-map-preview-title"/>
                    <ui:VisualElement name="MapPreviewClose" class="hud-map-preview-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="MapPreviewFrame" class="hud-map-preview-frame">
                    <ui:VisualElement name="MapPreviewContent" class="hud-map-preview-content">
                        <ui:VisualElement name="MapPreviewTarget" class="hud-map-target-dot"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MapPreviewPlayerDot" class="hud-player-dot hud-preview-player-dot"/>
                </ui:VisualElement>
                <ui:Label name="MapPreviewCoords" text="" class="hud-map-preview-coords"/>
                <ui:Label text="Chạm bản đồ để di chuyển" class="hud-map-preview-help"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Chat message area + input -->
        <ui:VisualElement name="ChatBar" class="hud-chat-panel">
            <ui:Label text="!! Hãy sử dụng hồi phục" class="hud-chat-warning"/>
            <ui:VisualElement class="hud-chat-input-row">
                <ui:TextField name="ChatInput" value="" class="hud-chat-input"/>
                <ui:Button name="FaceBtn" text="😊" class="hud-face-btn"/>
                <ui:VisualElement name="SendBtnIcon" class="hud-send-icon"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===================================================================
             HUD-004 (mobile-native-hud-layout) — Slice S1: mobile-native layout
             The PC 快捷栏 replica bottom-center strip has been REMOVED from the
             center lane. Bottom-center is now RESERVED for the future mobile chat
             canvas. The former strip elements (9 hotbar slots, T/P skill slots,
             toggle row, menu row, BtnTreasure) are parked in PendingRelocation
             (display:none) so their click-wiring + icon names still resolve via
             root.Q(...) until S2 (combat cluster) and S3 (menu relocation) repopulate
             them into the new anchored clusters below.
             =================================================================== -->

        <!-- BOTTOM-CENTER LANE: RESERVED for the future mobile chat canvas.
             ChatBar is the only bottom-center content. Do NOT place combat slots,
             quick slots, action buttons, or menu buttons here. -->

            <!-- S2 (HUD-004): right-thumb combat cluster — 1 main + 5 sub assignable slots
                 + run/horse/sit action buttons. Anchored bottom-right. Fan layout per
                 design.md: 2 sub slots upper arc, main slot center, 3 sub slots lower arc,
                 action buttons below. Slot element NAMES (SkillSlot0-4, PrimaryAttackBtn)
                 match what CombatSkillSlotController.BindElements() queries so the existing
                 controller binds/casts automatically — no new gameplay wiring needed.
                 PC sprite frames: btn_skill_empty_pc.png (42×42 PC SPR, scale-to-fit).
                 Skill icons: Generated/cai_bang_skill_*.png (resolved by controller). -->
            <ui:VisualElement name="CombatCluster" class="hud-combat-cluster">
                <!-- Upper arc: 2 sub slots (above-right of main) -->
                <ui:VisualElement name="SkillSlot4" class="hud-combat-sub-slot hud-combat-pos-sub5">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="5" class="hud-skill-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="SkillSlot3" class="hud-combat-sub-slot hud-combat-pos-sub4">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="4" class="hud-skill-slot-label"/>
                </ui:VisualElement>

                <!-- Main slot (player-chosen priority, visually larger for thumb rest).
                     Name PrimaryAttackBtn matches CombatSkillSlotController's primary attack
                     pseudo-slot binding. Frame: btn_skill_empty_pc.png. -->
                <ui:VisualElement name="PrimaryAttackBtn" class="hud-combat-main-slot">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon hud-combat-main-icon"/>
                    <ui:Label name="SlotLabel" text="Tấn công" class="hud-skill-slot-label"/>
                </ui:VisualElement>

                <!-- Lower arc: 3 sub slots (below main) -->
                <ui:VisualElement name="SkillSlot0" class="hud-combat-sub-slot hud-combat-pos-sub1">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="1" class="hud-skill-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="SkillSlot1" class="hud-combat-sub-slot hud-combat-pos-sub2">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="2" class="hud-skill-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="SkillSlot2" class="hud-combat-sub-slot hud-combat-pos-sub3">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="3" class="hud-skill-slot-label"/>
                </ui:VisualElement>

                <!-- Action buttons (right-thumb reach): run / horse / sit.
                     Fresh names (ActionBtnRun etc.) to avoid collision with parked
                     BtnRun/BtnSit/BtnHorse in PendingRelocation. Icons loaded via
                     ButtonIcons dict + LoadArt(). RegisterClick wires to existing
                     OnRunClick/OnSitClick/OnHorseClick (no-op log stubs, no new gameplay). -->
                <ui:VisualElement name="ActionBtnRun" class="hud-action-btn hud-combat-pos-run">
                    <ui:VisualElement name="ActionBtnRunIcon" class="hud-btn-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="ActionBtnHorse" class="hud-action-btn hud-combat-pos-horse">
                    <ui:VisualElement name="ActionBtnHorseIcon" class="hud-btn-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="ActionBtnSit" class="hud-action-btn hud-combat-pos-sit">
                    <ui:VisualElement name="ActionBtnSitIcon" class="hud-btn-icon"/>
                </ui:VisualElement>
            </ui:VisualElement>

        <!-- S3 target: usable-item quick slots (3) ascending the right side toward
             the minimap (Ngũ Hoa Ngọc Lộ etc). Empty shell for S1; populated in S3. -->
            <!-- S3 (HUD-004): 3 usable-item quick slots ascending the right side (qs1
                 lowest → qs3 highest via column-reverse). Frame chrome = PC numbered-well
                 sprites btn_quick_item_1/2/3_pc.png (快捷栏 slot-well family, 36×36 RGBA).
                 Each slot assignable to a consumable (e.g. Ngũ Hoa Ngọc Lộ). Activation =
                 consume intent (no-op log; backend effect is a follow-up gameplay change). -->
            <ui:VisualElement name="QuickSlots" class="hud-quick-slots">
                <ui:VisualElement name="QuickSlot1" class="hud-quick-slot hud-quick-slot-1">
                    <ui:VisualElement name="QuickSlot1Icon" class="hud-quick-slot-icon empty"/>
                </ui:VisualElement>
                <ui:VisualElement name="QuickSlot2" class="hud-quick-slot hud-quick-slot-2">
                    <ui:VisualElement name="QuickSlot2Icon" class="hud-quick-slot-icon empty"/>
                </ui:VisualElement>
                <ui:VisualElement name="QuickSlot3" class="hud-quick-slot hud-quick-slot-3">
                    <ui:VisualElement name="QuickSlot3Icon" class="hud-quick-slot-icon empty"/>
                </ui:VisualElement>
            </ui:VisualElement>

        <!-- S3 target: relocated overflow PC UI (8 menu buttons + buff + Bảo Vật)
             into the minimap↔topbar gap. Empty shell for S1; populated in S3. -->
            <!-- S3 (HUD-004): relocated overflow PC UI — 8 menu buttons (PC F-key icons)
                 + BtnTreasure (Bảo Vật) as a compact horizontal row in the minimap↔topbar gap.
                 BuffPanel renders below when buffs exist. Click handlers unchanged
                 (RegisterClick names preserved so popups still fire via PopupManager). -->
            <ui:VisualElement name="TopGapCluster" class="hud-top-gap-cluster">
                <ui:VisualElement name="TopGapMenuRow" class="hud-top-gap-menu-row">
                    <ui:VisualElement name="BtnStatus" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnStatusIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnItems" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnItemsIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnItemEx" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnItemExIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnSkills" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnSkillsIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnQuest" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnQuestIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnTeam" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnTeamIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnFaction" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnFactionIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnChatRoom" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnChatRoomIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnTreasure" class="hud-top-gap-menu-btn"><ui:VisualElement name="BtnTreasureIcon" class="hud-btn-icon"/></ui:VisualElement>
                </ui:VisualElement>
                <!-- Buff / Debuff panel: PC MiniSkill.ini / SkillState.ini. Hidden baseline;
                     runtime re-enables when buffs exist. Relocated from old top-level position. -->
                <ui:VisualElement name="BuffPanel" class="hud-buff-panel hidden">
                    <!-- Dynamically populated in C# -->
                </ui:VisualElement>
            </ui:VisualElement>

        <!-- PendingRelocation: parked PC 快捷栏 replica elements (display:none).
             Names preserved so root.Q("BtnRun"), RegisterClick, and LoadArt icon
             wiring still resolve. S2/S3 move these out into the clusters above. -->
        <ui:VisualElement name="PendingRelocation" class="hud-pending-relocation">
            <ui:VisualElement name="HotbarCenter" class="hud-main-hotbar">
                <ui:VisualElement name="ItemSlot0" class="hud-hotbar-slot"><ui:Label text="1" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot1" class="hud-hotbar-slot"><ui:Label text="2" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot2" class="hud-hotbar-slot"><ui:Label text="3" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot3" class="hud-hotbar-slot"><ui:Label text="4" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot4" class="hud-hotbar-slot"><ui:Label text="5" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot5" class="hud-hotbar-slot"><ui:Label text="6" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot6" class="hud-hotbar-slot"><ui:Label text="7" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot7" class="hud-hotbar-slot"><ui:Label text="8" class="hud-slot-number"/></ui:VisualElement>
                <ui:VisualElement name="ItemSlot8" class="hud-hotbar-slot"><ui:Label text="9" class="hud-slot-number"/></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="hud-skill-panel">
                <ui:VisualElement name="LeftSkillSlot" class="hud-skill-slot">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="+" class="hud-skill-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="RightSkillSlot" class="hud-skill-slot">
                    <ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/>
                    <ui:Label name="SlotLabel" text="+" class="hud-skill-slot-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="hud-skill-keys"><ui:Label text="T"/><ui:Label text="P"/></ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="ToolbarRight" class="hud-right-cluster">
                <ui:VisualElement class="hud-toggle-row">
                    <ui:VisualElement name="BtnSit" class="hud-round-btn"><ui:VisualElement name="BtnSitIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnRun" class="hud-round-btn"><ui:VisualElement name="BtnRunIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnHorse" class="hud-round-btn"><ui:VisualElement name="BtnHorseIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnExchange" class="hud-round-btn"><ui:VisualElement name="BtnExchangeIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnRec" class="hud-round-btn"><ui:VisualElement name="BtnRecIcon" class="hud-btn-icon"/></ui:VisualElement>
                    <ui:VisualElement name="BtnPK" class="hud-round-btn"><ui:VisualElement name="BtnPKIcon" class="hud-btn-icon"/></ui:VisualElement>
                </ui:VisualElement>
                <!-- S3 (HUD-004): 8 menu buttons (BtnStatus…BtnChatRoom) + BtnTreasure
                     relocated to TopGapCluster above. Only the toggle-row (Sit/Run/Horse/
                     Exchange/Rec/PK) remains parked here for the S2 ActionBtn* to reuse. -->
            </ui:VisualElement>
            <!-- BuffPanel moved into TopGapCluster above by S3 (HUD-004). The C# code
                 resolves it via root.Q("BuffPanel") which searches the whole tree. -->
        </ui:VisualElement>

        <!-- Trade Info Panel: PC TradeInfo.ini -->
        <ui:VisualElement name="TradeInfoPanel" class="hud-trade-panel hidden">
            <ui:VisualElement name="TradeInfoClose" class="hud-trade-close"/>
            <ui:Label name="TradeTitle" text="Thông tin Giao dịch" class="hud-trade-title"/>
            <ui:VisualElement name="TradeInfoRows" class="hud-trade-rows">
                <ui:Label name="TradePartnerName" text="     + Tên: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerLevel" text="     + Cấp: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerFaction" text="     + Phái: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerGuild" text="     + Bang: --" class="hud-trade-label"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Stall Currency Selector: PC UiStallCurrency.ini -->
        <ui:VisualElement name="StallCurrencySelector" class="hud-stall-currency hidden">
            <ui:Label text="Lựa chọn tiền tệ" class="hud-stall-currency-title"/>
            <ui:VisualElement name="StallCurrencyBtns" class="hud-stall-btns-row">
                <ui:Button name="StallMoneyBtn" text="Bạch Ngân" class="hud-stall-btn hud-stall-money-btn"/>
                <ui:Button name="StallCoinBtn" text="Đồng Xu" class="hud-stall-btn hud-stall-coin-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Emote Picker Overlay: opened by tapping face button -->
        <ui:VisualElement name="FacePickerOverlay" class="hud-face-picker-overlay hidden">
            <ui:VisualElement name="FacePickerWindow" class="hud-face-picker-window">
                <ui:VisualElement name="FacePickerHeader" class="hud-face-picker-header">
                    <ui:Label text="Biểu cảm" class="hud-face-picker-title"/>
                    <ui:VisualElement name="FacePickerClose" class="hud-face-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="FacePickerList" class="hud-face-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Skill picker overlay: tap skill slot to assign → shows list of learned skills -->
        <ui:VisualElement name="SkillPickerOverlay" class="hud-skill-picker-overlay hidden">
            <ui:VisualElement name="SkillPickerWindow" class="hud-skill-picker-window">
                <ui:VisualElement name="SkillPickerHeader" class="hud-skill-picker-header">
                    <ui:Label name="SkillPickerTitle" text="Chọn kỹ năng" class="hud-skill-picker-title"/>
                    <ui:VisualElement name="SkillPickerClose" class="hud-skill-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="SkillPickerList" class="hud-skill-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HUD-003 Popup overlay host: PopupManager mounts backdrop + window here. -->
        <ui:VisualElement name="PopupOverlay" class="hud-popup-overlay" />
    </ui:VisualElement>
</ui:UXML>
