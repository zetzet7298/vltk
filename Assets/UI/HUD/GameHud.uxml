        <!-- PC quick item/left-right skill buttons: 1..9 -> ShortcutUseItem, T/P -> mobile skill assignment.
             Mobile: hidden — quick-item access is merged into the Hành trang tab of the categorized dock.
             Kept in UXML for binding/test compatibility. -->
        <ui:VisualElement name="PcShortcutToggleBtn" class="hud-pc-shortcut-toggle-btn" style="display: none;"><ui:Label name="PcShortcutToggleLabel" text="1-9" class="hud-pc-shortcut-toggle-label"/></ui:VisualElement>
        <ui:VisualElement name="PcShortcutDock" class="hud-pc-shortcut-dock hidden" style="display: none;">
            <ui:VisualElement name="PcLeftSkillBtn" class="hud-pc-skill-btn"/>
            <ui:VisualElement name="PcRightSkillBtn" class="hud-pc-skill-btn"/>
            <ui:VisualElement name="PcShortcutGrid" class="hud-pc-shortcut-grid">
                <ui:VisualElement name="PcItemSlot0" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-1"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot1" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-2"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot2" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-3"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot3" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-4"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot4" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-5"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot5" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-6"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot6" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-7"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot7" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-8"/></ui:VisualElement>
                <ui:VisualElement name="PcItemSlot8" class="hud-pc-item-slot"><ui:VisualElement class="hud-pc-item-slot-icon slot-9"/></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BottomPanel" class="hud-mobile-bottom" style="position: absolute; left: 0px; right: 0px; bottom: 0px; width: 1280px; height: 90px; background-color: rgba(0, 0, 0, 0); border-width: 0px; display: none;">
            <ui:VisualElement name="CombatActionCluster" class="hud-combat-action-cluster" style="display: none;">
                <ui:VisualElement name="PrimaryAttackBtn" class="hud-primary-attack-btn"><ui:VisualElement name="PrimaryAttackBtnIcon" class="hud-primary-attack-icon"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot0" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-main"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="1" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot1" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-left"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="2" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot2" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-top"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="3" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot3" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-upper"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="4" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="SkillSlot4" class="hud-skill-slot hud-mobile-skill-slot hud-skill-slot-extra"><ui:VisualElement name="SlotIcon" class="hud-skill-slot-icon"/><ui:Label name="SlotLabel" text="5" class="hud-skill-slot-label"/></ui:VisualElement>
                <ui:VisualElement name="BtnRunCombat" class="hud-combat-run-btn"><ui:VisualElement name="BtnRunCombatIcon" class="hud-combat-run-icon"/></ui:VisualElement>
                <!-- Combat-critical quick actions (PK/farm): mount + sit arc beside skill slots for thumb reach. -->
                <ui:VisualElement name="BtnMountQuick" class="hud-combat-quick-btn hud-combat-mount-btn"><ui:VisualElement name="BtnMountQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnSitQuick" class="hud-combat-quick-btn hud-combat-sit-btn"><ui:VisualElement name="BtnSitQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="BtnPKQuick" class="hud-combat-quick-btn hud-combat-pk-btn"><ui:VisualElement name="BtnPKQuickIcon" class="hud-combat-quick-icon"/></ui:VisualElement>
                <ui:VisualElement name="DeckSwitchBtn" class="hud-deck-switch-btn"><ui:Label name="DeckSwitchLabel" text="A" class="hud-deck-switch-label"/></ui:VisualElement>
                <ui:VisualElement name="CancelCastZone" class="hud-cancel-cast-zone hidden"><ui:Label text="Hủy" class="hud-cancel-cast-label"/></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Buff / Debuff panel -->
        <ui:VisualElement name="BuffPanel" class="hud-buff-panel">
        </ui:VisualElement>

        <!-- Team Preview -->
        <ui:VisualElement name="TeamPreview" class="hud-team-preview hidden">
        </ui:VisualElement>

        <!-- PC HUD tool panel: opened by Status/ItemEx/Task/Friend/Faction/ChatRoom/Options/Rec.
             Background element loaded with per-panel PC SPR (skill/items/guild/team/system bg) by title.
             Tab strip below header holds per-page PC tab buttons (common_tab.spr) for panels
             that have sub-pages (e.g. Character: 属性/装备/经脉/江湖评价). -->
        <ui:VisualElement name="PcToolPanel" class="hud-pc-tool-panel hidden">
            <ui:VisualElement name="PcToolPanelBg" class="hud-pc-tool-panel-bg"/>
            <ui:VisualElement name="PcToolHeader" class="hud-pc-tool-header">
                <ui:Label name="PcToolTitle" text="" class="hud-pc-tool-title"/>
                <ui:VisualElement name="PcToolClose" class="hud-pc-tool-close"/>
            </ui:VisualElement>
            <ui:VisualElement name="PcToolTabs" class="hud-pc-tool-tabs"/>
            <ui:ScrollView name="PcToolList" class="hud-pc-tool-list"/>
        </ui:VisualElement>

        <!-- Trade Info Panel -->
        <ui:VisualElement name="TradeInfoPanel" class="hud-trade-panel hidden">
            <ui:VisualElement name="TradeInfoClose" class="hud-trade-close"/>
            <ui:Label name="TradeTitle" text="Thông tin Giao dịch" class="hud-trade-title"/>
            <ui:VisualElement name="TradeInfoRows" class="hud-trade-rows">
                <ui:Label name="TradePartnerName" text="     + Tên: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerLevel" text="     + Cấp: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerFaction" text="     + Phái: --" class="hud-trade-label"/>
                <ui:Label name="TradePartnerGuild" text="     + Bang: --" class="hud-trade-label"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Stall Currency Selector -->
        <ui:VisualElement name="StallCurrencySelector" class="hud-stall-currency hidden">
            <ui:Label text="Lựa chọn tiền tệ" class="hud-stall-currency-title"/>
            <ui:VisualElement name="StallCurrencyBtns" class="hud-stall-btns-row">
                <ui:Button name="StallMoneyBtn" text="Bạch Ngân" class="hud-stall-btn hud-stall-money-btn"/>
                <ui:Button name="StallCoinBtn" text="Đồng Xu" class="hud-stall-btn hud-stall-coin-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Emote Picker -->
        <ui:VisualElement name="FacePickerOverlay" class="hud-face-picker-overlay hidden">
            <ui:VisualElement name="FacePickerWindow" class="hud-face-picker-window">
                <ui:VisualElement name="FacePickerHeader" class="hud-face-picker-header">
                    <ui:Label text="Biểu cảm" class="hud-face-picker-title"/>
                    <ui:VisualElement name="FacePickerClose" class="hud-face-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="FacePickerList" class="hud-face-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Skill picker -->
        <ui:VisualElement name="SkillPickerOverlay" class="hud-skill-picker-overlay hidden">
            <ui:VisualElement name="SkillPickerWindow" class="hud-skill-picker-window">
                <ui:VisualElement name="SkillPickerHeader" class="hud-skill-picker-header">
                    <ui:Label name="SkillPickerTitle" text="Chọn kỹ năng" class="hud-skill-picker-title"/>
                    <ui:VisualElement name="SkillPickerClose" class="hud-skill-picker-close"/>
                </ui:VisualElement>
                <ui:ScrollView name="SkillPickerList" class="hud-skill-picker-list"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ INVENTORY WINDOW (Hành Trang) — PC 道具界面 / UID 05ea8560 ═══ -->
        <!-- PC open: [Items] Player_Items (dc11ac12) / F4 → Open([[items]]). PC grid 6×10; mobile override 4×7. -->
        <ui:VisualElement name="InventoryWindow" class="hud-inv-overlay hidden">
            <ui:VisualElement name="InventoryFrame" class="hud-inv-frame">
                <ui:VisualElement name="InventoryHeader" class="hud-inv-header">
                    <ui:Label name="InventoryTitle" text="Hành Trang" class="hud-inv-title"/>
                    <ui:VisualElement name="InventoryClose" class="hud-inv-close"/>
                </ui:VisualElement>
                <ui:VisualElement name="InventoryGridBackdrop" class="hud-inv-grid-backdrop"/>
                <ui:ScrollView name="InventoryGrid" class="hud-inv-grid"/>
                <ui:VisualElement name="InventoryFooter" class="hud-inv-footer">
                    <ui:Label name="InventoryMoney" text="Bạc: 0" class="hud-inv-money"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Vltkunity Parity Bag Panel (Rương đồ) -->
        <ui:VisualElement name="VltkBagPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 300px; top: 100px; width: 400px; height: 350px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                <ui:Label text="Hành Trang" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                <ui:VisualElement name="VltkBagCloseBtn" class="hud-vltk-close-btn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 10px;">
                <ui:Button name="VltkBagTabBagBtn" text="Hành trang" style="margin-right: 5px;"/>
                <ui:Button name="VltkBagTabStorageBtn" text="Thương khố"/>
            </ui:VisualElement>
            <ui:ScrollView name="VltkBagGrid" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;" />
            <ui:ScrollView name="VltkStorageGrid" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; display: none;" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 5px; border-top-width: 1px; border-top-color: rgb(80, 80, 80); padding-top: 5px;">
                <ui:Label name="VltkBagCount" text="0/0" style="color: white;"/>
                <ui:Label name="VltkStorageCount" text="0/0" style="color: white; display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Vltkunity Parity Chat Panel -->
        <ui:VisualElement name="VltkChatPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 10px; bottom: 100px; width: 450px; height: 220px; background-color: rgba(10, 15, 20, 0.9); border-width: 1px; border-color: rgb(100, 100, 100); border-radius: 4px; padding: 6px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 4px;">
                <ui:VisualElement name="VltkChatCategoryStrip" style="flex-direction: row; flex-grow: 1;"/>
                <ui:VisualElement style="flex-direction: row;">
                    <ui:VisualElement name="VltkChatResizeBtn" style="width: 20px; height: 20px; background-color: rgb(60, 60, 60); margin-right: 4px; border-radius: 2px; align-items: center; justify-content: center;"><ui:Label text="↕" style="color: white;"/></ui:VisualElement>
                    <ui:VisualElement name="VltkChatCloseBtn" style="width: 20px; height: 20px; background-color: rgb(180, 50, 50); border-radius: 2px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white;"/></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="VltkChatMessageList" style="flex-grow: 1; background-color: rgba(0,0,0,0.3); margin-bottom: 4px; padding: 4px;"/>
            <ui:VisualElement style="flex-direction: row; height: 28px; align-items: center;">
                <ui:Label name="VltkChatInputPlaceholder" text="Chạm để nhập..." style="flex-grow: 1; background-color: rgb(30, 30, 30); color: gray; padding-left: 5px; height: 100%; -unity-text-align: middle-left;"/>
                <ui:Button name="VltkChatSendBtn" text="Gửi" style="width: 50px; height: 100%; margin-left: 4px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Vltkunity Parity Equipment/Character Panel -->
        <ui:VisualElement name="VltkEquipPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 250px; top: 80px; width: 450px; height: 380px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                <ui:Label text="Nhân Vật" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                <ui:VisualElement name="VltkEquipCloseBtn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 8px;">
                <ui:Button name="VltkEquipTabPropertiesBtn" text="Thuộc tính" style="margin-right: 4px;"/>
                <ui:Button name="VltkEquipTabEquipmentBtn" text="Trang bị" style="margin-right: 4px;"/>
                <ui:Button name="VltkEquipTabItemsBtn" text="Vật phẩm" style="margin-right: 4px;"/>
                <ui:Button name="VltkEquipTabSeriesBtn" text="Ngũ hành"/>
            </ui:VisualElement>
            
            <!-- Properties Tab -->
            <ui:VisualElement name="VltkEquipPropertiesTab" style="flex-grow: 1;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                    <ui:Label name="VltkEquipPlayerName" text="Tên: " style="color: white; -unity-font-style: bold;"/>
                    <ui:Label name="VltkEquipLevel" text="Cấp: " style="color: white;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 6px;">
                    <ui:Label name="VltkEquipHp" text="Sinh Lực: " style="color: rgb(255, 100, 100);"/>
                    <ui:Label name="VltkEquipMp" text="Nội Lực: " style="color: rgb(100, 150, 255);"/>
                    <ui:Label name="VltkEquipStamina" text="Thể Lực: " style="color: rgb(100, 255, 100);"/>
                </ui:VisualElement>
                <ui:Label name="VltkEquipExp" text="Kinh nghiệm: " style="color: white; margin-bottom: 8px;"/>
                
                <!-- Attribute Allocation -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-around; margin-bottom: 8px; padding: 4px; background-color: rgba(0,0,0,0.2);">
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="Sức mạnh"/>
                        <ui:Button name="VltkEquipStrengthAddBtn" text="+"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="Sinh khí"/>
                        <ui:Button name="VltkEquipVitalityAddBtn" text="+"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="Thân pháp"/>
                        <ui:Button name="VltkEquipDexterityAddBtn" text="+"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="Nội công"/>
                        <ui:Button name="VltkEquipEnergyAddBtn" text="+"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:ScrollView name="VltkEquipStatsList" style="flex-grow: 1; background-color: rgba(0,0,0,0.1);"/>
            </ui:VisualElement>

            <!-- Other tabs are programmatically toggled visible/none by adapter -->
            <ui:VisualElement name="VltkEquipEquipmentTab" style="flex-grow: 1; display: none;"><ui:Label text="Trang bị" style="color: white;"/></ui:VisualElement>
            <ui:VisualElement name="VltkEquipItemsTab" style="flex-grow: 1; display: none;"><ui:Label text="Vật phẩm nhiệm vụ / Khác" style="color: white;"/></ui:VisualElement>
            <ui:VisualElement name="VltkEquipSeriesTab" style="flex-grow: 1; display: none;"><ui:Label text="Thông tin ngũ hành khắc kị" style="color: white;"/></ui:VisualElement>
        </ui:VisualElement>

        <!-- Vltkunity Parity Skill Panel -->
        <ui:VisualElement name="VltkSkillPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 280px; top: 90px; width: 460px; height: 360px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 1; width: 240px; margin-right: 10px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                    <ui:Label text="Võ Công" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                </ui:VisualElement>
                <ui:ScrollView name="VltkSkillList" style="flex-grow: 1;"/>
                <ui:Button name="VltkSkillPageSwitchBtn" text="Chuyển trang" style="margin-top: 5px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="width: 180px; border-left-width: 1px; border-left-color: rgb(80, 80, 80); padding-left: 10px;">
                <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-bottom: 10px;">
                    <ui:VisualElement name="VltkSkillCloseBtn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="VltkSkillDetail" style="flex-grow: 1;">
                    <ui:Label name="VltkSkillDetailName" text="Tên chiêu" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 14px; margin-bottom: 4px;"/>
                    <ui:Label name="VltkSkillDetailLevel" text="Cấp: 0" style="color: white; font-size: 12px; margin-bottom: 8px;"/>
                    <ui:Label name="VltkSkillDetailDesc" text="Mô tả..." style="color: rgb(200, 200, 200); font-size: 11px; white-space: normal; flex-grow: 1;"/>
                    <ui:Button name="VltkSkillUpgradeBtn" text="Tăng cấp" style="height: 30px; margin-top: 5px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Vltkunity Parity lightweight reusable panels (NpcDialog, Faction, Guild, Mail, Shop, Login) -->
        <ui:VisualElement name="VltkNpcPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 340px; top: 120px; width: 360px; height: 260px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                <ui:Label name="VltkNpcTitle" text="Đối thoại" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                <ui:VisualElement name="VltkNpcCloseBtn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="VltkNpcContent" text="..." style="color: white; font-size: 13px; white-space: normal; margin-bottom: 10px; flex-grow: 1;"/>
            <ui:ScrollView name="VltkNpcActionList" style="height: 100px;"/>
        </ui:VisualElement>

        <ui:VisualElement name="VltkFactionPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 340px; top: 120px; width: 360px; height: 260px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                <ui:Label name="VltkFactionTitle" text="Môn Phái" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                <ui:VisualElement name="VltkFactionCloseBtn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="VltkFactionContent" text="..." style="color: white; font-size: 13px; white-space: normal; margin-bottom: 10px; flex-grow: 1;"/>
            <ui:ScrollView name="VltkFactionActionList" style="height: 100px;"/>
        </ui:VisualElement>

        <ui:VisualElement name="VltkGuildPanel" class="hud-vltk-panel hidden" style="position: absolute; left: 300px; top: 100px; width: 420px; height: 320px; background-color: rgba(15, 20, 25, 0.95); border-width: 2px; border-color: rgb(150, 130, 90); border-radius: 8px; padding: 10px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); padding-bottom: 5px; margin-bottom: 10px;">
                <ui:Label name="VltkGuildTitle" text="Bang Hội" style="color: rgb(245, 255, 105); -unity-font-style: bold; font-size: 16px;"/>
                <ui:VisualElement name="VltkGuildCloseBtn" style="width: 24px; height: 24px; background-color: rgb(180, 50, 50); border-radius: 4px; align-items: center; justify-content: center;"><ui:Label text="X" style="color: white; -unity-font-style: bold;"/></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="VltkGuildContent" text="..." style="color: white; font-size: 13px; white-space: normal; margin-bottom: 10px; flex-grow: 1;"/>
