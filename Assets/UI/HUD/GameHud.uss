/* VLTK Mobile HUD — PC-accurate layout from 顶部控制条.ini + 玩家信息主界面.ini + 工具控制条.ini */

.hud-root {
    width: 1280px;
    height: 720px;
    overflow: hidden;
}

/* ═══ HIDDEN DATA BINDING LABELS ═══ */
.hud-hidden-data { display: none; }

/* ═══ TOP STATUS BAR ═══ */
/* PC 800 Main: Left=120, Top=0, Width=552, Height=17 (uid 8da7027d / 973816f3). */
.hud-top-bar-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 40px;
    background-color: transparent;
}

.hud-pc-bar-panel-bg {
    position: absolute;
    left: 120px;
    top: 0px;
    width: 552px;
    height: 17px;
    background-image: url('project://database/Assets/UI/HUD/Art/top_status_strip.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
}

.hud-level-label {
    position: absolute;
    left: 155px;
    top: 2px;
    width: 20px;
    height: 12px;
    font-size: 11px;
    color: rgba(0,0,0,0);
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
    overflow: hidden;
}

.hud-rank-label {
    position: absolute;
    left: 642px;
    top: 2px;
    width: 28px;
    height: 12px;
    font-size: 10px;
    color: rgba(0,0,0,0);
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
    overflow: hidden;
}

/* Bar tracks: PC 800 INI Top=3, W=104, image H=9. */
.hud-bar-track {
    position: absolute;
    top: 3px;
    width: 104px;
    height: 9px;
    background-color: transparent;
    border-width: 0px;
    overflow: hidden;
}

.hud-stamina-track { left: 178px; }
.hud-hp-track      { left: 288px; }
.hud-mp-track      { left: 398px; }
.hud-exp-track     { left: 508px; }

.hud-bar-fill {
    width: 100%;
    height: 11px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-hp-track .hud-bar-fill      { background-image: url('project://database/Assets/UI/HUD/Art/bar_hp_fill.png'); }
.hud-mp-track .hud-bar-fill      { background-image: url('project://database/Assets/UI/HUD/Art/bar_mp_fill.png'); }
.hud-stamina-track .hud-bar-fill { background-image: url('project://database/Assets/UI/HUD/Art/bar_stamina_fill.png'); }
.hud-exp-track .hud-bar-fill     { background-image: url('project://database/Assets/UI/HUD/Art/bar_exp_fill.png'); }



/* PC 主界面玩家信息窗口.ini [DateTime]: network/smooth status text.
   PC shows "Hoạt động tốt" or similar in green at top-left. */
.hud-pc-connection-status {
    position: absolute;
    left: 8px;
    top: 2px;
    width: 130px;
    height: 13px;
    color: rgb(60,255,160);
    font-size: 11px;
    -unity-text-align: middle-left;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

/* ═══ MINIMAP — PC 小地图_小.ini style ═══ */
/* PC minimap has a dark frame with subtle border, map name in yellow, coords in green. */
.hud-minimap-panel {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 136px;
    height: 166px;
    align-items: center;
}

.hud-minimap-frame {
    width: 130px;
    height: 130px;
    border-width: 0px;
    border-color: rgb(60,80,60);
    border-radius: 0px;
    background-color: rgba(2,8,4,0.92);
    overflow: hidden;
}

.hud-minimap-content {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 128px;
    height: 128px;
    background-color: rgba(15,25,15,0.90);
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-player-dot {
    position: absolute;
    left: 60px;
    top: 60px;
    width: 10px;
    height: 10px;
    background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-map-target-dot {
    position: absolute;
    left: -1000px;
    top: -1000px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255,230,40);
    border-width: 0px;
    border-color: rgb(80,20,0);
}

/* PC minimap text: map name GREEN (Color=0,255,0), coords GREEN (Color=0,255,0) — from ec10b91e.ini */
.hud-scene-name {
    width: 130px;
    height: 11px;
    font-size: 9px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
}

.hud-scene-pos {
    width: 130px;
    height: 11px;
    font-size: 9px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
}

/* PC ec10b91e [MapPosInput]: coord entry behind ScenePos (Tip=click to find path). */
.hud-map-pos-input {
    position: absolute;
    left: -43px;
    top: 129px;
    width: 112px;
    height: 14px;
    font-size: 10px;
    color: rgb(0,255,255);
    background-color: rgba(0,0,0,0.66);
    border-width: 0px;
    border-color: rgb(255,0,0);
}

.hud-minimap-btns {
    position: absolute;
    left: 56px;
    top: 136px;
    width: 74px;
    height: 14px;
    flex-direction: row;
    justify-content: flex-end;
}
/* PC minimap buttons — 16x16 SPR art, transparent hitbox for mobile touch */
.hud-minimap-btn {
    width: 20px;
    height: 20px;
    margin-left: 1px;
    margin-right: 1px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    -unity-background-scale-mode: scale-to-fit;
}
#MinimapMarkerBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_minimap_flag_pc.png'); }
#ToggleMapBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_minimap_switch_pc.png'); }
#WorldMapBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_minimap_world_full_pc.png'); }
#CaveMapBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_minimap_cave_pc.png'); }

/* PC minimap SwitchBtn toggles 小地图_小.ini (ec10b91e) ↔ 小地图_大.ini (f8bf2550).
   Keep the same PC button icons; only the minimap footprint changes. */
.hud-minimap-panel.hud-minimap-large {
    width: 370px;
    height: 332px;
}

.hud-minimap-panel.hud-minimap-large .hud-minimap-frame {
    width: 360px;
    height: 300px;
}

.hud-minimap-panel.hud-minimap-large .hud-minimap-content {
    width: 358px;
    height: 298px;
}

.hud-minimap-panel.hud-minimap-large .hud-scene-name,
.hud-minimap-panel.hud-minimap-large .hud-scene-pos {
    width: 360px;
}

.hud-minimap-panel.hud-minimap-large .hud-minimap-btns {
    left: 292px;
    top: 306px;
}

.hud-minimap-panel.hud-minimap-large .hud-map-pos-input {
    left: -9px;
    top: 306px;
    width: 126px;
}

.hidden { display: none; }


/* ═══ MAP PREVIEW ═══ */
.hud-map-preview-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 720px;
    background-color: rgba(0,0,0,0.0);
    align-items: center;
    justify-content: center;
}

.hud-map-preview-window {
    width: 520px;
    height: 560px;
    background-color: rgba(5,12,10,0.96);
    border-width: 0px;
    border-color: rgb(180,150,80);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud-map-preview-header {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-map-preview-title {
    width: 460px;
    height: 24px;
    font-size: 16px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-map-preview-close {
    width: 22px;
    height: 22px;
    background-color: rgba(80,20,10,0.95);
    border-width: 0px;
    border-color: rgb(230,200,120);
}

.hud-map-preview-frame {
    position: relative;
    width: 500px;
    height: 500px;
    border-width: 0px;
    border-color: rgb(180,150,80);
    background-color: rgba(10,20,12,0.95);
    overflow: hidden;
}

.hud-map-preview-content {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 500px;
    height: 500px;
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-preview-player-dot { width: 14px; height: 14px; }

.hud-map-preview-coords,
.hud-map-preview-help {
    height: 18px;
    color: rgb(230,230,210);
    font-size: 12px;
    -unity-text-align: middle-center;
}


/* ═══ CÁI BANG SKILL PANEL ═══ */
.hud-cb-skill-panel {
    position: absolute;
    left: 338px;
    top: 110px;
    width: 205px;
    height: 376px;
    background-color: rgba(0,0,0,0);
    padding-left: 7px;
    padding-right: 7px;
}

.hud-cb-close {
    position: absolute;
    left: 53px;
    top: 342px;
    width: 97px;
    height: 29px;
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_skill_02_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-cb-summary {
    position: absolute;
    left: 156px;
    top: 317px;
    width: 34px;
    height: 14px;
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-list {
    position: absolute;
    left: 7px;
    top: 57px;
    width: 191px;
    height: 278px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

.hud-cb-grid-cell { width: 38px; height: 51px; align-items: flex-start; justify-content: flex-start; }
.hud-cb-grid-cell-upgradable { background-color: rgba(0,0,0,0); }
.hud-cb-grid-slot { width: 36px; height: 36px; background-color: rgba(0,0,0,0); -unity-background-scale-mode: scale-to-fit; }
.hud-cb-grid-level { position: absolute; left: 0; top: 36px; width: 36px; height: 12px; color: rgb(218,255,165); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.hud-cb-add-point { position: absolute; left: 22px; top: 35px; width: 14px; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/状态加点按钮改_01.png'); -unity-background-scale-mode: stretch-to-fill; }
.hud-cb-grid-name { color: rgba(0,0,0,0); font-size: 1px; }
.hud-cb-page-tab { position: absolute; top: 314px; height: 20px; background-color: rgba(0,0,0,0); }
.hud-cb-page-one { left: 0px; width: 36px; }
.hud-cb-page-two { left: 37px; width: 31px; }
.hud-cb-page-tab-label { color: rgba(0,0,0,0); font-size: 1px; }
.hud-cb-page-tab-active { background-color: rgba(255,220,90,0.10); }


/* ═══ CHAT AREA — runtime C# (GameHudController.ApplySafeAreaLayout) sets left/translate per frame; USS is the fallback default ═══ */
.hud-chat-panel {
    position: absolute;
    left: 50%;
    top: auto;
    bottom: 8px;
    translate: -50% 0;
    /* total height = messages(123) + tabs(26) = 149 */
    width: 430px;
    height: 141px;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 880;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
  }

.hud-chat-warning {
    height: 18px;
    color: rgb(255,40,40);
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-chat-tabs {
    height: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    z-index: 881;
    margin-left: 0px;
    margin-right: 0px;
    padding-left: 0px;
    padding-right: 0px;
}

/* PC e3b06434.dat [OpenChannelBtn]: broad channel-open click proxy at the 7-o'clock chat corner.
   The PC INI points Image=\Spr\Ui3\主界面\按钮条按钮\ (folder only), so drawing a mobile
   panel here creates the wrong dark wrapper. Keep the 60x60 hit area transparent. */
.hud-open-channel-btn {
    position: absolute;
    left: 102px;
    top: -10px;
    width: 60px;
    height: 60px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    z-index: 879;
}

/* PC chat tab styling — channel buttons use PC SPR art (主界面按钮-世界频道选择.png etc).
   Active tab highlighted with PC-authentic teal-green border. */
/* PC SPR chat channel button visuals */
/*
   主界面按钮-世界频道选择.png
   主界面按钮-密人频道选择.png
   主界面按钮-城市频道选择.png
   主界面按钮-队伍频道选择.png
   主界面按钮-门派频道选择.png
   主界面按钮-好友频道选择.png
*/
.hud-chat-tab {
    min-width: 60px;
    height: 16px;
    margin-right: 2px;
    padding-left: 2px;
    padding-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0px;
}

.hud-chat-tab.active {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
}

/* Show Vietnamese tab labels on mobile */
.hud-chat-tab-label {
    display: flex;
    font-size: 11px;
    color: rgb(200,175,120);
    -unity-font-style: normal;
}

.hud-chat-tab.active .hud-chat-tab-label {
    color: rgb(255,230,150);
    -unity-font-style: bold;
}
/* ─────────────────────────────────────────────────────────────────
   Chat Rail — PC-accurate slim vertical scrollbar
   位置: left edge, covers messages area + tabs (top: -120px from input row)
   PC source: \Spr\Ui3\聊天条\聊天条中部改.spr  (track)
              \Spr\Ui3\好友qq\通用拖动条.spr  (thumb)
              \Spr\Ui3\聊天条\聊天条底部改.spr (size btn top)
              \Spr\Ui3\聊天条\聊天条顶部改.spr (move btn bottom)
   ───────────────────────────────────────────────────────────────── */
.hud-chat-rail {
    position: absolute;
    left: 0px;
    /* align bottom of rail with bottom of tabs (tabs(18) = 18) */
    bottom: 18px;
    width: 18px;
    /* track height matches ChatMessages height (SizeBtn(14) + Track(95) + MoveBtn(14) = 123) */
    height: 123px;
    z-index: 885;
    background-color: rgba(0,0,0,0);
}

/* SizeBtn — PC 聊天条底部改.spr, pinned to top of rail */
.hud-chat-size {
    position: absolute;
    left: 3px;
    top: 0px;
    width: 12px;
    height: 14px;
}

/* ScrollUp arrow — hidden per user request (no up/down arrow buttons) */
.hud-chat-scroll-up {
    display: none;
}

/* ScrollTrack — PC 聊天条中部改.spr, stretches between size btn and thumb */
.hud-chat-room-scroll-track {
    position: absolute;
    left: 3px;
    top: 14px;
    width: 12px;
    /* track fills from below size btn to above move btn */
    height: 95px;
    background-image: url('project://database/Assets/UI/HUD/Art/chat_scroll_track_pc.png');
    -unity-background-scale-mode: stretch-to-fill;
}

/* ScrollThumb — PC 通用拖动条.spr, draggable knob inside track */
.hud-chat-scroll-thumb {
    position: absolute;
    left: 3px;
    top: 45px;
    width: 12px;
    height: 24px;
}

/* ScrollDown arrow — hidden per user request */
.hud-chat-scroll-down {
    display: none;
}

/* Split / ChannelToggle / Shadow — hidden on mobile (rail-only version) */
.hud-chat-split,
.hud-chat-channel-toggle,
.hud-chat-shadow {
    display: none;
}

/* MoveBtn — PC 聊天条顶部改.spr, pinned to bottom of rail */
.hud-chat-move {
    position: absolute;
    left: 3px;
    bottom: 0px;
    width: 12px;
    height: 14px;
}

/* System notification buttons — hidden (not ported to mobile) */
.hud-chat-sys-up,
.hud-chat-sys-down,
.hud-chat-sys-open {
    display: none;
}

.hud-chat-rail-btn {
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-color: rgba(0,0,0,0);
}

.hud-chat-rail-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-chat-rail-icon.chat-up,
.hud-chat-rail-icon.chat-down {
    width: 16px;
    height: 10px;
}

.hud-chat-rail-icon.chat-thumb {
    width: 15px;
    height: 27px;
}

.hud-chat-rail-icon.chat-split {
    width: 14px;
    height: 85px;
}

.hud-chat-rail-icon.chat-size,
.hud-chat-rail-icon.chat-move,
.hud-chat-rail-icon.chat-shadow {
    width: 15px;
    height: 16px;
}

.hud-chat-rail-icon.chat-channel {
    width: 20px;
    height: 20px;
}

.hud-chat-rail-icon.chat-sys-up,
.hud-chat-rail-icon.chat-sys-open,
.hud-chat-rail-icon.chat-sys-down {
    width: 15px;
    height: 14px;
}

.hud-chat-rail-icon.chat-size { background-image: url('project://database/Assets/UI/HUD/Art/chat_bar_top.png'); }
.hud-chat-rail-icon.chat-move { background-image: url('project://database/Assets/UI/HUD/Art/chat_bar_bottom.png'); }
.hud-chat-rail-icon.chat-shadow { background-image: url('project://database/Assets/UI/HUD/Art/聊天条阴影按钮.png'); }
.hud-chat-rail-icon.chat-up { background-image: url('project://database/Assets/UI/HUD/Art/QQ主界面向上按钮_00.png'); }
.hud-chat-rail-icon.chat-thumb { background-image: url('project://database/Assets/UI/HUD/Art/btn_chat_scroll_thumb_pc.png'); }
.hud-chat-rail-icon.chat-split { background-image: url('project://database/Assets/UI/HUD/Art/btn_chat_split_pc.png'); }
.hud-chat-rail-icon.chat-channel { background-image: url('project://database/Assets/UI/HUD/Art/频道开与关b.png'); }
.hud-chat-rail-icon.chat-down { background-image: url('project://database/Assets/UI/HUD/Art/QQ主界面向下按钮_00.png'); }
.hud-chat-rail-icon.chat-sys-up { background-image: url('project://database/Assets/UI/HUD/Art/提示信息窗－上_00.png'); }
.hud-chat-rail-icon.chat-sys-open { background-image: url('project://database/Assets/UI/HUD/Art/提示信息窗－开关_00.png'); }
.hud-chat-rail-icon.chat-sys-down { background-image: url('project://database/Assets/UI/HUD/Art/提示信息窗－下_00.png'); }

.hud-chat-panel.hud-chat-expanded {
    width: 540px;
    height: 138px;
}

.hud-chat-panel.hud-chat-right {
    left: auto;
    right: 8px;
}

.hud-chat-panel.hud-chat-shadow-off .hud-chat-input-row,
.hud-chat-panel.hud-chat-shadow-off .hud-chat-tab {
    background-color: rgba(0, 0, 0, 0);
}

/* Chat messages area — sits between tabs and input row */
.hud-chat-messages {
    flex-grow: 1;
    height: 123px;
    margin-left: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    overflow: hidden;
}

/* Chat input row — PC style, dark brown/earthy background matching PC */
.hud-chat-input-row {
    height: 32px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    /* indent past the slim scroll rail */
    margin-left: 20px;
}


.hud-chat-channel-identity-btn {
    width: 24px;
    height: 24px;
    margin-left: 0px;
    margin-right: 4px;
    background-color: rgba(25, 31, 11, 0.82) !important;
    border-width: 1px !important;
    border-color: rgba(90, 115, 95, 0.45) !important;
    border-radius: 2px;
    background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－附近频道.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-chat-input {
    flex-grow: 1;
    height: 28px;
    color: rgb(254, 255, 160);
    font-size: 11px;
    background-color: rgba(25, 31, 11, 0.82);
    border-width: 1px;
    border-color: rgba(90, 115, 95, 0.45);
    border-radius: 3px;
}

.hud-chat-input .unity-text-field__input {
    background-color: rgba(25, 31, 11, 0.82) !important;
    border-width: 1px !important;
    border-color: rgba(90, 115, 95, 0.45) !important;
    color: rgb(254, 255, 160) !important;
    padding-left: 6px;
    padding-right: 6px;
}

.hud-face-btn,
.hud-face-btn:hover,
.hud-face-btn:active {
    width: 30px;
    height: 30px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: transparent !important;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_chat_face.png') !important;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0px !important;
    border-color: transparent !important;
    border-radius: 15px !important;
    overflow: hidden !important;
}

.hud-send-btn,
.hud-send-btn:hover,
.hud-send-btn:active {
    width: 30px;
    height: 30px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
    background-color: transparent !important;
    border-width: 0px !important;
    border-color: transparent !important;
    border-radius: 15px !important;
    overflow: hidden !important;
}

.hud-send-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
}


/* ═══ BOTTOM STRIP ═══ */
/* PC 800 bottom/action/menu chrome is one stitched 800px strip centered at x=240 from pc-evidence/pc_hud.png. */
.hud-bottom-strip {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 0px;
    width: 1280px;
    height: 106px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    background-image: url('project://database/Assets/UI/HUD/Art/bottom_bar_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding-left: 0px;
    padding-right: 0px;
}

/* The authentic hotbar pixels are baked into bottom_bar_bg.png. */
.hud-main-hotbar {
    display: none;
}

.hud-hotbar-slot {
    width: 36px;
    height: 36px;
    background-color: transparent;
    border-width: 0px;
    margin-left: 0px;
    margin-right: 0px;
}

.hud-slot-number {
    position: absolute;
    left: 3px;
    top: 1px;
    width: 12px;
    height: 12px;
    color: rgb(150,150,150);
    font-size: 9px;
    -unity-text-align: upper-left;
}


/* ═══ SKILL SLOTS (T/P) ═══ */
/* Absolute over centered PC 800 T/P art in bottom_bar_bg.png: centered x0=240 + PC x≈360..455. */
.hud-skill-panel {
    position: absolute;
    left: 600px;
    top: 27px;
    width: 95px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border-width: 0px;
    flex-shrink: 0;
}

.hud-skill-slot {
    width: 42px;
    height: 42px;
    background-color: transparent;
    border-width: 0px;
    margin-left: 1px;
    margin-right: 1px;
}

.hud-skill-panel > .hud-skill-slot {
    width: 42px;
    height: 42px;
    border-width: 0px;
    background-color: transparent;
    border-radius: 0px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hud-skill-slot-icon {
    width: 44px;
    height: 44px;
    background-size: contain;
}

.hud-skill-slot-icon.empty {
    background-color: rgba(40,80,60,0.5);
}

.hud-skill-slot-label {
    font-size: 11px;
    color: rgb(200,220,200);
    -unity-text-align: middle-center;
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    max-lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hud-skill-keys { display: none; }


/* ═══ RIGHT TOOLBAR HITBOXES ═══ */
/* Visible pixels are baked into the centered stitched bottom_bar_bg.png; controller offsets transparent buttons from PC 800 INI by x=240. */
.hud-right-toolbar {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 106px;
    background-color: transparent;
    padding-left: 0px;
    padding-right: 0px;
}

.hud-round-btn {
    position: absolute;
    width: 31px;
    height: 31px;
    margin-right: 0px;
    border-width: 0px;
    background-color: transparent;
    overflow: hidden;
    flex-shrink: 0;
}

.hud-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
}

.hud-toolbar-sep {
    width: 1px;
    height: 24px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: transparent;
}

.hud-menu-btn {
    position: absolute;
    width: 28px;
    height: 28px;
    margin-right: 0px;
    border-width: 0px;
    background-color: transparent;
    overflow: visible;
    flex-shrink: 0;
}

.hud-menu-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
}

.hud-menu-label { display: none; }

/* Bảo Vật pixels are baked into bottom_bar_bg.png; this is the hitbox. */
.hud-baovat-btn {
    position: absolute;
    width: 58px;
    height: 58px;
    margin-left: 0px;
    margin-right: 0px;
    border-radius: 29px;
    border-width: 0px;
    background-color: transparent;
    flex-shrink: 0;
}


/* ═══ BUFF/DEBUFF PANEL ═══ */
.hud-buff-panel {
    position: absolute;
    left: 450px;
    top: 24px;   /* ngay dưới top bar 22px + 2px gap */
    width: 240px;
    height: 72px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: transparent;
}

.hud-buff-cell { width: 24px; height: 30px; margin: 1px; align-items: center; justify-content: flex-start; }
.hud-buff-icon { width: 20px; height: 20px; border-width: 0px; border-radius: 2px; background-color: rgb(10, 20, 15); -unity-background-scale-mode: scale-to-fit; }
.hud-buff-border-green { border-color: rgb(55, 231, 63); }
.hud-buff-border-orange { border-color: rgb(255, 140, 0); }
.hud-buff-timer { font-size: 7px; color: rgb(55, 231, 63); -unity-text-align: middle-center; height: 10px; margin-top: 1px; -unity-font-style: bold; }
.hud-debuff-timer { color: rgb(255, 140, 0); }


/* ═══ TEAM PREVIEW ═══ */
.hud-team-preview {
    position: absolute;
    left: 10px;
    top: 120px;
    width: 170px;
    flex-direction: column;
}

.hud-team-member {
    position: relative;
    height: 50px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(5, 10, 8, 0.85);
    border-width: 0px;
    border-color: rgb(45, 130, 105);
    border-radius: 4px;
    margin-bottom: 4px;
    padding: 2px 4px;
}

.hud-team-leader-flag {
    position: absolute;
    left: 17px;
    top: -5px;
    width: 12px;
    height: 12px;
    background-image: url('project://database/Assets/UI/HUD/Art/队长移交_00.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-team-faction-icon { width: 26px; height: 26px; margin-right: 6px; background-color: rgba(0,0,0,0.8); border-width: 0px; border-color: #333333; -unity-background-scale-mode: scale-to-fit; }
.hud-team-member-info { flex-grow: 1; flex-direction: column; }
.hud-team-member-name { font-size: 10px; color: rgb(165, 255, 203); -unity-font-style: bold; margin-bottom: 2px; max-width: 120px; overflow: hidden; }
.hud-team-bar-track { height: 5px; width: 73px; background-color: rgba(0, 0, 0, 0.6); margin-bottom: 1px; overflow: hidden; }
.hud-team-bar-fill-hp { height: 100%; background-color: rgb(220, 50, 40); }
.hud-team-bar-fill-mp { height: 100%; background-color: rgb(40, 120, 220); }


/* ═══ TRADE INFO PANEL ═══ */
.hud-trade-panel {
    position: absolute;
    left: 15px;
    top: 170px;
    width: 182px;
    height: 110px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 0px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 6px;
}

.hud-trade-close {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 14px;
    height: 14px;
    background-color: rgba(180, 50, 40, 0.85);
    border-radius: 7px;
    border-width: 0px;
    border-color: rgb(220, 220, 220);
}

.hud-trade-title { font-size: 11px; color: rgb(255, 220, 90); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); }
.hud-trade-rows { flex-direction: column; }
.hud-trade-label { font-size: 10px; color: rgb(230, 230, 210); margin-bottom: 2px; }


/* ═══ STALL CURRENCY ═══ */
.hud-stall-currency {
    position: absolute;
    left: 460px;
    top: 150px;
    width: 180px;
    height: 80px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 0px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 8px;
    align-items: center;
}

.hud-stall-currency-title { font-size: 11px; color: rgb(230, 230, 210); margin-bottom: 8px; -unity-font-style: bold; }
.hud-stall-btns-row { flex-direction: row; justify-content: space-between; width: 100%; }
.hud-stall-btn { font-size: 10px; background-color: rgb(35, 115, 95); border-color: rgb(55, 185, 150); color: white; width: 75px; height: 24px; border-radius: 4px; }


/* ═══ FACE PICKER ═══ */
.hud-face-picker-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.hud-face-picker-window {
    width: 320px;
    max-height: 240px;
    background-color: rgba(15, 35, 28, 0.97);
    border-width: 0px;
    border-color: rgb(80, 160, 120);
    border-radius: 8px;
    position: absolute;
    left: 155px;
    bottom: 150px;
}

.hud-face-picker-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 10px; border-bottom-width: 1px; border-bottom-color: rgb(50, 100, 80); }
.hud-face-picker-title { font-size: 12px; color: rgb(220, 235, 210); -unity-font-style: bold; }
.hud-face-picker-close { width: 20px; height: 20px; background-color: rgba(180, 60, 60, 0.85); border-radius: 10px; }
.hud-face-picker-list { max-height: 190px; }
.hud-face-picker-list .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; padding: 4px; }
.hud-face-item { width: 28px; height: 28px; margin: 2px; align-items: center; justify-content: center; background-color: rgba(20, 50, 40, 0.8); border-width: 0px; border-color: rgb(50, 100, 80); border-radius: 4px; }
.hud-face-item-text { font-size: 14px; -unity-text-align: middle-center; }


/* ═══ SKILL PICKER ═══ */
.hud-skill-picker-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.7);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.hud-skill-picker-window {
    width: 340px;
    max-height: 440px;
    background-color: rgba(15,35,28,0.97);
    border-width: 0px;
    border-color: rgb(80,160,120);
    border-radius: 8px;
}

.hud-skill-picker-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom-width: 1px; border-bottom-color: rgb(50,100,80); }
.hud-skill-picker-title { font-size: 14px; color: rgb(220,235,210); -unity-font-style: bold; }
.hud-skill-picker-close { width: 28px; height: 28px; background-color: rgba(180,60,60,0.7); border-radius: 14px; }
.hud-skill-picker-list { height: 380px; max-height: 380px; overflow: hidden; }
.hud-skill-picker-list .unity-scroll-view__content-container { min-height: 760px; }

.skill-picker-item { flex-direction: row; align-items: center; padding: 8px 12px; margin: 3px 6px; border-width: 0px; border-color: rgb(50,100,80); border-radius: 4px; background-color: rgba(20,50,40,0.8); }
.skill-picker-item:hover { background-color: rgba(40,80,60,0.9); border-color: rgb(100,180,130); }
.skill-picker-icon { width: 40px; height: 40px; margin-right: 10px; background-size: contain; }
.skill-picker-info { flex: 1; }
.skill-picker-name { font-size: 13px; color: rgb(220,235,210); -unity-font-style: bold; }
.skill-picker-level { font-size: 10px; color: rgb(160,200,170); }
.skill-picker-type { font-size: 10px; color: rgb(140,170,150); margin-top: 2px; }

/* ═══ PC BAR ART = SINGLE VISUAL TRUTH ═══
   Bottom bar background = authentic PC frame (icons + slots + VN text baked in).
   Hide overlay icon visuals + slot numbers so PC art shows through with zero
   doubling. Containers stay (click zones intact). */
#BottomPanel .hud-slot-number { display: none; }
#BottomPanel .hud-btn-icon { display: none; }
/* Round action buttons (run/sit/horse/exchange) have no baked band art, so
   their authentic pc_hud.png pixels must stay visible. */
#BottomPanel .hud-round-btn .hud-btn-icon { display: flex; }
#BottomPanel .hud-menu-btn-icon { display: none; }
#BottomPanel .hud-skill-slot-icon { display: none; }
#BottomPanel .hud-skill-slot-label { display: none; }
#BottomPanel .hud-skill-keys { display: none; }

/* Exp bar defaults to empty (0%) like PC reference; SetBar fills it when bridge live. */
#ExpBarFill { width: 0; }


/* ═══ INVENTORY WINDOW (Hành Trang) — PC 05ea8560 道具界面 + 7bfc9072 colors ═══ */
.hud-inv-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0);
    z-index: 1000;
}

.hud-inv-frame {
    position: absolute;
    right: 6px;
    top: 136px;
    width: 214px;
    height: 474px;
    background-color: rgba(0,0,0,0);
    background-image: url('project://database/Assets/UI/HUD/Art/道具面板2.png');
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0px;
    border-radius: 0px;
    overflow: hidden;
}

.hud-inv-header { position: absolute; left: 0px; top: 0px; width: 214px; height: 474px; padding: 0px; border-width: 0px; }
.hud-inv-title { color: rgba(0,0,0,0); font-size: 1px; }
.hud-inv-close {
    position: absolute;
    left: 142px;
    top: 414px;
    width: 65px;
    height: 28px;
    background-color: rgba(0,0,0,0);
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_02_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
    border-radius: 0px;
}

.hud-inv-grid-backdrop {
    position: absolute;
    left: 24px;
    top: 72px;
    width: 168px;
    height: 280px;
    background-color: rgb(2,2,2);
    border-width: 0px;
}

.hud-inv-grid {
    position: absolute;
    left: 24px;
    top: 72px;
    width: 112px;
    height: 196px;
    max-height: 196px;
    overflow: hidden;
    padding: 0px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}
.hud-inv-grid .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; }
.hud-inv-grid .unity-scroll-view__vertical-scroller { display: none; }
.hud-inv-grid .unity-scroll-view__horizontal-scroller { display: none; }

/* PC [ItemBox] is 168×280 / 6×10. Mobile override: 4×7, 26px slot + 1px margin. */
.hud-inv-slot {
    width: 26px;
    height: 26px;
    margin: 1px;
    background-color: rgba(2,2,2,0.55);
    border-width: 0px;
    border-color: rgba(42,37,35,0.85);
    align-items: center;
    justify-content: center;
}
.hud-inv-slot-icon { width: 24px; height: 24px; background-size: contain; }
.hud-inv-slot-count { position: absolute; right: 0px; bottom: -2px; font-size: 10px; color: rgb(255,255,255); -unity-font-style: bold; }

.hud-inv-footer { position: absolute; left: 0px; top: 0px; width: 214px; height: 474px; padding: 0px; border-width: 0px; background-color: rgba(0,0,0,0); }
/* Money text color from PC 05ea8560 [Money] Color=255,217,78. */
.hud-inv-money { position: absolute; left: 53px; top: 353px; width: 110px; height: 14px; font-size: 12px; color: rgb(255,217,78); -unity-font-style: bold; }

/* ═══ MOBILE-FIRST COMBAT HUD — PC visual pixels, thumb-first layout ═══ */
.hud-mobile-bottom {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 0px;
    width: 1280px;
    /* PC bottom toolbar strip (主界面新版.spr cropped) as ornate stone/metal background.
       Source art is 800x60 px; on 1280x720 HUD reference at 1.5x screen scale that
       becomes 90 px tall. Keep the panel tight to the PC strip so the strip
       occupies ~12.5% of vertical space (was 220 px = 30% — way too tall for
       mobile and wasted space below the stone strip). */
    height: 90px;
    background-image: url('project://database/Assets/UI/HUD/Art/bottom_bar_bg.png');
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: white;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

/* .hud-mobile-utility-dock consolidated near end of file (mobile v2 tabbed dock). */

.hud-mobile-utility-btn {
    width: 52px;
    height: 52px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.18);
    border-width: 0px;
    
    border-radius: 13px;
}

.hud-mobile-treasure-btn {
    width: 62px;
    height: 62px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

#BottomPanel.hud-mobile-bottom .hud-btn-icon,
#BottomPanel.hud-mobile-bottom .hud-menu-btn-icon {
    display: flex;
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
}

.hud-treasure-icon {
    display: flex;
    width: 50px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
}

.hud-combat-action-cluster {
    position: absolute;
    right: 18px;
    bottom: 8px;
    width: 318px;
    height: 210px;
    background-color: rgba(0,0,0,0);
    display: none;
}

/* Primary attack button — PC art with subtle background, no heavy gold border.
   Mobile-appropriate size for thumb but styled to match PC visual feel. */
.hud-primary-attack-btn {
    position: absolute;
    right: 24px;
    bottom: 30px;
    width: 78px;
    height: 78px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.10);
    border-width: 0px;
    border-color: rgba(200,160,60,0.35);
    border-radius: 39px;
}

.hud-primary-attack-icon {
    width: 58px;
    height: 58px;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_primary_attack.png');
    -unity-background-scale-mode: scale-to-fit;
}

/* Mobile skill slots — transparent containers showing PC skill art.
   Keep mobile-appropriate touch size but minimal visual chrome. */
.hud-mobile-skill-slot {
    position: absolute;
    width: 66px;
    height: 66px;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_skill_empty_pc.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 33px;
    overflow: hidden;
}

.hud-combat-run-btn {
    position: absolute;
    right: 260px;
    bottom: 4px;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_skill_empty_pc.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 24px;
    overflow: hidden;
}

.hud-combat-run-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-skill-slot-main  { right: 100px; bottom: 20px; }
.hud-skill-slot-left  { right: 178px; bottom: 58px; }
.hud-skill-slot-top   { right: 108px; bottom: 104px; }
.hud-skill-slot-upper { right: 28px; bottom: 122px; }
.hud-skill-slot-extra  { right: 168px; bottom: 150px; }

#BottomPanel.hud-mobile-bottom .hud-skill-slot-icon {
    display: flex;
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

#BottomPanel.hud-mobile-bottom .hud-skill-slot-icon.empty {
    background-color: rgba(0,0,0,0);
}

#BottomPanel.hud-mobile-bottom .hud-skill-slot-label {
    display: flex;
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 1px;
    height: 14px;
    font-size: 10px;
    color: rgb(255,238,170);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.38);
}

/* Deck switch button — cycles A/B skill decks. Subtle PC style. */
.hud-deck-switch-btn {
    position: absolute;
    right: 202px;
    bottom: 126px;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.10);
    border-width: 0px;
    border-color: rgba(200,160,60,0.30);
    border-radius: 24px;
}

.hud-deck-switch-label {
    color: rgb(255,232,128);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-cancel-cast-zone {
    position: absolute;
    right: 142px;
    bottom: 158px;
    width: 96px;
    height: 46px;
    align-items: center;
    justify-content: center;
    background-color: rgba(120,20,20,0.76);
    border-width: 0px;
    border-color: rgba(255,170,120,0.78);
    border-radius: 23px;
}

.hud-cancel-cast-label {
    color: rgb(255,235,220);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-target-lock-field {
    position: absolute;
    left: 0px;
    top: 0px;
    right: 0px;
    bottom: 0px;
    background-color: rgba(0,0,0,0);
}

.hud-target-lock-marker {
    position: absolute;
    left: 50%;
    top: 132px;
    width: 180px;
    height: 30px;
    margin-left: -90px;
    align-items: center;
    justify-content: center;
    background-color: rgba(16,18,16,0.76);
    border-width: 0px;
    border-color: rgba(255,215,95,0.62);
    border-radius: 15px;
}

.hud-target-lock-name {
    color: rgb(255,231,160);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Mobile HUD does not use the old stitched PC bottom strip. Keep its classes
   dormant so stale PC-strip rules cannot hide mobile icons or move hitboxes. */
#BottomPanel.hud-mobile-bottom .hud-slot-number,
#BottomPanel.hud-mobile-bottom .hud-skill-keys {
    display: none;
}

/* Full PC utility set: 17 PC HUD buttons in two mobile-safe rows. */
/* old two-row utility dock position removed; v2 dock uses one consolidated rule. */

.hud-mobile-utility-row {
    height: 52px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

/* Utility buttons — show PC SPR button art directly, transparent hitbox. */
.hud-mobile-utility-btn {
    width: 48px;
    height: 48px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 0px;
}

.hud-mobile-utility-btn.active {
    background-color: rgba(52,74,34,0.30);
    border-color: rgba(168,255,112,0.50);
}

.hud-mobile-treasure-btn {
    width: 56px;
    height: 48px;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

#BottomPanel.hud-mobile-bottom .hud-btn-icon,
#BottomPanel.hud-mobile-bottom .hud-menu-btn-icon {
    width: 34px;
    height: 34px;
}

/* PC HUD tool surface for buttons whose full desktop panel is too large for the combat HUD. */
.hud-pc-tool-panel {
    position: absolute;
    right: 172px;
    bottom: 132px;
    width: 310px;
    max-height: 380px;
    background-color: rgba(12,18,12,0.94);
    border-width: 0px;
    border-color: rgba(206,165,82,0.86);
    border-radius: 10px;
    padding: 8px;
    z-index: 950;
}

/* PC per-panel background SPR (frame0). Sits behind header/list. */
.hud-pc-tool-panel-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 1;
    border-radius: 10px;
    -unity-background-image-tint-color: rgba(255,255,255,1);
}
/* When a PC bg is applied, the panel's own dark fill is dropped so the PC art reads as the
   real panel chrome; header/list lift above the bg layer. */
.hud-pc-tool-panel--sized {
    background-color: rgba(0,0,0,0);
}
.hud-pc-tool-panel--sized .hud-pc-tool-header,
.hud-pc-tool-panel--sized .hud-pc-tool-list {
    position: relative;
}
.hud-pc-tool-panel--sized .hud-pc-tool-header {
    background-color: rgba(0,0,0,0.35);
}

.hud-pc-tool-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(206,165,82,0.55);
}

.hud-pc-tool-title {
    color: rgb(255,232,156);
    font-size: 15px;
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    margin-right: 6px;
    margin-left: 4px;
    height: 22px;
    min-width: 60px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.hud-pc-tool-close {
    width: 56px;
    height: 24px;
    background-image: url('project://database/Assets/UI/HUD/Art/vi/btn_close_skill_02_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-pc-tool-list {
    max-height: 330px;
    margin-top: 6px;
}

/* PC tab strip — used by Character panel (4 pages) and any other multi-page panel.
   Each tab is a small button composited from common_tab.spr with a Vietnamese label
   (PC art + VN text overlay). Click invokes the per-tab pcSection handler. */
.hud-pc-tool-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    min-height: 24px;
}
.hud-pc-tool-tab {
    width: 64px;
    height: 22px;
    margin-right: 4px;
    margin-bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url('project://database/Assets/UI/HUD/Art/common_tab.png');
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.hud-pc-tool-tab-label {
    color: rgb(169, 211, 190);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-basis: 0;
}
.hud-pc-tool-tab.active .hud-pc-tool-tab-label {
    color: rgb(225, 213, 43);
}

.hud-pc-tool-row {
    min-height: 24px;
    margin-bottom: 4px;
    padding: 4px;
    background-color: rgba(0,0,0,0.24);
    border-left-width: 2px;
    border-left-color: rgba(206,165,82,0.55);
}

.hud-pc-tool-row-title { color: rgb(226,244,190); font-size: 13px; -unity-font-style: bold; }
.hud-pc-tool-row-text { color: rgb(205,218,190); font-size: 12px; white-space: normal; }

/* Mobile UX: PC utility menu access — small subtle toggle beside minimap.
   PC has hotkey-based access; mobile needs a visible toggle.
   Keep it minimal so it doesn't distract from PC HUD feel. */
.hud-utility-toggle-btn {
    position: absolute;
    right: 178px;
    top: 6px;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background-color: rgba(5,10,6,0.72);
    border-width: 1px;
    border-color: rgba(206,165,82,0.55);
    border-radius: 8px;
    z-index: 920;
}

.hud-utility-toggle-btn.active {
    background-color: rgba(52,74,34,0.72);
    border-color: rgba(168,255,112,0.85);
    border-width: 1px;
}

.hud-utility-toggle-btn .hud-menu-btn-icon {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 32px;
    height: 32px;
    opacity: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-utility-toggle-label {
    display: none;
}

/* Utility dock — opens on toggle, compact PC-style panel beside minimap.
   PC has hotkeys; mobile shows a small floating panel with action/menu buttons. */
/* old top-right action/menu utility dock rules removed; v2 uses tabbed dock only. */

/* Switch button inside utility dock — cycles action/menu rows. Subtle PC style. */
.hud-utility-switch-btn {
    position: absolute;
    right: 6px;
    top: 7px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 0px;
}

.hud-mobile-utility-dock.menu-mode .hud-utility-switch-btn {
    top: 33px;
}

.hud-utility-switch-btn.active {
    background-color: rgba(52,74,34,0.30);
}

.hud-utility-switch-btn .hud-menu-btn-icon {
    position: absolute;
    left: 7px;
    top: 4px;
    width: 32px;
    height: 32px;
    opacity: 0.88;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-utility-switch-label {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 1px;
    height: 15px;
    color: rgb(255,238,174);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.42);
}

.hud-mobile-utility-row {
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.hud-mobile-utility-btn {
    width: 46px;
    height: 46px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.20);
    border-width: 0px;
    border-color: rgba(175,140,72,0.40);
    border-radius: 11px;
}

.hud-mobile-utility-btn.active {
    background-color: rgba(58,86,38,0.72);
    border-color: rgba(168,255,112,0.85);
}

.hud-mobile-treasure-btn {
    width: 54px;
    height: 46px;
    margin-left: 3px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.05);
    border-width: 0px;
}

.hud-mobile-utility-btn .hud-btn-icon,
.hud-mobile-utility-btn .hud-menu-btn-icon {
    display: flex;
    width: 32px;
    height: 32px;
    opacity: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-mobile-treasure-btn .hud-treasure-icon {
    display: flex;
    width: 44px;
    height: 44px;
    opacity: 1;
    -unity-background-scale-mode: scale-to-fit;
}

#BottomPanel.hud-mobile-bottom .hud-skill-slot-icon,
#BottomPanel.hud-mobile-bottom .hud-btn-icon,
#BottomPanel.hud-mobile-bottom .hud-menu-btn-icon {
    opacity: 1;
}

.hud-pc-tool-panel {
    right: 204px;
    top: 168px;
    bottom: auto;
}


/* PC Ui3/icon_bar.ini — 7-icon right strip.
   PC SPR icons are 23-25px squares with built-in cyan/teal frame and dark bg.
   Do NOT wrap in additional dark bg/gold border — PC art already has its own frame.
   Touch hitboxes are 46px for mobile but fully transparent. */
.hud-pc-icon-bar {
    position: absolute;
    right: 148px;
    top: 100px;
    width: 46px;
    height: 322px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 918;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

.hud-pc-icon-bar-btn {
    width: 46px;
    height: 46px;
    margin-top: 0px;
    margin-bottom: 0px;
    align-items: center;
    justify-content: center;
    /* Transparent hitbox — PC icon art provides its own frame */
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 0px;
}

.hud-pc-icon-bar-btn.active {
    background-color: rgba(52,74,34,0.40);
    border-color: rgba(168,255,112,0.50);
}

.hud-pc-icon-bar-icon {
    /* Native PC SPR size — icons have built-in cyan frame at 23-25px */
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Stitch "Jade Path Legacy" UX */
/* PC quick shortcuts — small toggle to show/hide the 1-9 item slot bar.
   Keep subtle, PC-style. */
.hud-pc-shortcut-toggle-btn {
    position: absolute;
    right: 148px;
    top: 68px;
    bottom: auto;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 0px;
    z-index: 921;
}

.hud-pc-shortcut-toggle-btn.active {
    background-color: rgba(52,74,34,0.30);
    border-width: 0px;
}

.hud-pc-shortcut-toggle-label {
    color: rgb(255,238,174);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-pc-shortcut-dock {
    /* Kept as a placeholder; the authoritative position is the consolidated block below
       to avoid the duplicate-rule CSS conflict that previously rendered a 236x158 ghost
       panel in the upper-right. */
    display: none;
}

.hud-pc-shortcut-grid {
    width: 150px;
    height: 138px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.hud-pc-item-slot {
    width: 46px;
    height: 44px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    
    border-radius: 7px;
}

.hud-pc-item-slot-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-pc-skill-shortcut-row {
    width: 64px;
    height: 138px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
}

.hud-pc-skill-shortcut-btn {
    width: 60px;
    height: 62px;
    margin-top: 3px;
    margin-bottom: 3px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0px;
    
    border-radius: 9px;
}

.hud-pc-skill-shortcut-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-pc-skill-shortcut-label {
    position: absolute;
    right: 3px;
    bottom: 1px;
    width: 14px;
    height: 14px;
    color: rgb(255,238,174);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(0,0,0,0.48);
}
.hud-pc-item-slot-icon.slot-1 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_1_pc.png'); }
.hud-pc-item-slot-icon.slot-2 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_2_pc.png'); }
.hud-pc-item-slot-icon.slot-3 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_3_pc.png'); }
.hud-pc-item-slot-icon.slot-4 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_4_pc.png'); }
.hud-pc-item-slot-icon.slot-5 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_5_pc.png'); }
.hud-pc-item-slot-icon.slot-6 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_6_pc.png'); }
.hud-pc-item-slot-icon.slot-7 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_7_pc.png'); }
.hud-pc-item-slot-icon.slot-8 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_8_pc.png'); }
.hud-pc-item-slot-icon.slot-9 { background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_9_pc.png'); }
.hud-pc-skill-shortcut-icon.left-skill { background-image: url('project://database/Assets/UI/HUD/Art/btn_pc_left_skill_slot.png'); }
.hud-pc-skill-shortcut-icon.right-skill { background-image: url('project://database/Assets/UI/HUD/Art/btn_pc_right_skill_slot.png'); }

.hud-pc-shortcut-dock {
    position: absolute;
    right: 6px;
    top: 175px;
    left: auto;
    bottom: auto;
    width: 136px;
    height: 44px;
    background-color: rgba(5, 10, 6, 0.6);
    border-width: 0px;
    border-radius: 6px;
    padding: 4px;
    z-index: 914;
    margin-left: 0px;
}
.hud-pc-shortcut-grid {
    position: absolute;
    left: 0px;
    bottom: 0px;
    top: 0px;
    right: 0px;
    width: auto;
    height: auto;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-around;
}
.hud-pc-item-slot {
    width: 36px;
    height: 36px;
    margin: 0px;
    background-color: transparent;
    border-width: 0px;
}
.hud-pc-skill-shortcut-row {
    position: absolute;
    left: 372px;
    bottom: 35px;
    flex-direction: row;
}
.hud-pc-skill-shortcut-btn {
    width: 36px; height: 36px; margin-right: 2px;
}

.hud-chat-panel {
    background-color: transparent;
}
.hud-chat-tab {
    background-color: transparent !important;
}

/* Chat channel identity button background graphics dynamically switched in code */
.hud-chat-channel-identity-all { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－附近频道.png') !important; }
.hud-chat-channel-identity-world { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－世界频道.png') !important; }
.hud-chat-channel-identity-private { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－密人频道.png') !important; }
.hud-chat-channel-identity-team { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－队伍频道.png') !important; }
.hud-chat-channel-identity-faction { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－门派频道.png') !important; }
.hud-chat-channel-identity-room { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－城市频道.png') !important; }
.hud-chat-channel-identity-guild { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－好友频道.png') !important; }
.hud-chat-channel-identity-other { background-image: url('project://database/Assets/UI/HUD/Art/聊天频道图示－好友频道.png') !important; }

/* ═══════════════════════════════════════════════════════════════════
   MOBILE HUD v2 — tabbed categorized dock + combat quick arc
   ═══════════════════════════════════════════════════════════════════ */

/* Combat-critical quick actions (PK/farm): mount + sit + PK arc beside skill slots.
   Thumb-reach from PrimaryAttackBtn; sized like run button for consistent muscle memory. */
.hud-combat-quick-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_skill_empty_pc.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 24px;
    overflow: hidden;
}

.hud-combat-quick-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Arc to the LEFT of the skill cluster, stacked so mount/run/sit/PK cluster within thumb sweep. */
/* Quick-action column to the FAR LEFT of the skill cluster, within bounds.
   Skill slots occupy right:28-178 bottom:20-122; quick actions use right:260
   so Run/Mount/Sit/PK never overlap skills and remain reachable by thumb. */
.hud-combat-mount-btn { right: 260px; bottom: 56px; }
.hud-combat-sit-btn   { right: 260px; bottom: 108px; }
.hud-combat-pk-btn    { right: 260px; bottom: 160px; }

.hud-combat-mount-btn .hud-combat-quick-icon { background-image: url('project://database/Assets/UI/HUD/Art/btn_horse.png'); }
.hud-combat-sit-btn .hud-combat-quick-icon   { background-image: url('project://database/Assets/UI/HUD/Art/btn_sit.png'); }
.hud-combat-pk-btn .hud-combat-quick-icon    { background-image: url('project://database/Assets/UI/HUD/Art/btn_pk.png'); }

.hud-combat-quick-btn.active {
    background-color: rgba(58,86,38,0.72);
    border-color: rgba(168,255,112,0.85);
    border-width: 1px;
}

/* ═══ Tabbed dock: 5 categorized groups (Nhân vật / Hành trang / Xã hội / Hoạt động / Hệ thống) ═══ */

.hud-mobile-utility-tab-strip {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-around;
    width: 100%;
    height: 34px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(206,165,82,0.65);
}

.hud-mobile-utility-tab {
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12,24,10,0.72);
    border-width: 1px;
    border-color: rgba(206,165,82,0.32);
    border-radius: 6px 6px 0 0;
    margin-left: 1px;
    margin-right: 1px;
    color: rgb(255,245,205);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 0px;
    padding-right: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
}

.hud-mobile-utility-tab.tab-active {
    background-color: rgba(52,74,34,0.80);
    border-bottom-width: 2px;
    border-bottom-color: rgba(168,255,112,0.85);
    color: rgb(255,255,220);
}

.hud-mobile-utility-tab-label {
    width: 100%;
    height: 100%;
    color: rgb(245,236,196);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.hud-mobile-utility-tab.tab-active .hud-mobile-utility-tab-label {
    color: rgb(255,250,220);
}

/* Tab panels: wrap buttons in a grid so each tab shows its group compactly. */
.hud-mobile-utility-tab-panel {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    flex: 1 1 auto;
    padding-top: 4px;
}

.hud-mobile-utility-tab-panel.hidden {
    display: none;
}

/* Button label under each icon so players learn each button's meaning. */
.hud-mobile-utility-btn-label {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 0px;
    height: 14px;
    color: rgb(245,236,196);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    background-color: rgba(0,0,0,0.58);
}

/* Dock tweaks: single authoritative v2 rule.
   Opens BELOW the minimap/tool row so the expanded panel does not float over
   the top-right HUD. Older duplicate dock rules above were removed. */
.hud-mobile-utility-dock {
    position: absolute;
    right: 8px;
    top: 174px;
    left: auto;
    bottom: auto;
    width: 372px;
    height: 168px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(5,10,6,0.92);
    border-width: 1px;
    border-color: rgba(206,165,82,0.55);
    border-radius: 10px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 6px;
    z-index: 910;
}

/* Icon-bar buttons inside tab use the same 46px tile but keep native SPR frame. */
.hud-mobile-utility-tab-panel .hud-pc-icon-bar-icon {
    width: 30px;
    height: 30px;
}

/* CRITICAL hidden-state override: .hud-mobile-utility-dock has 4 size declarations above
   with equal specificity to .hidden, so they clobber display:none. This later, equally-
   specific two-class selector restores the hide behavior so the dock starts collapsed. */
.hud-mobile-utility-dock.hidden {
    display: none;
}

/* Final v2 readability overrides. Keep after legacy PC rules so tab labels and item
   labels win over the old duplicate utility-button declarations. Large/high-contrast
   because 900px screenshots and mobile DPI made the previous 14px labels look blank. */
.hud-mobile-utility-dock {
    width: 244px;
    height: 170px;
    background-image: url('project://database/Assets/UI/HUD/Art/utility_dock_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: white;
    background-color: rgba(5,10,6,0.96);
    border-width: 2px;
    border-color: rgb(220,175,80);
}

.hud-mobile-utility-tab-strip {
    height: 46px;
    margin-bottom: 6px;
}

.hud-mobile-utility-tab {
    height: 42px;
    min-width: 42px;
    color: rgb(255,255,255);
    background-color: rgb(34,56,28);
    border-width: 2px;
    border-color: rgb(220,175,80);
}

.hud-mobile-utility-tab.tab-active {
    background-color: rgb(72,112,42);
    border-color: rgb(168,255,112);
}

.hud-mobile-utility-tab-icon {
    position: absolute;
    left: 7px;
    top: 5px;
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-mobile-utility-tab-label {
    display: none;
}

.hud-mobile-utility-tab-panel {
    padding-top: 4px;
    justify-content: center;
}

.hud-mobile-utility-btn,
.hud-mobile-treasure-btn {
    width: 50px;
    height: 50px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 3px;
    margin-bottom: 3px;
    overflow: hidden;
    background-color: rgba(0,0,0,0.32);
    border-width: 1px;
    border-color: rgba(220,175,80,0.45);
}

.hud-mobile-utility-btn .hud-menu-btn-icon,
.hud-mobile-utility-btn .hud-btn-icon,
.hud-mobile-utility-btn .hud-pc-icon-bar-icon,
.hud-mobile-treasure-btn .hud-treasure-icon {
    width: 40px;
    height: 40px;
}

.hud-mobile-utility-btn-label {
    display: none;
}

/* ═══ PC-STYLE BOTTOM TOOLBAR MENU ROW ═══ */
/* PC 工具控制条.ini: 800x45 toolbar with 5 round action buttons on LEFT
   (Run/Sit/Horse/Exchange/PK, 30x30, Left=9,40,75,110,145 Top=10) and
   6 menu buttons on RIGHT (Status/Items/Skills/Team/Faction/WorldSort,
   40x40, Left=474,514,555,594,635,713 Top=2). PC INI is designed for
   800x600 PC resolution where 30x30 and 40x40 are touch-friendly.
   Mobile (1280x720 HUD) needs them bigger and the icons are PC-native
   20x20 SPRs so we 1.5x the whole toolbar for thumb-friendly hit boxes
   without changing relative positions:
     toolbar 1200x67, round 45x45 at Left=13.5/60/112.5/165/217.5 Top=15,
     menu 60x60 at Left=711/771/832.5/891/952.5/1070 Top=3.
   Positioned left=40 (centred in 1280 HUD) so the toolbar fits. */
.hud-pc-menu-toolbar {
    position: absolute;
    left: 40px;
    bottom: 8px;
    width: 1200px;
    height: 67px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    z-index: 100;
}

.hud-pc-toolbar-btn {
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
    border-radius: 0px;
    margin: 0px;
    padding: 0px;
}

/* Round action buttons: 45x45 (1.5x of PC INI 30x30) — mobile thumb size */
.hud-pc-toolbar-round {
    width: 45px;
    height: 45px;
    position: absolute;
    top: 15px;
}

/* Menu buttons: 60x60 (1.5x of PC INI 40x40) — mobile thumb size */
.hud-pc-toolbar-menu {
    width: 60px;
    height: 60px;
    position: absolute;
    top: 3px;
}

/* PC INI Left × 1.5 for round actions (relative to .hud-pc-menu-toolbar) */
#BtnRun      { left:  13.5px; }
#BtnSit      { left:    60px; }
#BtnHorse    { left: 112.5px; }
#BtnExchange { left:   165px; }
#BtnPK       { left: 217.5px; }

/* PC INI Left × 1.5 for menu cluster (relative to .hud-pc-menu-toolbar) */
#BtnStatus     { left:   711px; }
#BtnItems      { left:   771px; }
#BtnSkills     { left: 832.5px; }
#BtnTeam       { left:   891px; }
#BtnFaction    { left: 952.5px; }
#BtnWorldSort  { left:  1070px; }

.hud-pc-toolbar-btn .hud-menu-btn-icon,
.hud-pc-toolbar-btn .hud-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    /* PC toolbar icons are 20x20 source PNGs stretched to fit the larger
       mobile button slot. Use scale-and-crop with explicit 100% x 100% so
       the icon fills the entire button instead of staying at native 20x20
       in the corner (which makes icons invisible on a 45-60px button). */
    background-size: 100% 100%;
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: 50%;
    background-position-y: 50%;
    /* PC toolbar icons render at full opacity once LoadArt finishes.
       The base .hud-menu-btn-icon/.hud-btn-icon defaults to opacity:0
       (icons hidden until bridge signals loaded); previous BottomPanel
       context overrode it to 1, but PcMenuToolbar is a sibling now. */
    opacity: 1;
}

/* Fallback label for buttons missing PC SPR art (e.g. WorldSort 排行).
   Drawn on top of the icon slot so the user sees something instead of
   an invisible button. Color matches PC HUD text on dark background. */
.hud-pc-toolbar-fallback-label {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    -unity-text-align: middle-center;
    color: rgb(255, 217, 78);
    font-size: 11px;
    -unity-font-style: bold;
}
