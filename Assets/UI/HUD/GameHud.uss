/* VLTK Mobile HUD — reference layout: top stat strip + bottom ornate bar */

.hud-root {
    width: 1280px;
    height: 720px;
    overflow: hidden;
}

/* TOP FRAME BG: BỎ — top_frame_bg.png là dải composite full-width 1280×88
   (gỗ+hotkey+minimap) KHÔNG có trong PC gốc, gây tràn/tràn vỡ trên mobile.
   PC thật chỉ có panel 新血条面板 552×17 (xem PcBarPanelBg dưới). */
.hud-top-frame-bg {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 88px;
    background-image: url('project://database/Assets/UI/HUD/Art/top_frame_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

/* TOP STATUS STRIP — full-width container, bars dùng absolute coords trong 1280-space */
.hud-top-status {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 50px;
    background-color: transparent;
}

/* PC 新血条面板 (bar_panel_bg.png = 552×17, đúng art PC gốc). PC origin Main.Left×1.25=150.
   MOBILE shift -112 (margin trái giảm 1/2 hai lần: 150→75→38). W=552×1.25=690; H=17×1.25≈21 */
.hud-pc-bar-panel-bg {
    position: absolute;
    left: 38px;
    top: 0px;
    width: 690px;
    height: 21px;
    background-image: url('project://database/Assets/UI/HUD/Art/bar_panel_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    display: flex;
}

.hud-level-box {
    position: absolute;
    left: 82px; /* PC 194 - 112 mobile-shift (margin trái giảm 1/2 hai lần) */
    top: 8px;
    width: 25px; /* PC 20 × 1.25 */
    height: 14px;
    font-size: 11px;
    color: rgb(55,231,63);
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
}

/* WorldSort box (Hạng) — vẽ qua IMGUI overlay, ẩn element để tránh vẽ đè */
.hud-worldsort-box {
    position: absolute;
    left: 691px; /* PC 803 - 112 mobile-shift (margin trái giảm 1/2 hai lần) */
    top: 8px;
    width: 35px; /* PC 28 × 1.25 */
    height: 14px;
    font-size: 10px;
    color: rgb(55,231,63);
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
    display: none;
}

.hud-top-bar {
    position: absolute;
    top: 3px; /* PC bars Top=3 */
    width: 130px; /* PC 104px × 1.25 */
    height: 14px;
    background-color: transparent;
    border-width: 0px;
    overflow: hidden;
}

/* Bars absolute coords 1280-space. PC base=150; MOBILE shift -112 → base=38.
   Stamina=111, HP=248, MP=386, EXP=523 (= PC value - 112). */
.hud-stamina-track { left: 111px; }
.hud-hp-track { left: 248px; }
.hud-mp-track { left: 386px; }
.hud-exp-track { left: 523px; }

.hud-top-fill {
    width: 100%;
    height: 14px; /* PC 9px ×1.6 */
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-exp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_exp_fill.png');
}
.hud-hp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_hp_fill.png');
}
.hud-mp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_mp_fill.png');
}
.hud-stamina-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_stamina_fill.png');
}

.hud-vn-top-caption {
    position: absolute;
    top: -1px;
    height: 10px;
    font-size: 9px;
    color: rgb(230,230,210);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
/* Captions ẩn - IMGUI overlay sẽ vẽ. Positions absolute trong 1280-space (base 150). */
.hud-vn-level-caption { left: 82px; width: 25px; display: none; }
.hud-vn-stamina-caption { left: 111px; width: 130px; display: none; }
.hud-vn-hp-caption { left: 248px; width: 130px; display: none; }
.hud-vn-mp-caption { left: 386px; width: 130px; display: none; }
.hud-vn-exp-caption { left: 523px; width: 130px; display: none; }


.hud-top-small-text {
    position: absolute;
    top: 17px;
    width: 104px;
    height: 12px;
    font-size: 12px;
    color: rgb(255,255,255);
    -unity-text-align: middle-center;
    background-color: transparent;
}
/* Values dưới bar tracks — ẩn UIToolkit labels, IMGUI overlay sẽ vẽ. Absolute 1280-space (base 150). */
.hud-stamina-text { left: 111px; display: none; }
.hud-hp-text { left: 248px; display: none; }
.hud-mp-text { left: 386px; display: none; }
.hud-exp-text { left: 523px; display: none; }



/* MINIMAP: sandbox helper, top-right */
.hud-minimap-panel {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 136px;
    height: 166px;
    align-items: center;
    z-index: 20;
}

.hud-minimap-frame {
    width: 130px;
    height: 130px;
    border-width: 2px;
    border-color: rgb(58,138,92);
    border-radius: 0px;
    background-color: rgba(5,10,5,0.92);
    overflow: hidden;
}

.hud-minimap-content {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 128px;
    height: 128px;
    background-color: rgba(15,25,15,0.90);
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-player-dot {
    position: absolute;
    left: 60px;
    top: 60px;
    width: 10px;
    height: 10px;
    background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-map-target-dot {
    position: absolute;
    left: -1000px;
    top: -1000px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255,230,40);
    border-width: 1px;
    border-color: rgb(80,20,0);
}

.hud-scene-name,
.hud-scene-pos {
    width: 130px;
    height: 11px;
    font-size: 9px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
}

.hud-minimap-btns {
    position: absolute;
    left: 58px;
    top: 136px;
    width: 72px;
    height: 16px;
    flex-direction: row;
    justify-content: flex-end;
}
.hud-minimap-btn {
    width: 16px;
    height: 16px;
    margin-left: 1px;
    margin-right: 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.hidden {
    display: none;
}

.hud-map-preview-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 720px;
    background-color: rgba(0,0,0,0.0);
    align-items: center;
    justify-content: center;
}

.hud-map-preview-window {
    width: 520px;
    height: 560px;
    background-color: rgba(5,12,10,0.96);
    border-width: 2px;
    border-color: rgb(180,150,80);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud-map-preview-header {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-map-preview-title {
    width: 460px;
    height: 24px;
    font-size: 16px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-map-preview-close {
    width: 22px;
    height: 22px;
    background-color: rgba(80,20,10,0.95);
    border-width: 1px;
    border-color: rgb(230,200,120);
}

.hud-map-preview-frame {
    position: relative;
    width: 500px;
    height: 500px;
    border-width: 2px;
    border-color: rgb(180,150,80);
    background-color: rgba(10,20,12,0.95);
    overflow: hidden;
}

.hud-map-preview-content {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 500px;
    height: 500px;
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-preview-player-dot {
    width: 14px;
    height: 14px;
}

.hud-map-preview-coords,
.hud-map-preview-help {
    height: 18px;
    color: rgb(230,230,210);
    font-size: 12px;
    -unity-text-align: middle-center;
}


    /* CHAT AREA — PC 聊天条 (7e20a7ac.ini), rebuilt per port-pc-chat-bar-parity design §3.
       Bottom-anchored, center-lane, between joystick (x<155) and combat cluster (right).
       column-reverse: input at bottom, history at top (PC TextBottom=1).
       Frame SPR art loads at runtime via C# LoadIconStatic, not USS background-image. */
    .hud-chat-panel {
        position: absolute;
        left: 160px;          /* clear of bottom-left joystick (x >= 155 per jx-hud-port) */
        bottom: 16px;
        width: 640px;
        min-height: 60px;     /* collapsed: input only */
        flex-direction: column-reverse;  /* input bottom, history top */
        overflow: visible;
        picking-mode: Ignore;  /* root passthrough; PR 2 controller re-enables Position on children */
    }

    /* Collapsed: channel toggle off → hide history + system, show input only */
    .hud-chat-panel.collapsed .hud-chat-room-area,
    .hud-chat-panel.collapsed .hud-chat-sys-area {
        display: none;
    }

    /* Channel selector row: PC [ChannelBtn] + 6 tabs (ChatTabNum=6) */
    .hud-chat-channel-row {
        flex-direction: row;
        align-items: center;
        height: 22px;
        flex-shrink: 0;
    }
    .hud-chat-channel-toggle {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        margin-right: 4px;
    }
    .hud-chat-toggle-icon {
        width: 100%;
        height: 100%;
        -unity-background-scale-mode: scale-to-fit;
    }
    .hud-chat-tab {
        flex-grow: 1;
        min-width: 50px;
        height: 22px;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        border-bottom-width: 2px;
        border-bottom-color: rgba(255,255,255,0);
    }
    .hud-chat-tab.selected {
        border-bottom-color: rgb(255,249,148);  /* PC MsgColor highlight */
    }
    .hud-chat-tab-label {
        font-size: 11px;
        color: rgb(220,220,220);  /* PC NameTextColor=220,220,220 */
        -unity-text-align: middle-center;
    }
    .hud-chat-channel-identity {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        margin-left: 4px;
        -unity-background-scale-mode: scale-to-fit;
    }

    /* ChatRoom: message history (PC [ChatRoom_List] 280×140, MsgColor=255,249,148) */
    .hud-chat-room-area {
        flex-grow: 1;
        min-height: 100px;
        flex-direction: row;
        align-items: stretch;
    }
    .hud-chat-room-list {
        flex-grow: 1;
        overflow: hidden;
    }
    .hud-chat-room-content {
        font-size: 12px;
        color: rgb(255,249,148);  /* PC MsgColor */
        /* enableRichText is set in C# for UI Toolkit rich text support */
        white-space: normal;
        flex-grow: 1;
        flex-shrink: 0;
        min-height: 96px;
        -unity-text-align: lower-left;
        padding: 2px 4px;
    }
    .hud-chat-scroll-track {
        width: 15px;
        flex-shrink: 0;
        margin-left: 2px;
        -unity-background-scale-mode: scale-to-fill;
    }
    .hud-chat-scroll-thumb {
        width: 16px;
        height: 25px;
        -unity-background-scale-mode: scale-to-fit;
    }

    /* SysRoom: system/combat strip (PC [SysRoom_List] 235×42, collapsible) */
    .hud-chat-sys-area {
        height: 42px;
        flex-shrink: 0;
        flex-direction: row;
        align-items: center;
    }
    .hud-chat-sys-toggle {
        width: 19px;
        height: 13px;
        flex-shrink: 0;
        margin-right: 2px;
    }
    .hud-chat-sys-content {
        font-size: 11px;
        color: rgb(255,249,148);  /* PC MsgColor */
        flex-grow: 1;
        flex-shrink: 0;
        height: 34px;
        min-height: 34px;
        white-space: normal;
        -unity-text-align: lower-left;
    }
    .hud-chat-sys-btn {
        width: 19px;
        height: 13px;
        flex-shrink: 0;
        -unity-background-scale-mode: scale-to-fit;
    }

    /* Input row (preserved styles for ChatInput/FaceBtn/SendBtnIcon) */
    .hud-chat-input-row {
        flex-direction: row;
        align-items: center;
        width: 640px;
        height: 28px;
        flex-shrink: 0;
        background-color: rgba(5,10,8,0.85);
        border-width: 1px;
        border-color: rgb(70,70,70);
    }

.hud-chat-input {
    flex-grow: 1;
    height: 24px;
    color: rgb(230,245,230);
    font-size: 12px;
    background-color: rgba(0,0,0,0.45);
    border-width: 0px;
}

.hud-face-btn {
    width: 30px;
    height: 26px;
    background-color: transparent;
    border-width: 0px;
}

.hud-send-icon {
    width: 24px;
    height: 24px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

/* BOTTOM TOOLBAR — PC 快捷栏.spr (hash ebb69f9b, recovered via jx-pc-resource-resolver).
   Strip is a transparent container; the real PC filigree frame lives in a child
   .hud-bottom-frame layer (natural aspect 863x91 = 9.48:1), bottom-left anchored.
   Button containers overlay the frame's slot wells. */
.hud-bottom-strip {
    position: absolute;
    left: 39px;
    right: 0px;
    bottom: 0px;
    height: 131px;
    flex-direction: row;
    align-items: flex-end;
    background-color: transparent;
    border-top-width: 0px;
    padding-left: 0px;
    padding-right: 0px;
    padding-bottom: 0px;
    overflow: visible;
}

/* Frame overlay: 863x91 art scaled ×1.438 -> 1241x131 (fills the strip width exactly:
   strip is left:39..right:0 = 1241px on the 1280x720 PanelSettings design space).
   Natural aspect. pickingMode ignore so taps fall through to buttons on top. */
.hud-bottom-frame {
    position: absolute;
    left: 0px;
    bottom: 0px;
    width: 1241px;
    height: 131px;
    background-image: url('project://database/Assets/UI/HUD/Art/bottom_frame_pc.png');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-position: left bottom;
    -unity-background-position-x: 0px;
    -unity-background-position-y: 0px;
    background-color: transparent;
    picking-mode: Ignore;
    }

    /* ===================================================================
       HUD-004 (mobile-native-hud-layout) — Slice S1 anchor shells.
       Anchor-based, region-anchored containers. NO raw pixel-multiply of art
       (per project 4:3->16:9 rule). These are empty passthrough containers;
       picking-mode Ignore so touches fall through. S2/S3 populate them.
       Design space: 1280x720 (16:9).
       =================================================================== */

    /* PendingRelocation: hidden parking for the stripped PC 快捷栏 replica elements.
       display:none so they are invisible but root.Q(name) still resolves them
       for click-wiring + icon loading until S2/S3 repopulate. */
    .hud-pending-relocation {
        position: absolute;
        display: none;
        left: 0px;
        top: 0px;
        width: 0px;
        height: 0px;
        overflow: hidden;
    }

    /* CombatCluster: right-thumb combat zone (1 main + 5 sub assignable slots
       + run/horse/sit action buttons). Anchored bottom-right.
       S2 (HUD-004): populated with PC sprite frames (btn_skill_empty_pc.png).
       Fan layout: main slot center, 2 sub upper arc, 3 sub lower arc, actions below.
       Design space 1280×720; fan radius ~110px (27-41mm comfort arc at ~5.5").
       NOTE: exact px need parent vision screenshot to fine-tune (S2.6). */
    .hud-combat-cluster {
        position: absolute;
        right: 16px;
        bottom: 16px;
        width: 320px;
        height: 360px;
        background-color: transparent;
        picking-mode: Ignore;
        overflow: visible;
    }

    /* Main combat slot (player-chosen priority, visually larger for thumb rest).
       Frame: btn_skill_empty_pc.png (PC 42×42 SPR, scale-to-fit, upscaled 2.3× —
       pixel art upscales cleanly). Centered in the cluster's upper-middle area. */
    .hud-combat-main-slot {
        position: absolute;
        left: 147px;
        top: 117px;
        width: 96px;
        height: 96px;
        border-width: 0px;
        border-radius: 6px;
        background-color: rgba(20,40,30,0.35);
        background-image: url('project://database/Assets/UI/HUD/Art/btn_skill_empty_pc.png');
        -unity-background-scale-mode: scale-to-fit;
        justify-content: center;
        align-items: center;
    }

    /* Sub combat slot (64×64). Frame: btn_skill_empty_pc.png (PC SPR, scale-to-fit). */
    .hud-combat-sub-slot {
        position: absolute;
        width: 64px;
        height: 64px;
        border-width: 0px;
        border-radius: 4px;
        background-color: rgba(20,40,30,0.3);
        background-image: url('project://database/Assets/UI/HUD/Art/btn_skill_empty_pc.png');
        -unity-background-scale-mode: scale-to-fit;
        justify-content: center;
        align-items: center;
    }

    /* Fan positions (absolute within 340×340 container). Main center = (170, 138).
       Sub slots at radius ~110px from main center. Action buttons in a row below.
       Lower arc: sub1(left) sub2(center) sub3(right). Upper arc: sub4(left) sub5(right). */
    /* Circular fan (~120px radius) around main center (195,165). The 5 sub slots
       sweep from lower-left (225°) up to upper-right (45°) — the natural right-thumb
       arc. No slot sits directly below main (action buttons go there). Radius 120 keeps
       adjacent slots ~21px apart so the ornate PC skill-slot frames (btn_skill_empty_pc)
       do NOT visually overlap, while the innermost slot (sub2, 180°) stays reachable. */
    .hud-combat-pos-sub1 { left: 78px;  top: 218px; }   /* lower-left arc (225°) */
    .hud-combat-pos-sub2 { left: 43px;  top: 133px; }   /* left arc (180°, innermost) */
    .hud-combat-pos-sub3 { left: 78px;  top: 48px;  }   /* upper-left arc (135°) */
    .hud-combat-pos-sub4 { left: 163px; top: 13px;  }   /* upper arc (90°) */
    .hud-combat-pos-sub5 { left: 248px; top: 48px;  }   /* upper-right arc (45°) */

    /* Action buttons (48×48) in a row below the lower arc. Transparent hit area;
       icon drawn by child .hud-btn-icon. Icons: PcButtons/btn_run/horse/sit (PC 31px). */
    .hud-action-btn {
        position: absolute;
        width: 48px;
        height: 48px;
        border-width: 0px;
        border-radius: 4px;
        background-color: rgba(20,40,30,0.3);
        overflow: hidden;
    }
    .hud-combat-pos-run   { left: 120px; top: 300px; }
    .hud-combat-pos-horse { left: 178px; top: 300px; }
    .hud-combat-pos-sit   { left: 236px; top: 300px; }

    /* QuickSlots: usable-item quick slots (3) ascending the right side toward
       the minimap. Anchored right side, above the combat cluster. Empty in S1. */
    .hud-quick-slots {
        position: absolute;
        right: 28px;
        bottom: 410px;
        width: 200px;
        height: 64px;
        flex-direction: row;
        background-color: transparent;
        picking-mode: Ignore;
        overflow: visible;
    }

    /* TopGapCluster: relocated overflow PC UI (8 menu buttons + buff + Bảo Vật)
       into the minimap<->topbar gap. Anchored top, between status bar and minimap.
       Empty in S1. */
    .hud-top-gap-cluster {
        position: absolute;
        left: 690px;
        top: 4px;
        width: 470px;
        height: 60px;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        background-color: transparent;
        picking-mode: Ignore;
        overflow: visible;
    }

        /* S3 (HUD-004): compact horizontal row of PC menu buttons + BtnTreasure in the
           minimap<->topbar gap. Each button = transparent hit area; icon drawn by child. */
        .hud-top-gap-menu-row {
            flex-direction: row;
            flex-wrap: nowrap;
            align-items: center;
            justify-content: center;
            background-color: transparent;
        }

        /* Menu button relocated from PC bottom strip to the top gap (S3). 36×36 hit area
           with invisible padding to exceed the visual icon (≥44pt tap target, ADR-5).
           Icon loaded by LoadArt via ButtonIcons dict (root-level PC sprites). */
        .hud-top-gap-menu-btn {
            width: 36px;
            height: 36px;
            margin-left: 2px;
            margin-right: 2px;
            border-width: 0px;
            border-radius: 0px;
            background-color: transparent;
            overflow: hidden;
        }

        /* S3 (HUD-004): usable-item quick slot frame. Reuses PC numbered-well sprites
           (btn_quick_item_1/2/3_pc.png — 快捷栏 slot-well family, 36×36 RGBA). Each
           numbered sprite baked-in at PC extraction; no fabrication. */
        .hud-quick-slot {
            width: 60px;
            height: 60px;
            margin-left: 2px;
            margin-right: 2px;
            -unity-background-scale-mode: scale-to-fit;
            background-color: transparent;
            border-width: 0px;
            border-radius: 0px;
            overflow: hidden;
        }

        .hud-quick-slot-1 {
            background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_1_pc.png');
        }
        .hud-quick-slot-2 {
            background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_2_pc.png');
        }
        .hud-quick-slot-3 {
            background-image: url('project://database/Assets/UI/HUD/Art/btn_quick_item_3_pc.png');
        }

        /* Quick-slot item icon child (centered, shown when an item is assigned).
           Empty state shows PC empty styling (semi-transparent dark). */
        .hud-quick-slot-icon {
            position: absolute;
            left: 8px;
            top: 8px;
            width: 40px;
            height: 40px;
            background-size: contain;
            -unity-background-scale-mode: scale-to-fit;
        }
        .hud-quick-slot-icon.empty {
            background-color: rgba(40,80,60,0.3);
        }

        /* BuffPanel inside TopGapCluster: flow as a row below the menu buttons instead
           of using absolute positioning (its old top-level class used absolute). */
        .hud-top-gap-cluster > .hud-buff-panel {
            position: relative;
            left: 0;
            top: 0;
            width: auto;
            margin-top: 4px;
        }

    /* Right cluster: PC toggle row (circular) above menu row (square).
   Positioned over the frame's right-slot region (slots x886-1251 at ×1.6 scale). */
.hud-right-cluster {
    position: absolute;
    left: 792px;
    bottom: 34px;
    width: 330px;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    padding-bottom: 0px;
}

.hud-toggle-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 6px;
}

.hud-menu-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

/* Toggle button (PC 31px circular SPR: Sit/Run/Horse/Trade/Camera/PK). */
.hud-round-btn {
    width: 36px;
    height: 36px;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0px;
    border-radius: 0px;
    background-color: transparent;
    overflow: hidden;
}

.hud-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-main-hotbar {
    flex-direction: row;
    flex-shrink: 0;
    width: 442px;
    height: 48px;
    align-items: center;
    margin-left: 116px;
    margin-bottom: 28px;
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0px;
    background-color: transparent;
}

.hud-hotbar-slot {
    width: 47px;
    height: 47px;
    flex-shrink: 0;
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    margin-left: 1px;
    margin-right: 1px;
}

.hud-slot-number {
    position: absolute;
    left: 3px;
    top: 1px;
    width: 12px;
    height: 12px;
    color: rgb(150,150,150);
    font-size: 9px;
    -unity-text-align: upper-left;
}

.hud-skill-panel {
    flex-direction: row;
    flex-shrink: 0;
    width: 122px;
    height: 60px;
    align-items: center;
    justify-content: center;
    margin-left: 34px;
    margin-bottom: 26px;
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0px;
    border-color: transparent;
    background-color: transparent;
}

.hud-skill-slot {
    width: 48px;
    height: 48px;
    background-color: transparent;
    border-width: 0px;
    border-color: transparent;
    margin-left: 2px;
    margin-right: 2px;
}

.hud-skill-panel > .hud-skill-slot {
    width: 56px;
    height: 56px;
    border-width: 0px;
    background-image: none;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-radius: 0px;
    justify-content: center;
    align-items: center;
    overflow: visible;
}

.hud-skill-slot-icon {
    width: 52px;
    height: 52px;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
}

/* Main combat icon override must come AFTER the shared .hud-skill-slot-icon rule;
   otherwise the shared rule can make the 96×96 primary slot reuse sub-slot sizing. */
.hud-combat-main-icon {
    width: 88px;
    height: 88px;
}

.hud-skill-slot-icon.empty {
    background-color: rgba(40,80,60,0.5);
}

.hud-skill-slot-label {
    font-size: 11px;
    color: rgb(200,220,200);
    -unity-text-align: middle-center;
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    max-lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Skill picker overlay */
.hud-skill-picker-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.7);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.hud-skill-picker-window {
    width: 340px;
    max-height: 440px;
    background-color: rgba(15,35,28,0.97);
    border-width: 2px;
    border-color: rgb(80,160,120);
    border-radius: 8px;
}

.hud-skill-picker-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50,100,80);
}

.hud-skill-picker-title {
    font-size: 14px;
    color: rgb(220,235,210);
    -unity-font-style: bold;
}

.hud-skill-picker-close {
    width: 28px;
    height: 28px;
    background-color: rgba(180,60,60,0.7);
    border-radius: 14px;
}

.hud-skill-picker-list {
    height: 380px;
    max-height: 380px;
    overflow: hidden;
}

.hud-skill-picker-list .unity-scroll-view__content-container {
    min-height: 760px;
}

.skill-picker-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin: 3px 6px;
    border-width: 1px;
    border-color: rgb(50,100,80);
    border-radius: 4px;
    background-color: rgba(20,50,40,0.8);
}

.skill-picker-item:hover {
    background-color: rgba(40,80,60,0.9);
    border-color: rgb(100,180,130);
}

.skill-picker-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    background-size: contain;
}

.skill-picker-info {
    flex: 1;
}

.skill-picker-name {
    font-size: 13px;
    color: rgb(220,235,210);
    -unity-font-style: bold;
}

.skill-picker-level {
    font-size: 10px;
    color: rgb(160,200,170);
}

.skill-picker-type {
    font-size: 10px;
    color: rgb(140,170,150);
    margin-top: 2px;
}

.hud-skill-keys {
    position: absolute;
    left: 18px;
    bottom: -15px;
    width: 92px;
    height: 14px;
    flex-direction: row;
    justify-content: space-between;
    color: rgb(235,230,190);
    font-size: 11px;
    -unity-font-style: bold;
}

/* Menu button (PC 28px square SPR: CharF1/InvF2/ItemEx/SkillF3/QuestF4/TeamF6/FactionF7/ChatRoom).
   Icon drawn by child .hud-btn-icon; button itself is a transparent hit area. */
.hud-menu-btn {
    width: 36px;
    height: 36px;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0px;
    border-radius: 0px;
    background-color: transparent;
    overflow: hidden;
}

/* PC parity: bottom-right menu buttons are icon-only (no caption labels). */
.hud-menu-label {
    display: none;
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: -13px;
    height: 12px;
    font-size: 9px;
    color: rgb(225,230,205);
    -unity-text-align: middle-center;
}

.hud-baovat-btn {
    position: absolute;
    left: 1132px;
    bottom: 16px;
    width: 96px;
    height: 96px;
    border-radius: 0px;
    border-width: 0px;
    background-image: url('project://database/Assets/UI/HUD/Art/btn_treasure.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

/* ──────────────────────────────────────────────────────────────────────────
   NEW HUD PANELS STYLING
   ────────────────────────────────────────────────────────────────────────── */

/* Buff / Debuff Panel */
.hud-buff-panel {
    position: absolute;
    left: 120px;
    top: 52px;
    width: 240px;
    height: 72px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: transparent;
}

.hud-buff-cell {
    width: 32px;
    height: 38px;
    margin: 2px;
    align-items: center;
    justify-content: flex-start;
}

.hud-buff-icon {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-radius: 2px;
    background-color: rgb(10, 20, 15);
    -unity-background-scale-mode: scale-to-fit;
}

.hud-buff-border-green {
    border-color: rgb(55, 231, 63);
}

.hud-buff-border-orange {
    border-color: rgb(255, 140, 0);
}

.hud-buff-timer {
    font-size: 8px;
    color: rgb(55, 231, 63);
    -unity-text-align: middle-center;
    height: 11px;
    margin-top: 1px;
    -unity-font-style: bold;
}

.hud-debuff-timer {
    color: rgb(255, 140, 0);
}

/* Trade Info Panel */
.hud-trade-panel {
    position: absolute;
    left: 15px;
    top: 170px;
    width: 182px;
    height: 110px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 6px;
}

.hud-trade-close {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 14px;
    height: 14px;
    background-color: rgba(180, 50, 40, 0.85);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(220, 220, 220);
}

.hud-trade-title {
    font-size: 11px;
    color: rgb(255, 220, 90);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
}

.hud-trade-rows {
    flex-direction: column;
}

.hud-trade-label {
    font-size: 10px;
    color: rgb(230, 230, 210);
    margin-bottom: 2px;
}

/* Stall Currency Selector */
.hud-stall-currency {
    position: absolute;
    left: 460px;
    top: 150px;
    width: 180px;
    height: 80px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 8px;
    align-items: center;
}

.hud-stall-currency-title {
    font-size: 11px;
    color: rgb(230, 230, 210);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.hud-stall-btns-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.hud-stall-btn {
    font-size: 10px;
    background-color: rgb(35, 115, 95);
    border-color: rgb(55, 185, 150);
    color: white;
    width: 75px;
    height: 24px;
    border-radius: 4px;
}

/* Emote / Face Picker Overlay */
.hud-face-picker-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.hud-face-picker-window {
    width: 320px;
    max-height: 240px;
    background-color: rgba(15, 35, 28, 0.97);
    border-width: 2px;
    border-color: rgb(80, 160, 120);
    border-radius: 8px;
    position: absolute;
    left: 39px;
    bottom: 150px;
}

.hud-face-picker-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 100, 80);
}

.hud-face-picker-title {
    font-size: 12px;
    color: rgb(220, 235, 210);
    -unity-font-style: bold;
}

.hud-face-picker-close {
    width: 20px;
    height: 20px;
    background-color: rgba(180, 60, 60, 0.85);
    border-radius: 10px;
}

.hud-face-picker-list {
    max-height: 190px;
}

.hud-face-picker-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.hud-face-item {
    width: 28px;
    height: 28px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 50, 40, 0.8);
    border-width: 1px;
    border-color: rgb(50, 100, 80);
    border-radius: 4px;
}

.hud-face-item-text {
    font-size: 14px;
    -unity-text-align: middle-center;
}


/* =============================================================================
   HUD-003 Popup overlay host (PopupManager mounts backdrop + window here).
   Full-screen, on top of all HUD elements; transparent when empty.
   ========================================================================== */
.hud-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);   /* backdrop drawn by PopupManager child */
    picking-mode: Ignore;                  /* let taps pass through to game when empty */
}
