/* VLTK Mobile HUD — reference layout: top stat strip + bottom ornate bar */

.hud-root {
    width: 1280px;
    height: 720px;
    overflow: hidden;
}

/* TOP FRAME BG: dùng main_hud_bg.png cropped+scaled làm background frame PC ornate */
.hud-top-frame-bg {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 88px;
    background-image: url('project://database/Assets/UI/HUD/Art/top_frame_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

/* TOP STATUS STRIP — full-width container, bars dùng absolute coords trong 1280-space */
.hud-top-status {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 50px;
    background-color: transparent;
}

.hud-pc-bar-panel-bg {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 883px; /* PC 552 ×1.6, scaled from bar art */
    height: 27px; /* PC 17px × 1.6 */
    background-image: url('project://database/Assets/UI/HUD/Art/bar_panel_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    display: none; /* top_frame_bg.png đã bao gồm bars art — ẩn cái này */
}

.hud-level-box {
    position: absolute;
    left: 433px; /* PC Level.Left=53, container=348 → 348+85=433 absolute */
    top: 8px;
    width: 32px;
    height: 14px;
    font-size: 11px;
    color: rgb(55,231,63);
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0px;
}

.hud-top-bar {
    position: absolute;
    top: 3px; /* PC bars Top=2, scaled */
    width: 166px; /* PC 104px × 1.6 */
    height: 14px; /* PC 9px × 1.6 */
    background-color: transparent;
    border-width: 0px;
    overflow: hidden;
}

/* Bars dùng absolute coords trong 1280-space:
   Container (PC Main.Left=218): 218×1.6=348
   Stamina: 348+87×1.6=487, Life:639, Mana:791, Exp:943 */
.hud-stamina-track { left: 487px; }
.hud-hp-track { left: 639px; }
.hud-mp-track { left: 791px; }
.hud-exp-track { left: 943px; }

.hud-top-fill {
    width: 100%;
    height: 14px; /* PC 9px ×1.6 */
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-exp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_exp_fill.png');
}
.hud-hp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_hp_fill.png');
}
.hud-mp-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_mp_fill.png');
}
.hud-stamina-track .hud-top-fill {
    background-image: url('project://database/Assets/UI/HUD/Art/bar_stamina_fill.png');
}

.hud-vn-top-caption {
    position: absolute;
    top: -1px;
    height: 10px;
    font-size: 9px;
    color: rgb(230,230,210);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
/* Captions ẩn - IMGUI overlay sẽ vẽ. Positions absolute trong 1280-space. */
.hud-vn-level-caption { left: 433px; width: 40px; display: none; } /* 348+85 */
.hud-vn-stamina-caption { left: 487px; width: 166px; display: none; } /* 348+139 */
.hud-vn-hp-caption { left: 639px; width: 166px; display: none; } /* 348+291 */
.hud-vn-mp-caption { left: 791px; width: 166px; display: none; } /* 348+443 */
.hud-vn-exp-caption { left: 943px; width: 166px; display: none; } /* 348+595 */


.hud-top-small-text {
    position: absolute;
    top: 17px;
    width: 104px;
    height: 12px;
    font-size: 12px;
    color: rgb(255,255,255);
    -unity-text-align: middle-center;
    background-color: transparent;
}
/* Values dưới bar tracks — ẩn UIToolkit labels, IMGUI overlay sẽ vẽ. Absolute 1280-space. */
.hud-stamina-text { left: 487px; display: none; }
.hud-hp-text { left: 639px; display: none; }
.hud-mp-text { left: 791px; display: none; }
.hud-exp-text { left: 943px; display: none; }



/* MINIMAP: sandbox helper, top-right */
.hud-minimap-panel {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 136px;
    height: 166px;
    align-items: center;
}

.hud-minimap-frame {
    width: 130px;
    height: 130px;
    border-width: 2px;
    border-color: rgb(180,150,80);
    border-radius: 2px;
    background-color: rgba(5,10,5,0.92);
    overflow: hidden;
}

.hud-minimap-content {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 128px;
    height: 128px;
    background-color: rgba(15,25,15,0.90);
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-player-dot {
    position: absolute;
    left: 60px;
    top: 60px;
    width: 10px;
    height: 10px;
    background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-map-target-dot {
    position: absolute;
    left: -1000px;
    top: -1000px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255,230,40);
    border-width: 1px;
    border-color: rgb(80,20,0);
}

.hud-scene-name,
.hud-scene-pos {
    width: 130px;
    height: 11px;
    font-size: 9px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
}

.hud-minimap-btns {
    position: absolute;
    left: 80px;
    top: 136px;
    width: 50px;
    height: 14px;
    flex-direction: row;
    justify-content: flex-end;
}
.hud-minimap-btn {
    width: 14px;
    height: 14px;
    margin-left: 1px;
    margin-right: 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.hidden {
    display: none;
}

.hud-map-preview-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 720px;
    background-color: rgba(0,0,0,0.0);
    align-items: center;
    justify-content: center;
}

.hud-map-preview-window {
    width: 520px;
    height: 560px;
    background-color: rgba(5,12,10,0.96);
    border-width: 2px;
    border-color: rgb(180,150,80);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud-map-preview-header {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-map-preview-title {
    width: 460px;
    height: 24px;
    font-size: 16px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-map-preview-close {
    width: 22px;
    height: 22px;
    background-color: rgba(80,20,10,0.95);
    border-width: 1px;
    border-color: rgb(230,200,120);
}

.hud-map-preview-frame {
    position: relative;
    width: 500px;
    height: 500px;
    border-width: 2px;
    border-color: rgb(180,150,80);
    background-color: rgba(10,20,12,0.95);
    overflow: hidden;
}

.hud-map-preview-content {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 500px;
    height: 500px;
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-preview-player-dot {
    width: 14px;
    height: 14px;
}

.hud-map-preview-coords,
.hud-map-preview-help {
    height: 18px;
    color: rgb(230,230,210);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* CÁI BANG SKILL PANEL — PC refs: UiSkillsSheet.ini 205x376, UiSkillsFightSub.ini 5x5 grid 36px slots. */
.hud-cb-skill-panel {
    position: absolute;
    left: 338px;
    top: 110px;
    width: 205px;
    height: 376px;
    background-color: rgba(0,0,0,0);
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 0px;
    padding-bottom: 0px;
}

.hud-cb-header {
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-cb-title {
    color: rgba(0,0,0,0);
    font-size: 1px;
    flex-grow: 1;
}

.hud-cb-close {
    position: absolute;
    left: 53px;
    top: 342px;
    width: 97px;
    height: 29px;
    background-image: url('project://database/Assets/StreamingAssets/UI/HUD/Art/vi/btn_close_skill_02_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-cb-close-text {
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-summary {
    position: absolute;
    left: 156px;
    top: 317px;
    width: 34px;
    height: 14px;
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-list {
    position: absolute;
    left: 7px;
    top: 57px;
    width: 191px;
    height: 278px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

.hud-cb-grid-cell {
    width: 38px;
    height: 51px;
    align-items: flex-start;
    justify-content: flex-start;
}

.hud-cb-grid-cell-upgradable {
    background-color: rgba(0,0,0,0);
}

.hud-cb-grid-slot {
    width: 36px;
    height: 36px;
    background-color: rgba(0,0,0,0);
    -unity-background-scale-mode: scale-to-fit;
}

.hud-cb-grid-level {
    position: absolute;
    left: 0px;
    top: 36px;
    width: 36px;
    height: 12px;
    color: rgb(218,255,165);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-cb-add-point {
    position: absolute;
    left: 22px;
    top: 35px;
    width: 14px;
    height: 14px;
    background-image: url('project://database/Assets/UI/HUD/Art/状态加点按钮改_01.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-cb-grid-name {
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-page-tab {
    position: absolute;
    top: 314px;
    height: 20px;
    background-color: rgba(0,0,0,0);
}

.hud-cb-page-one {
    left: 0px;
    width: 36px;
}

.hud-cb-page-two {
    left: 37px;
    width: 31px;
}

.hud-cb-page-tab-label {
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-page-tab-active {
    background-color: rgba(255,220,90,0.10);
}

/* CHAT AREA */
.hud-chat-panel {
    position: absolute;
    left: 155px;
    bottom: 78px;
    width: 430px;
    height: 70px;
    flex-direction: column;
    justify-content: flex-end;
}

.hud-chat-warning {
    width: 430px;
    height: 18px;
    font-size: 15px;
    color: rgb(255,40,30);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.hud-chat-input-row {
    flex-direction: row;
    align-items: center;
    width: 430px;
    height: 28px;
    background-color: rgba(5,10,8,0.85);
    border-width: 1px;
    border-color: rgb(70,70,70);
}

.hud-chat-input {
    flex-grow: 1;
    height: 24px;
    color: rgb(230,245,230);
    font-size: 12px;
    background-color: rgba(0,0,0,0.45);
    border-width: 0px;
}

.hud-face-btn {
    width: 30px;
    height: 26px;
    background-color: transparent;
    border-width: 0px;
}

.hud-send-icon {
    width: 24px;
    height: 24px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

/* BOTTOM ORNATE STRIP */
.hud-bottom-strip {
    position: absolute;
    left: 155px;
    right: 0px;
    bottom: 0px;
    height: 82px;
    flex-direction: row;
    align-items: flex-end;
    background-color: rgba(0,0,0,0.78);
    border-top-width: 2px;
    border-top-color: rgb(35,115,95);
    padding-left: 0px;
    padding-right: 8px;
    padding-bottom: 6px;
}

.hud-left-tools {
    position: absolute;
    right: 8px;
    bottom: 84px;
    flex-direction: row;
    width: 190px;
    height: 48px;
    align-items: center;
    justify-content: flex-end;
}

.hud-round-btn {
    width: 42px;
    height: 42px;
    margin-right: 4px;
    border-width: 2px;
    border-color: rgb(45,130,105);
    border-radius: 21px;
    background-color: rgba(5,22,20,0.95);
    overflow: hidden;
}

.hud-hotkey-number {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 14px;
    height: 14px;
    color: rgb(210,210,190);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.hud-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-main-hotbar {
    flex-direction: row;
    width: 540px;
    height: 58px;
    align-items: center;
    margin-left: 0px;
    background-color: transparent;
    border-width: 0px;
}

.hud-hotbar-slot {
    width: 58px;
    height: 54px;
    background-color: rgba(5,5,5,0.85);
    border-width: 1px;
    border-color: rgb(70,70,70);
    margin-left: 2px;
    margin-right: 2px;
}

.hud-slot-number {
    position: absolute;
    left: 3px;
    top: 1px;
    width: 12px;
    height: 12px;
    color: rgb(150,150,150);
    font-size: 9px;
    -unity-text-align: upper-left;
}

.hud-skill-panel {
    flex-direction: row;
    width: 120px;
    height: 58px;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
    background-color: transparent;
    border-width: 0px;
}

.hud-skill-slot {
    width: 48px;
    height: 48px;
    background-color: rgba(0,0,0,0.60);
    border-width: 1px;
    border-color: rgb(60,140,115);
    margin-left: 2px;
    margin-right: 2px;
}

.hud-skill-panel > .hud-skill-slot {
    width: 56px;
    height: 56px;
    border-width: 1px;
    border-color: rgb(100,100,100);
    background-color: rgba(5,5,5,0.85);
    border-radius: 0px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hud-skill-slot-icon {
    width: 44px;
    height: 44px;
    background-size: contain;
}

.hud-skill-slot-icon.empty {
    background-color: rgba(40,80,60,0.5);
}

.hud-skill-slot-label {
    font-size: 11px;
    color: rgb(200,220,200);
    -unity-text-align: middle-center;
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    max-lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Skill picker overlay */
.hud-skill-picker-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0,0,0,0.7);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.hud-skill-picker-window {
    width: 340px;
    max-height: 440px;
    background-color: rgba(15,35,28,0.97);
    border-width: 2px;
    border-color: rgb(80,160,120);
    border-radius: 8px;
}

.hud-skill-picker-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50,100,80);
}

.hud-skill-picker-title {
    font-size: 14px;
    color: rgb(220,235,210);
    -unity-font-style: bold;
}

.hud-skill-picker-close {
    width: 28px;
    height: 28px;
    background-color: rgba(180,60,60,0.7);
    border-radius: 14px;
}

.hud-skill-picker-list {
    height: 380px;
    max-height: 380px;
    overflow: hidden;
}

.hud-skill-picker-list .unity-scroll-view__content-container {
    min-height: 760px;
}

.skill-picker-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin: 3px 6px;
    border-width: 1px;
    border-color: rgb(50,100,80);
    border-radius: 4px;
    background-color: rgba(20,50,40,0.8);
}

.skill-picker-item:hover {
    background-color: rgba(40,80,60,0.9);
    border-color: rgb(100,180,130);
}

.skill-picker-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    background-size: contain;
}

.skill-picker-info {
    flex: 1;
}

.skill-picker-name {
    font-size: 13px;
    color: rgb(220,235,210);
    -unity-font-style: bold;
}

.skill-picker-level {
    font-size: 10px;
    color: rgb(160,200,170);
}

.skill-picker-type {
    font-size: 10px;
    color: rgb(140,170,150);
    margin-top: 2px;
}

.hud-skill-keys {
    display: none;
}

.hud-right-menu {
    position: absolute;
    right: 84px;
    bottom: 0px;
    flex-direction: row;
    height: 48px;
    align-items: center;
}

.hud-menu-btn {
    width: 46px;
    height: 46px;
    margin-left: 4px;
    border-width: 0px;
    background-color: transparent;
    overflow: visible;
}

.hud-menu-label {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: -13px;
    height: 12px;
    font-size: 9px;
    color: rgb(225,230,205);
    -unity-text-align: middle-center;
}

.hud-baovat-btn {
    position: absolute;
    right: 8px;
    bottom: 8px;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border-width: 3px;
    border-color: rgb(230, 180, 50);
    background-color: rgb(110, 20, 10);
}

/* ──────────────────────────────────────────────────────────────────────────
   NEW HUD PANELS STYLING
   ────────────────────────────────────────────────────────────────────────── */

/* Buff / Debuff Panel */
.hud-buff-panel {
    position: absolute;
    left: 120px;
    top: 52px;
    width: 240px;
    height: 72px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: transparent;
}

.hud-buff-cell {
    width: 32px;
    height: 38px;
    margin: 2px;
    align-items: center;
    justify-content: flex-start;
}

.hud-buff-icon {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-radius: 2px;
    background-color: rgb(10, 20, 15);
    -unity-background-scale-mode: scale-to-fit;
}

.hud-buff-border-green {
    border-color: rgb(55, 231, 63);
}

.hud-buff-border-orange {
    border-color: rgb(255, 140, 0);
}

.hud-buff-timer {
    font-size: 8px;
    color: rgb(55, 231, 63);
    -unity-text-align: middle-center;
    height: 11px;
    margin-top: 1px;
    -unity-font-style: bold;
}

.hud-debuff-timer {
    color: rgb(255, 140, 0);
}

/* Team Preview Overlay */
.hud-team-preview {
    position: absolute;
    left: 10px;
    top: 88px;
    width: 170px;
    flex-direction: column;
}

.hud-team-member {
    position: relative;
    height: 50px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(5, 10, 8, 0.85);
    border-width: 1px;
    border-color: rgb(45, 130, 105);
    border-radius: 4px;
    margin-bottom: 4px;
    padding: 2px 4px;
}

.hud-team-leader-flag {
    position: absolute;
    left: 17px;
    top: -5px;
    width: 12px;
    height: 12px;
    background-image: url('project://database/Assets/UI/HUD/Art/队长移交_00.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-team-faction-icon {
    width: 26px;
    height: 26px;
    margin-right: 6px;
    background-color: rgba(0,0,0,0.5);
    -unity-background-scale-mode: scale-to-fit;
}

.hud-team-member-info {
    flex-grow: 1;
    flex-direction: column;
}

.hud-team-member-name {
    font-size: 10px;
    color: rgb(165, 255, 203);
    -unity-font-style: bold;
    margin-bottom: 2px;
    max-width: 120px;
    overflow: hidden;
}

.hud-team-bar-track {
    height: 5px;
    width: 73px;
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 1px;
    overflow: hidden;
}

.hud-team-bar-fill-hp {
    height: 100%;
    background-color: rgb(220, 50, 40);
}

.hud-team-bar-fill-mp {
    height: 100%;
    background-color: rgb(40, 120, 220);
}

/* Trade Info Panel */
.hud-trade-panel {
    position: absolute;
    left: 15px;
    top: 170px;
    width: 182px;
    height: 110px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 6px;
}

.hud-trade-close {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 14px;
    height: 14px;
    background-color: rgba(180, 50, 40, 0.85);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(220, 220, 220);
}

.hud-trade-title {
    font-size: 11px;
    color: rgb(255, 220, 90);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
}

.hud-trade-rows {
    flex-direction: column;
}

.hud-trade-label {
    font-size: 10px;
    color: rgb(230, 230, 210);
    margin-bottom: 2px;
}

/* Stall Currency Selector */
.hud-stall-currency {
    position: absolute;
    left: 460px;
    top: 150px;
    width: 180px;
    height: 80px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 8px;
    align-items: center;
}

.hud-stall-currency-title {
    font-size: 11px;
    color: rgb(230, 230, 210);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.hud-stall-btns-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.hud-stall-btn {
    font-size: 10px;
    background-color: rgb(35, 115, 95);
    border-color: rgb(55, 185, 150);
    color: white;
    width: 75px;
    height: 24px;
    border-radius: 4px;
}

/* Emote / Face Picker Overlay */
.hud-face-picker-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.hud-face-picker-window {
    width: 320px;
    max-height: 240px;
    background-color: rgba(15, 35, 28, 0.97);
    border-width: 2px;
    border-color: rgb(80, 160, 120);
    border-radius: 8px;
    position: absolute;
    left: 155px;
    bottom: 150px;
}

.hud-face-picker-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 100, 80);
}

.hud-face-picker-title {
    font-size: 12px;
    color: rgb(220, 235, 210);
    -unity-font-style: bold;
}

.hud-face-picker-close {
    width: 20px;
    height: 20px;
    background-color: rgba(180, 60, 60, 0.85);
    border-radius: 10px;
}

.hud-face-picker-list {
    max-height: 190px;
}

.hud-face-picker-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px;
}

.hud-face-item {
    width: 28px;
    height: 28px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 50, 40, 0.8);
    border-width: 1px;
    border-color: rgb(50, 100, 80);
    border-radius: 4px;
}

.hud-face-item-text {
    font-size: 14px;
    -unity-text-align: middle-center;
}

