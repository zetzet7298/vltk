/* VLTK Mobile HUD — PC-accurate layout from 顶部控制条.ini + 玩家信息主界面.ini + 工具控制条.ini */

.hud-root {
    width: 1280px;
    height: 720px;
    overflow: hidden;
}

/* ═══ HIDDEN DATA BINDING LABELS ═══ */
.hud-hidden-data { display: none; }

/* ═══ TOP STATUS BAR ═══ */
/* PC Main: Left=218, Top=0, Width=552, Height=17 → scaled ×1.6 */
.hud-top-bar-panel {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 32px;  /* adjust to fit top_frame_bg */
    background-color: transparent;
}

.hud-pc-bar-panel-bg {
    /* PC flat dark frame behind the 4 bars (no wooden chrome) */
    position: absolute;
    left: 283px;
    top: 2px;
    width: 708px;   /* stamina@289 → exp end @985, +pad */
    height: 34px;
    background-color: rgb(18,20,18);
    border-width: 1px;
    border-color: rgb(120,130,120);
}

/* Level text: PC Left=53, Top=1, W=20, H=12 → ×1.6 */
.hud-level-label {
    position: absolute;
    left: 235px;   /* left of stamina bar @289 (PC-pixel derived) */
    top: 4px;
    width: 46px;
    height: 19px;
    font-size: 11px;
    color: rgb(55,231,63);
    -unity-text-align: middle-center;
    background-color: rgb(18,40,22);
    border-width: 1px;
    border-color: rgb(90,120,90);
    overflow: hidden;
}

/* Rank/Hạng: PC Left=499, Top=2 → ×1.6 */
.hud-rank-label {
    position: absolute;
    left: 992px;   /* right of exp bar end @985 (PC-pixel derived) */
    top: 4px;
    width: 64px;
    height: 19px;
    font-size: 10px;
    color: rgb(55,231,63);
    -unity-text-align: middle-center;
    background-color: rgb(18,40,22);
    border-width: 1px;
    border-color: rgb(90,120,90);
    overflow: hidden;
}

/* Bar tracks: PC Top=2, W=104, H=14 → ×1.6 */
.hud-bar-track {
    position: absolute;
    top: 4px;
    width: 166px;   /* 104 × 1.6 */
    height: 16px;   /* PC fill H=9→×1.6≈14, +pad; leaves room for value text below */
    background-color: rgb(8,10,8);
    border-width: 1px;
    border-color: rgb(70,80,70);
    overflow: hidden;
}

/* Bar positions — relative to top-bar-panel, offsets from Main.Left=218→348:
   Stamina: 348 + 87×1.6 = 348 + 139 = 487
   HP/Life: 348 + 182×1.6 = 348 + 291 = 639
   MP/Mana: 348 + 277×1.6 = 348 + 443 = 791
   Exp:     348 + 372×1.6 = 348 + 595 = 943 */
.hud-stamina-track { left: 289px; }
.hud-hp-track      { left: 465px; }
.hud-mp-track      { left: 641px; }
.hud-exp-track     { left: 816px; }

.hud-bar-fill {
    width: 100%;
    height: 16px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-hp-track .hud-bar-fill      { background-image: url('project://database/Assets/UI/HUD/Art/bar_hp_fill.png'); }
.hud-mp-track .hud-bar-fill      { background-image: url('project://database/Assets/UI/HUD/Art/bar_mp_fill.png'); }
.hud-stamina-track .hud-bar-fill { background-image: url('project://database/Assets/UI/HUD/Art/bar_stamina_fill.png'); }
.hud-exp-track .hud-bar-fill     { background-image: url('project://database/Assets/UI/HUD/Art/bar_exp_fill.png'); }


/* ═══ MINIMAP ═══ */
.hud-minimap-panel {
    position: absolute;
    right: 6px;
    top: 4px;
    width: 136px;
    height: 166px;
    align-items: center;
}

.hud-minimap-frame {
    width: 130px;
    height: 130px;
    border-width: 1px;
    border-color: rgb(20,25,20);
    border-radius: 0px;
    background-color: rgba(5,10,5,0.92);
    overflow: hidden;
}

.hud-minimap-content {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 128px;
    height: 128px;
    background-color: rgba(15,25,15,0.90);
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-player-dot {
    position: absolute;
    left: 60px;
    top: 60px;
    width: 10px;
    height: 10px;
    background-image: url('project://database/Assets/UI/HUD/Art/minimap_dot.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-map-target-dot {
    position: absolute;
    left: -1000px;
    top: -1000px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255,230,40);
    border-width: 1px;
    border-color: rgb(80,20,0);
}

.hud-scene-name,
.hud-scene-pos {
    width: 130px;
    height: 11px;
    font-size: 9px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
}

.hud-minimap-btns {
    position: absolute;
    left: 80px;
    top: 136px;
    width: 50px;
    height: 14px;
    flex-direction: row;
    justify-content: flex-end;
}
.hud-minimap-btn {
    width: 14px;
    height: 14px;
    margin-left: 1px;
    margin-right: 1px;
    background-color: rgb(30,45,40);
    border-width: 1px;
    border-color: rgb(15,20,15);
    -unity-background-scale-mode: scale-to-fit;
}
#WorldMapBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_worldmap.png'); }
#ToggleMapBtn { background-image: url('project://database/Assets/UI/HUD/Art/btn_minimap_toggle.png'); }

.hidden { display: none; }


/* ═══ MAP PREVIEW ═══ */
.hud-map-preview-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 1280px;
    height: 720px;
    background-color: rgba(0,0,0,0.0);
    align-items: center;
    justify-content: center;
}

.hud-map-preview-window {
    width: 520px;
    height: 560px;
    background-color: rgba(5,12,10,0.96);
    border-width: 2px;
    border-color: rgb(180,150,80);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud-map-preview-header {
    height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hud-map-preview-title {
    width: 460px;
    height: 24px;
    font-size: 16px;
    color: rgb(0,255,0);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-map-preview-close {
    width: 22px;
    height: 22px;
    background-color: rgba(80,20,10,0.95);
    border-width: 1px;
    border-color: rgb(230,200,120);
}

.hud-map-preview-frame {
    position: relative;
    width: 500px;
    height: 500px;
    border-width: 2px;
    border-color: rgb(180,150,80);
    background-color: rgba(10,20,12,0.95);
    overflow: hidden;
}

.hud-map-preview-content {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 500px;
    height: 500px;
    background-image: url('project://database/Assets/UI/HUD/Textures/tex_minimap_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-preview-player-dot { width: 14px; height: 14px; }

.hud-map-preview-coords,
.hud-map-preview-help {
    height: 18px;
    color: rgb(230,230,210);
    font-size: 12px;
    -unity-text-align: middle-center;
}


/* ═══ CÁI BANG SKILL PANEL ═══ */
.hud-cb-skill-panel {
    position: absolute;
    left: 338px;
    top: 110px;
    width: 205px;
    height: 376px;
    background-color: rgba(0,0,0,0);
    padding-left: 7px;
    padding-right: 7px;
}

.hud-cb-close {
    position: absolute;
    left: 53px;
    top: 342px;
    width: 97px;
    height: 29px;
    background-image: url('project://database/Assets/StreamingAssets/UI/HUD/Art/vi/btn_close_skill_02_vi.png');
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-cb-summary {
    position: absolute;
    left: 156px;
    top: 317px;
    width: 34px;
    height: 14px;
    color: rgba(0,0,0,0);
    font-size: 1px;
}

.hud-cb-list {
    position: absolute;
    left: 7px;
    top: 57px;
    width: 191px;
    height: 278px;
    background-color: rgba(0,0,0,0);
    border-width: 0px;
}

.hud-cb-grid-cell { width: 38px; height: 51px; align-items: flex-start; justify-content: flex-start; }
.hud-cb-grid-cell-upgradable { background-color: rgba(0,0,0,0); }
.hud-cb-grid-slot { width: 36px; height: 36px; background-color: rgba(0,0,0,0); -unity-background-scale-mode: scale-to-fit; }
.hud-cb-grid-level { position: absolute; left: 0; top: 36px; width: 36px; height: 12px; color: rgb(218,255,165); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; }
.hud-cb-add-point { position: absolute; left: 22px; top: 35px; width: 14px; height: 14px; background-image: url('project://database/Assets/UI/HUD/Art/状态加点按钮改_01.png'); -unity-background-scale-mode: stretch-to-fill; }
.hud-cb-grid-name { color: rgba(0,0,0,0); font-size: 1px; }
.hud-cb-page-tab { position: absolute; top: 314px; height: 20px; background-color: rgba(0,0,0,0); }
.hud-cb-page-one { left: 0px; width: 36px; }
.hud-cb-page-two { left: 37px; width: 31px; }
.hud-cb-page-tab-label { color: rgba(0,0,0,0); font-size: 1px; }
.hud-cb-page-tab-active { background-color: rgba(255,220,90,0.10); }


/* ═══ CHAT AREA ═══ */
/* PC: chat in bottom-left, above hotbar. Keep left=155 to avoid joystick. */
.hud-chat-panel {
    position: absolute;
    left: 155px;
    bottom: 72px;   /* = chiều cao bottom strip mới */
    width: 480px;
    height: 60px;
    flex-direction: column;
    justify-content: flex-end;
}

.hud-chat-warning {
    width: 430px;
    height: 18px;
    font-size: 15px;
    color: rgb(255,40,30);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.hud-chat-input-row {
    flex-direction: row;
    align-items: center;
    width: 430px;
    height: 28px;
    background-color: rgba(5,10,8,0.85);
    border-width: 1px;
    border-color: rgb(70,70,70);
}

.hud-chat-input {
    flex-grow: 1;
    height: 24px;
    color: rgb(230,245,230);
    font-size: 12px;
    background-color: rgba(0,0,0,0.45);
    border-width: 0px;
}

.hud-face-btn {
    width: 30px;
    height: 26px;
    background-color: transparent;
    border-width: 0px;
}

.hud-send-icon {
    width: 24px;
    height: 24px;
    margin-right: 3px;
    -unity-background-scale-mode: scale-to-fit;
}


/* ═══ BOTTOM STRIP ═══ */
/* PC bottom: hotbar 1-9 | skill T/P | action buttons | menu icons | Bảo Vật */
.hud-bottom-strip {
    position: absolute;
    left: 0px;
    right: 0px;
    bottom: 0px;
    width: 1280px;
    height: 82px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    background-image: url('project://database/Assets/UI/HUD/Art/bottom_bar_bg.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding-left: 0px;
    padding-right: 0px;
}

/* ═══ HOTBAR: 9 slots like PC ═══ */
.hud-main-hotbar {
    flex-direction: row;
    height: 60px;
    align-items: center;
    background-color: transparent;
    border-width: 0px;
    flex-shrink: 0;
}

.hud-hotbar-slot {
    width: 36px;
    height: 36px;
    background-color: transparent;
    border-width: 0px;
    margin-left: 0px;
    margin-right: 0px;
}

.hud-slot-number {
    position: absolute;
    left: 3px;
    top: 1px;
    width: 12px;
    height: 12px;
    color: rgb(150,150,150);
    font-size: 9px;
    -unity-text-align: upper-left;
}


/* ═══ SKILL SLOTS (T/P) ═══ */
/* Absolute over the baked T/P art in the jade arch (bottom_bar_bg.png 1280×82):
   T slot art x[613..657], P slot art x[660..705], vertically centered (~y19..61).
   MUST be absolute + BringToFront (code) so it sits over ToolbarRight which is a
   later flex sibling — otherwise menu buttons (Kỹ năng) steal the center tap. */
.hud-skill-panel {
    position: absolute;
    left: 612px;
    top: 19px;
    width: 95px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: transparent;
    border-width: 0px;
    flex-shrink: 0;
}

.hud-skill-slot {
    width: 42px;
    height: 42px;
    background-color: transparent;
    border-width: 0px;
    margin-left: 1px;
    margin-right: 1px;
}

.hud-skill-panel > .hud-skill-slot {
    width: 42px;
    height: 42px;
    border-width: 0px;
    background-color: transparent;
    border-radius: 0px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hud-skill-slot-icon {
    width: 44px;
    height: 44px;
    background-size: contain;
}

.hud-skill-slot-icon.empty {
    background-color: rgba(40,80,60,0.5);
}

.hud-skill-slot-label {
    font-size: 11px;
    color: rgb(200,220,200);
    -unity-text-align: middle-center;
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    max-lines: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hud-skill-keys { display: none; }


/* ═══ RIGHT TOOLBAR: action + menu + Bảo Vật ═══ */
/* PC: all icon buttons in one row: action (run/sit/horse/exchange) → menu (Nhân/Túi/Võ/Đội/Bang/PK) → Bảo Vật */
.hud-right-toolbar {
    flex-direction: row;
    height: 72px;
    align-items: center;
    justify-content: flex-start;
    padding-right: 4px;
    padding-left: 0px;
    flex-shrink: 0;
}

.hud-round-btn {
    width: 28px;
    height: 28px;
    margin-right: 1px;
    border-width: 0px;
    background-color: transparent;
    overflow: hidden;
    flex-shrink: 0;
}

.hud-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-toolbar-sep {
    width: 1px;
    height: 24px;
    margin-left: 2px;
    margin-right: 2px;
    background-color: transparent;
}

.hud-menu-btn {
    width: 29px;
    height: 29px;
    margin-right: 1px;
    border-width: 0px;
    background-color: transparent;
    overflow: visible;
    flex-shrink: 0;
}

.hud-menu-btn-icon {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-menu-label { display: none; }

/* Bảo Vật: large round button at end of toolbar */
.hud-baovat-btn {
    width: 46px;
    height: 46px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 23px;
    border-width: 0px;
    background-color: transparent;
    flex-shrink: 0;
}


/* ═══ BUFF/DEBUFF PANEL ═══ */
.hud-buff-panel {
    position: absolute;
    left: 10px;
    top: 24px;   /* ngay dưới top bar 22px + 2px gap */
    width: 240px;
    height: 72px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: transparent;
}

.hud-buff-cell { width: 24px; height: 30px; margin: 1px; align-items: center; justify-content: flex-start; }
.hud-buff-icon { width: 20px; height: 20px; border-width: 1px; border-radius: 2px; background-color: rgb(10, 20, 15); -unity-background-scale-mode: scale-to-fit; }
.hud-buff-border-green { border-color: rgb(55, 231, 63); }
.hud-buff-border-orange { border-color: rgb(255, 140, 0); }
.hud-buff-timer { font-size: 7px; color: rgb(55, 231, 63); -unity-text-align: middle-center; height: 10px; margin-top: 1px; -unity-font-style: bold; }
.hud-debuff-timer { color: rgb(255, 140, 0); }


/* ═══ TEAM PREVIEW ═══ */
.hud-team-preview {
    position: absolute;
    left: 10px;
    top: 88px;
    width: 170px;
    flex-direction: column;
}

.hud-team-member {
    position: relative;
    height: 50px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(5, 10, 8, 0.85);
    border-width: 1px;
    border-color: rgb(45, 130, 105);
    border-radius: 4px;
    margin-bottom: 4px;
    padding: 2px 4px;
}

.hud-team-leader-flag {
    position: absolute;
    left: 17px;
    top: -5px;
    width: 12px;
    height: 12px;
    background-image: url('project://database/Assets/UI/HUD/Art/队长移交_00.png');
    -unity-background-scale-mode: scale-to-fit;
}

.hud-team-faction-icon { width: 26px; height: 26px; margin-right: 6px; background-color: rgba(0,0,0,0.5); -unity-background-scale-mode: scale-to-fit; }
.hud-team-member-info { flex-grow: 1; flex-direction: column; }
.hud-team-member-name { font-size: 10px; color: rgb(165, 255, 203); -unity-font-style: bold; margin-bottom: 2px; max-width: 120px; overflow: hidden; }
.hud-team-bar-track { height: 5px; width: 73px; background-color: rgba(0, 0, 0, 0.6); margin-bottom: 1px; overflow: hidden; }
.hud-team-bar-fill-hp { height: 100%; background-color: rgb(220, 50, 40); }
.hud-team-bar-fill-mp { height: 100%; background-color: rgb(40, 120, 220); }


/* ═══ TRADE INFO PANEL ═══ */
.hud-trade-panel {
    position: absolute;
    left: 15px;
    top: 170px;
    width: 182px;
    height: 110px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 6px;
}

.hud-trade-close {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 14px;
    height: 14px;
    background-color: rgba(180, 50, 40, 0.85);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgb(220, 220, 220);
}

.hud-trade-title { font-size: 11px; color: rgb(255, 220, 90); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgb(80, 80, 80); }
.hud-trade-rows { flex-direction: column; }
.hud-trade-label { font-size: 10px; color: rgb(230, 230, 210); margin-bottom: 2px; }


/* ═══ STALL CURRENCY ═══ */
.hud-stall-currency {
    position: absolute;
    left: 460px;
    top: 150px;
    width: 180px;
    height: 80px;
    background-color: rgba(5, 12, 10, 0.95);
    border-width: 2px;
    border-color: rgb(180, 150, 80);
    border-radius: 4px;
    padding: 8px;
    align-items: center;
}

.hud-stall-currency-title { font-size: 11px; color: rgb(230, 230, 210); margin-bottom: 8px; -unity-font-style: bold; }
.hud-stall-btns-row { flex-direction: row; justify-content: space-between; width: 100%; }
.hud-stall-btn { font-size: 10px; background-color: rgb(35, 115, 95); border-color: rgb(55, 185, 150); color: white; width: 75px; height: 24px; border-radius: 4px; }


/* ═══ FACE PICKER ═══ */
.hud-face-picker-overlay {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
}

.hud-face-picker-window {
    width: 320px;
    max-height: 240px;
    background-color: rgba(15, 35, 28, 0.97);
    border-width: 2px;
    border-color: rgb(80, 160, 120);
    border-radius: 8px;
    position: absolute;
    left: 155px;
    bottom: 150px;
}

.hud-face-picker-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 10px; border-bottom-width: 1px; border-bottom-color: rgb(50, 100, 80); }
.hud-face-picker-title { font-size: 12px; color: rgb(220, 235, 210); -unity-font-style: bold; }
.hud-face-picker-close { width: 20px; height: 20px; background-color: rgba(180, 60, 60, 0.85); border-radius: 10px; }
.hud-face-picker-list { max-height: 190px; }
.hud-face-picker-list .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; padding: 4px; }
.hud-face-item { width: 28px; height: 28px; margin: 2px; align-items: center; justify-content: center; background-color: rgba(20, 50, 40, 0.8); border-width: 1px; border-color: rgb(50, 100, 80); border-radius: 4px; }
.hud-face-item-text { font-size: 14px; -unity-text-align: middle-center; }


/* ═══ SKILL PICKER ═══ */
.hud-skill-picker-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0,0,0,0.7);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.hud-skill-picker-window {
    width: 340px;
    max-height: 440px;
    background-color: rgba(15,35,28,0.97);
    border-width: 2px;
    border-color: rgb(80,160,120);
    border-radius: 8px;
}

.hud-skill-picker-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom-width: 1px; border-bottom-color: rgb(50,100,80); }
.hud-skill-picker-title { font-size: 14px; color: rgb(220,235,210); -unity-font-style: bold; }
.hud-skill-picker-close { width: 28px; height: 28px; background-color: rgba(180,60,60,0.7); border-radius: 14px; }
.hud-skill-picker-list { height: 380px; max-height: 380px; overflow: hidden; }
.hud-skill-picker-list .unity-scroll-view__content-container { min-height: 760px; }

.skill-picker-item { flex-direction: row; align-items: center; padding: 8px 12px; margin: 3px 6px; border-width: 1px; border-color: rgb(50,100,80); border-radius: 4px; background-color: rgba(20,50,40,0.8); }
.skill-picker-item:hover { background-color: rgba(40,80,60,0.9); border-color: rgb(100,180,130); }
.skill-picker-icon { width: 40px; height: 40px; margin-right: 10px; background-size: contain; }
.skill-picker-info { flex: 1; }
.skill-picker-name { font-size: 13px; color: rgb(220,235,210); -unity-font-style: bold; }
.skill-picker-level { font-size: 10px; color: rgb(160,200,170); }
.skill-picker-type { font-size: 10px; color: rgb(140,170,150); margin-top: 2px; }

/* ═══ PC BAR ART = SINGLE VISUAL TRUTH ═══
   Bottom bar background = authentic PC frame (icons + slots + VN text baked in).
   Hide overlay icon visuals + slot numbers so PC art shows through with zero
   doubling. Containers stay (click zones intact). */
#BottomPanel .hud-slot-number { display: none; }
#BottomPanel .hud-btn-icon { display: none; }
#BottomPanel .hud-menu-btn-icon { display: none; }
#BottomPanel .hud-skill-slot-icon { display: none; }
#BottomPanel .hud-skill-slot-label { display: none; }
#BottomPanel .hud-skill-keys { display: none; }

/* Exp bar defaults to empty (0%) like PC reference; SetBar fills it when bridge live. */
#ExpBarFill { width: 0; }
